+    return [...this.notes.values()].filter(predicate).map((note) => ({ ...note, sharedWith: [...(note.sharedWith || [])] }));
   }
 
   update(id, patch) {
     const note = this.notes.get(id);
     if (!note) return null;
     Object.assign(note, patch);
-    return { ...note };
+    return { ...note, sharedWith: [...(note.sharedWith || [])] };
   }
 
   remove(id) {
     return this.notes.delete(id);
   }
+
+  share(id, userId) {
+    const note = this.notes.get(id);
+    if (!note) return null;
+    if (!note.sharedWith) note.sharedWith = [];
+    if (!note.sharedWith.includes(userId)) {
