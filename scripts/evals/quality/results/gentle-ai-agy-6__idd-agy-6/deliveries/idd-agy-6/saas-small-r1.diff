+++ b/test/app.js
@@ -7,6 +7,7 @@ const { createApp } = require("../src/app.js");
 
 const ana = { id: "u1", tenantId: "acme" };
 const bruno = { id: "u2", tenantId: "acme" };
+const carla = { id: "u3", tenantId: "acme" };
 const zoe = { id: "u9", tenantId: "globex" };
 
 test("owners create, list, read, update, and delete their notes", () => {
@@ -31,3 +32,72 @@ test("other users cannot read a note", () => {
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/notes" }).status, 401);
 });
+
+test("owners can share notes with teammates in the same organization", () => {
+  const app = createApp();
+  const created = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Compartida", body: "Texto secreto" } });
+  const id = created.body.id;
+
+  const shareRes = app.handle({
+    method: "POST",
+    path: `/notes/${id}/share`,
+    user: ana,
+    body: { userId: "u2" },
+  });
+  assert.equal(shareRes.status, 200);
+  assert.deepEqual(shareRes.body.sharedWith, ["u2"]);
+
+  // Bruno can see the note in GET /notes and read it via GET /notes/:id
+  const brunoNotes = app.handle({ method: "GET", path: "/notes", user: bruno });
+  assert.equal(brunoNotes.status, 200);
+  assert.deepEqual(brunoNotes.body.map((n) => n.id), [id]);
+
+  const brunoRead = app.handle({ method: "GET", path: `/notes/${id}`, user: bruno });
+  assert.equal(brunoRead.status, 200);
+  assert.equal(brunoRead.body.title, "Compartida");
+  assert.equal(brunoRead.body.body, "Texto secreto");
+
+  // Carla (not shared with) cannot see or read the note
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: carla }).body, []);
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: carla }).status, 403);
+});
+
+test("shared teammate cannot edit, delete, or re-share note", () => {
+  const app = createApp();
+  const created = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Colaboración" } });
+  const id = created.body.id;
+
+  app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } });
+
+  assert.equal(app.handle({ method: "PUT", path: `/notes/${id}`, user: bruno, body: { title: "Hack" } }).status, 403);
+  assert.equal(app.handle({ method: "DELETE", path: `/notes/${id}`, user: bruno }).status, 403);
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: bruno, body: { userId: "u3" } }).status, 403);
+});
+
+test("share input validation and tenant isolation", () => {
+  const app = createApp();
+  const created = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Segura" } });
+  const id = created.body.id;
+
+  // Missing userId
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: {} }).status, 400);
+
+  // User from another tenant
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u9" } }).status, 404);
+
+  // Non-existent user
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u999" } }).status, 404);
+
+  // Note from another tenant
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: zoe, body: { userId: "u9" } }).status, 404);
+
+  // Non-owner cannot share
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: bruno, body: { userId: "u3" } }).status, 403);
+
+  // Sharing twice is idempotent
+  const first = app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } });
+  assert.equal(first.status, 200);
+  const second = app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } });
+  assert.equal(second.status, 200);
+  assert.deepEqual(second.body.sharedWith, ["u2"]);
+});
