@@ -8,30 +8,40 @@ class NotesRepo {
 
   create({ tenantId, ownerId, title, body }) {
     this.sequence += 1;
-    const note = { id: `n${this.sequence}`, tenantId, ownerId, title, body };
+    const note = { id: `n${this.sequence}`, tenantId, ownerId, title, body, sharedWith: [] };
