-    return { ...note };
+    return { ...note, sharedWith: [...note.sharedWith] };
   }
 
   get(id) {
     const note = this.notes.get(id);
-    return note ? { ...note } : null;
+    return note ? { ...note, sharedWith: [...(note.sharedWith || [])] } : null;
   }
 
   list(predicate) {
