diff --git a/test/cli.js b/test/cli.js
index 0ddacaa..8f99c3c 100644
--- a/test/cli.js
+++ b/test/cli.js
@@ -43,3 +43,24 @@ test("unknown task and usage errors", () => {
   assert.equal(tasks("add").status, 2);
   assert.equal(tasks("borrar").status, 2);
 });
+
+test("add with --priority and list sorts by priority (alta, media, baja)", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "baja", "prioridad", "--priority", "baja").status, 0);
+  assert.equal(tasks("add", "alta", "prioridad", "--priority", "alta").status, 0);
+  assert.equal(tasks("add", "media", "prioridad", "--priority", "media").status, 0);
+  assert.equal(tasks("add", "otra", "alta", "--priority", "alta").status, 0);
+  assert.equal(tasks("add", "sin", "flag").status, 0);
+  assert.equal(
+    tasks("list").out,
+    "[ ] 2 alta prioridad\n[ ] 4 otra alta\n[ ] 3 media prioridad\n[ ] 5 sin flag\n[ ] 1 baja prioridad\n"
+  );
+});
+
+test("priority validation and syntax errors", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "tarea", "--priority", "urgente").status, 2);
+  assert.equal(tasks("add", "tarea", "--priority").status, 2);
+  assert.equal(tasks("add", "--priority", "alta").status, 2);
+  assert.equal(tasks("add", "--priority", "alta", "tarea").status, 2);
+});
