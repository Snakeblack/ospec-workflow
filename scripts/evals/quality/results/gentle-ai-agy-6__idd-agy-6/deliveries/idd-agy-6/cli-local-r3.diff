 const { storePath, load, save } = require("./store.js");
 
-const USAGE = "uso: tasks add <título> | tasks list | tasks done <id>";
+const USAGE = "uso: tasks add <título> [--priority <alta|media|baja>] | tasks list | tasks done <id>";
+
+const PRIORITY_ORDER = Object.freeze({
+  alta: 3,
+  media: 2,
+  baja: 1,
+});
 
 // Exit codes: 0 ok, 1 the task does not exist, 2 usage error.
 function run(argv, { stdout = process.stdout, stderr = process.stderr, env = process.env } = {}) {
@@ -10,13 +16,31 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
   const file = storePath(env);
 
   if (command === "add") {
-    const title = rest.join(" ").trim();
+    let priority = "media";
+    let words = rest;
+
+    const pIndex = rest.indexOf("--priority");
+    if (pIndex !== -1) {
+      if (pIndex !== rest.length - 2 || rest.lastIndexOf("--priority") !== pIndex) {
+        stderr.write(`${USAGE}\n`);
+        return 2;
+      }
+      const val = rest[pIndex + 1];
+      if (!Object.prototype.hasOwnProperty.call(PRIORITY_ORDER, val)) {
+        stderr.write(`${USAGE}\n`);
+        return 2;
+      }
+      priority = val;
+      words = rest.slice(0, pIndex);
+    }
+
+    const title = words.join(" ").trim();
     if (!title) {
       stderr.write(`${USAGE}\n`);
       return 2;
     }
     const data = load(file);
-    const task = { id: data.nextId, title, done: false };
+    const task = { id: data.nextId, title, done: false, priority };
     data.nextId += 1;
     data.tasks.push(task);
     save(file, data);
@@ -26,7 +50,12 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
 
   if (command === "list") {
     const data = load(file);
-    for (const task of data.tasks) {
+    const sorted = data.tasks.slice().sort((a, b) => {
+      const weightA = PRIORITY_ORDER[a.priority] || PRIORITY_ORDER.media;
+      const weightB = PRIORITY_ORDER[b.priority] || PRIORITY_ORDER.media;
+      return weightB - weightA;
+    });
+    for (const task of sorted) {
       stdout.write(`${task.done ? "[x]" : "[ ]"} ${task.id} ${task.title}\n`);
     }
     return 0;
diff --git a/test/cli.js b/test/cli.js
index 0ddacaa..0314305 100644
--- a/test/cli.js
+++ b/test/cli.js
@@ -43,3 +43,64 @@ test("unknown task and usage errors", () => {
   assert.equal(tasks("add").status, 2);
   assert.equal(tasks("borrar").status, 2);
 });
+
+test("add with --priority orders list by highest priority first", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "comprar", "pan", "--priority", "baja").status, 0);
+  assert.equal(tasks("add", "pagar", "facturas", "--priority", "alta").status, 0);
+  assert.equal(tasks("add", "limpiar", "casa", "--priority", "media").status, 0);
+  assert.equal(tasks("add", "llamar", "medico", "--priority", "alta").status, 0);
+
+  // Alta: 2 (pagar facturas), 4 (llamar medico) in insertion order
+  // Media: 3 (limpiar casa)
+  // Baja: 1 (comprar pan)
+  assert.equal(
+    tasks("list").out,
+    "[ ] 2 pagar facturas\n[ ] 4 llamar medico\n[ ] 3 limpiar casa\n[ ] 1 comprar pan\n"
+  );
+});
+
+test("omitting --priority defaults to media and preserves insertion order", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "tarea por defecto").status, 0);
+  assert.equal(tasks("add", "tarea media explicita", "--priority", "media").status, 0);
+  assert.equal(tasks("add", "tarea urgente", "--priority", "alta").status, 0);
+  assert.equal(tasks("add", "tarea secundaria", "--priority", "baja").status, 0);
+
+  assert.equal(
+    tasks("list").out,
+    "[ ] 3 tarea urgente\n[ ] 1 tarea por defecto\n[ ] 2 tarea media explicita\n[ ] 4 tarea secundaria\n"
+  );
+});
+
+test("invalid --priority usage returns exit code 2", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "tarea", "--priority", "urgente").status, 2);
+  assert.equal(tasks("add", "tarea", "--priority").status, 2);
+  assert.equal(tasks("add", "--priority", "alta", "tarea").status, 2);
+  assert.equal(tasks("add", "--priority", "alta").status, 2);
+  assert.equal(tasks("add", "tarea", "--priority", "alta", "--priority", "baja").status, 2);
+});
+
+test("tasks list handles tasks stored without priority field", () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "tasks-"));
+  const filePath = path.join(dir, "tasks.json");
+  fs.writeFileSync(
+    filePath,
+    JSON.stringify({
+      nextId: 3,
+      tasks: [
+        { id: 1, title: "tarea antigua", done: false },
+        { id: 2, title: "tarea urgente", done: false, priority: "alta" },
+      ],
+    }) + "\n"
+  );
+  let out = "";
+  const status = run(["list"], {
+    env: { TASKS_FILE: filePath },
+    stdout: { write: (text) => { out += text; } },
+    stderr: { write: () => {} },
+  });
+  assert.equal(status, 0);
+  assert.equal(out, "[ ] 2 tarea urgente\n[ ] 1 tarea antigua\n");
+});
