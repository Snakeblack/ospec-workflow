diff --git a/src/clinic.js b/src/clinic.js
index e4eb220..1cfe572 100644
--- a/src/clinic.js
+++ b/src/clinic.js
@@ -9,6 +9,14 @@ class AccessDeniedError extends Error {
   }
 }
 
+function escapeCsvCell(value) {
+  const str = String(value ?? "");
+  if (str.includes(",") || str.includes('"') || str.includes("\n")) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
 // Patient: { id, nationalId, name, birthDate, diagnosis }
 // Appointment: { id, patientId, date: "YYYY-MM-DD", time: "HH:MM", reason }
 function createClinic({ patients = [], appointments = [], audit = createAuditLog() } = {}) {
@@ -32,7 +40,23 @@ function createClinic({ patients = [], appointments = [], audit = createAuditLog
     return result;
   }
 
-  return { getPatient, appointmentsOn, audit };
+  function exportAppointmentsCsv(date, actor) {
+    requireRole(actor, ["doctor", "reception"]);
+    const dayAppointments = appointments
+      .filter((item) => item.date === date)
+      .slice()
+      .sort((a, b) => a.time.localeCompare(b.time));
+    audit.record({ action: "export-appointments-csv", actorId: actor.id, date, count: dayAppointments.length });
+    const header = "hora,paciente,motivo";
+    const rows = dayAppointments.map((apt) => {
+      const patient = patients.find((item) => item.id === apt.patientId);
+      const patientName = patient ? patient.name : "";
+      return [escapeCsvCell(apt.time), escapeCsvCell(patientName), escapeCsvCell(apt.reason)].join(",");
+    });
+    return [header, ...rows].join("\n");
+  }
+
+  return { getPatient, appointmentsOn, exportAppointmentsCsv, audit };
 }
 
 module.exports = { createClinic, AccessDeniedError };
diff --git a/test/clinic.js b/test/clinic.js
