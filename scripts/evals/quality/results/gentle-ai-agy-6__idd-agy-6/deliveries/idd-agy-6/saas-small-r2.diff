diff --git a/test/app.js b/test/app.js
index 9815af7..11e7c83 100644
--- a/test/app.js
+++ b/test/app.js
@@ -31,3 +31,58 @@ test("other users cannot read a note", () => {
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/notes" }).status, 401);
 });
+
+test("sharing a note with a coworker enables listing and reading", () => {
+  const app = createApp();
+  const created = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Shared Doc", body: "Hello" } });
+  const noteId = created.body.id;
+
+  // Share note with Bruno (coworker in same tenant)
+  const shareRes = app.handle({
+    method: "POST",
+    path: `/notes/${noteId}/share`,
+    user: ana,
+    body: { userId: "u2" },
+  });
+  assert.equal(shareRes.status, 200);
+  assert.equal(shareRes.body.id, noteId);
+  assert.deepEqual(shareRes.body.sharedWith, ["u2"]);
+
+  // Bruno sees the shared note in GET /notes
+  const brunoNotes = app.handle({ method: "GET", path: "/notes", user: bruno });
+  assert.equal(brunoNotes.status, 200);
+  assert.deepEqual(brunoNotes.body.map((note) => note.id), [noteId]);
+
+  // Bruno can open the shared note with GET /notes/:id
+  const getNoteRes = app.handle({ method: "GET", path: `/notes/${noteId}`, user: bruno });
+  assert.equal(getNoteRes.status, 200);
+  assert.equal(getNoteRes.body.title, "Shared Doc");
+
+  // Bruno cannot edit or delete the note
+  assert.equal(app.handle({ method: "PUT", path: `/notes/${noteId}`, user: bruno, body: { title: "Hacked" } }).status, 403);
+  assert.equal(app.handle({ method: "DELETE", path: `/notes/${noteId}`, user: bruno }).status, 403);
+
+  // Bruno cannot share someone else's note
+  assert.equal(app.handle({ method: "POST", path: `/notes/${noteId}/share`, user: bruno, body: { userId: "u3" } }).status, 403);
+});
+
+test("sharing validation and isolation", () => {
+  const app = createApp();
+  const created = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Doc" } });
+  const noteId = created.body.id;
+
+  // Missing userId
+  assert.equal(app.handle({ method: "POST", path: `/notes/${noteId}/share`, user: ana, body: {} }).status, 400);
+
+  // Sharing with user from another tenant is 404 (isolation)
+  assert.equal(app.handle({ method: "POST", path: `/notes/${noteId}/share`, user: ana, body: { userId: "u9" } }).status, 404);
+
+  // Sharing with unknown user is 404
+  assert.equal(app.handle({ method: "POST", path: `/notes/${noteId}/share`, user: ana, body: { userId: "u999" } }).status, 404);
+
+  // Sharing non-existent note is 404
+  assert.equal(app.handle({ method: "POST", path: "/notes/n999/share", user: ana, body: { userId: "u2" } }).status, 404);
+
+  // Other tenant cannot share or access
+  assert.equal(app.handle({ method: "POST", path: `/notes/${noteId}/share`, user: zoe, body: { userId: "u2" } }).status, 404);
+});
