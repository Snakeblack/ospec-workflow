   if (command === "add") {
-    const title = rest.join(" ").trim();
+    let priority = "media";
+    let words = rest;
+
+    if (rest.length >= 1 && rest[rest.length - 1] === "--priority") {
+      stderr.write(`${USAGE}\n`);
+      return 2;
+    }
+
+    if (rest.length >= 2 && rest[rest.length - 2] === "--priority") {
+      const val = rest[rest.length - 1];
+      if (!VALID_PRIORITIES.has(val)) {
+        stderr.write(`${USAGE}\n`);
+        return 2;
+      }
+      priority = val;
+      words = rest.slice(0, -2);
+    } else if (rest.includes("--priority")) {
+      stderr.write(`${USAGE}\n`);
+      return 2;
+    }
+
+    const title = words.join(" ").trim();
     if (!title) {
       stderr.write(`${USAGE}\n`);
       return 2;
     }
     const data = load(file);
