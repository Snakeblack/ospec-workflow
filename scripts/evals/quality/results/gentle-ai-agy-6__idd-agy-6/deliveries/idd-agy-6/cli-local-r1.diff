+    const task = { id: data.nextId, title, priority, done: false };
     data.nextId += 1;
     data.tasks.push(task);
     save(file, data);
@@ -26,7 +54,12 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
 
   if (command === "list") {
     const data = load(file);
-    for (const task of data.tasks) {
+    const sorted = [...data.tasks].sort((a, b) => {
+      const weightA = PRIORITY_WEIGHT[a.priority] || PRIORITY_WEIGHT.media;
+      const weightB = PRIORITY_WEIGHT[b.priority] || PRIORITY_WEIGHT.media;
+      return weightB - weightA;
+    });
+    for (const task of sorted) {
       stdout.write(`${task.done ? "[x]" : "[ ]"} ${task.id} ${task.title}\n`);
     }
     return 0;
