diff --git a/test/app.js b/test/app.js
index 9815af7..07aba4b 100644
--- a/test/app.js
+++ b/test/app.js
@@ -31,3 +31,77 @@ test("other users cannot read a note", () => {
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/notes" }).status, 401);
 });
+
+test("users can share a note with a coworker in the same tenant", () => {
+  const app = createApp();
+  const created = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Compartida", body: "Contenido" } });
+  assert.equal(created.status, 201);
+  const id = created.body.id;
+
+  // Before sharing: Bruno cannot read or see the note
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: bruno }).status, 403);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: bruno }).body, []);
+
+  // Ana shares the note with coworker Bruno
+  const shareRes = app.handle({
+    method: "POST",
+    path: `/notes/${id}/share`,
+    user: ana,
+    body: { userId: "u2" },
+  });
+  assert.equal(shareRes.status, 200);
+
+  // Bruno now sees the note in GET /notes
+  const brunoNotes = app.handle({ method: "GET", path: "/notes", user: bruno });
+  assert.equal(brunoNotes.status, 200);
+  assert.deepEqual(brunoNotes.body.map((note) => note.id), [id]);
+
+  // Bruno can open the note with GET /notes/:id
+  const brunoRead = app.handle({ method: "GET", path: `/notes/${id}`, user: bruno });
+  assert.equal(brunoRead.status, 200);
+  assert.equal(brunoRead.body.id, id);
+  assert.equal(brunoRead.body.title, "Compartida");
+  assert.equal(brunoRead.body.body, "Contenido");
+
+  // Sharing is idempotent
+  const reShareRes = app.handle({
+    method: "POST",
+    path: `/notes/${id}/share`,
+    user: ana,
+    body: { userId: "u2" },
+  });
+  assert.equal(reShareRes.status, 200);
+
+  // Coworker cannot modify, delete or share the note
+  assert.equal(app.handle({ method: "PUT", path: `/notes/${id}`, user: bruno, body: { title: "Cambio" } }).status, 403);
+  assert.equal(app.handle({ method: "DELETE", path: `/notes/${id}`, user: bruno }).status, 403);
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: bruno, body: { userId: "u3" } }).status, 403);
+
+  // User from another tenant cannot see or open it
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: zoe }).status, 404);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: zoe }).body, []);
+});
+
+test("sharing validates inputs, permissions and tenant isolation", () => {
+  const app = createApp();
+  const created = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Doc" } });
+  const id = created.body.id;
+
+  // Missing userId
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: {} }).status, 400);
+
+  // Unauthenticated
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: null, body: { userId: "u2" } }).status, 401);
+
+  // Non-existent note
+  assert.equal(app.handle({ method: "POST", path: "/notes/n999/share", user: ana, body: { userId: "u2" } }).status, 404);
+
+  // Sharing with user from another tenant is rejected
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u9" } }).status, 404);
+
+  // Sharing with non-existent user is rejected
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "unknown" } }).status, 404);
+
+  // Sharing a note from another tenant is reported as not-found (404)
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: zoe, body: { userId: "u2" } }).status, 404);
+});
