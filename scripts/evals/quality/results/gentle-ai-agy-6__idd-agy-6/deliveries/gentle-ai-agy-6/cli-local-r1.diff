 const USAGE = "uso: tasks add <título> | tasks list | tasks done <id>";
 
+const VALID_PRIORITIES = new Set(["alta", "media", "baja"]);
+const PRIORITY_ORDER = {
+  alta: 3,
+  media: 2,
+  baja: 1,
