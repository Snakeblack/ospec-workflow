diff --git a/test/cli.js b/test/cli.js
index 0ddacaa..0d892c9 100644
--- a/test/cli.js
+++ b/test/cli.js
@@ -43,3 +43,65 @@ test("unknown task and usage errors", () => {
   assert.equal(tasks("add").status, 2);
   assert.equal(tasks("borrar").status, 2);
 });
+
+test("priority ordering in list: alta > media > baja, preserving insertion order", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "Tarea normal").status, 0);
+  assert.equal(tasks("add", "Comprar pan", "--priority", "alta").status, 0);
+  assert.equal(tasks("add", "Limpiar trastero", "--priority", "baja").status, 0);
+  assert.equal(tasks("add", "Pagar factura", "--priority", "alta").status, 0);
+  assert.equal(tasks("add", "Llamar medico", "--priority", "media").status, 0);
+
+  const expected =
+    "[ ] 2 Comprar pan\n" +
+    "[ ] 4 Pagar factura\n" +
+    "[ ] 1 Tarea normal\n" +
+    "[ ] 5 Llamar medico\n" +
+    "[ ] 3 Limpiar trastero\n";
+
+  assert.equal(tasks("list").out, expected);
+});
+
+test("priority error handling", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "Tarea", "--priority", "urgente").status, 2);
+  assert.equal(tasks("add", "Tarea", "--priority").status, 2);
+  assert.equal(tasks("add", "--priority", "alta").status, 2);
+});
+
+test("legacy tasks without priority field default to media", () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "tasks-"));
+  const tasksFile = path.join(dir, "tasks.json");
+  fs.writeFileSync(
+    tasksFile,
+    JSON.stringify({
+      nextId: 3,
+      tasks: [
+        { id: 1, title: "tarea antigua 1", done: false },
+        { id: 2, title: "tarea antigua 2", done: true },
+      ],
+    })
+  );
+
+  let out = "";
+  let err = "";
+  run(["add", "tarea alta", "--priority", "alta"], {
+    env: { TASKS_FILE: tasksFile },
+    stdout: { write: (text) => { out += text; } },
+    stderr: { write: (text) => { err += text; } },
+  });
+
+  out = "";
+  run(["list"], {
+    env: { TASKS_FILE: tasksFile },
+    stdout: { write: (text) => { out += text; } },
+    stderr: { write: (text) => { err += text; } },
+  });
+
+  const expected =
+    "[ ] 3 tarea alta\n" +
+    "[ ] 1 tarea antigua 1\n" +
+    "[x] 2 tarea antigua 2\n";
+
+  assert.equal(out, expected);
+});
