diff --git a/src/paginate.js b/src/paginate.js
index ed94097..f066f76 100644
--- a/src/paginate.js
+++ b/src/paginate.js
@@ -7,10 +7,17 @@
  * @param {number} [pageSize=10]
  * @returns {{ page: number, pageSize: number, totalPages: number, items: Array }}
  */
-function paginate(items, page, pageSize = 10) {
-  const totalPages = Math.floor(items.length / pageSize) + 1;
-  const start = (page - 1) * pageSize;
-  return { page, pageSize, totalPages, items: items.slice(start, start + pageSize) };
+function paginate(items, page = 1, pageSize = 10) {
+  const validPageSize = pageSize > 0 ? Math.trunc(pageSize) : 10;
+  const currentPage = Math.max(1, Math.trunc(page) || 1);
+  const totalPages = Math.ceil(items.length / validPageSize);
+  const start = (currentPage - 1) * validPageSize;
+  return {
+    page: currentPage,
+    pageSize: validPageSize,
+    totalPages,
+    items: items.slice(start, start + validPageSize),
+  };
 }
 
 module.exports = { paginate };
