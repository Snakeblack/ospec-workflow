+
+test("export appointments to csv for a day sorted by time", () => {
+  const multipleAppointments = [
+    { id: "a1", patientId: "p1", date: "2026-10-06", time: "11:00", reason: "Revision" },
+    { id: "a2", patientId: "p2", date: "2026-10-06", time: "09:30", reason: "Control" },
+    { id: "a3", patientId: "p1", date: "2026-10-07", time: "08:00", reason: "Analítica" },
+  ];
+  const multiplePatients = [
+    { id: "p1", nationalId: "12345678Z", name: "Luis Gómez", birthDate: "1980-02-01", diagnosis: "Hipertensión" },
+    { id: "p2", nationalId: "87654321A", name: "Ana Pérez", birthDate: "1992-05-15", diagnosis: "Gripe" },
+  ];
+  const clinic = createClinic({ patients: multiplePatients, appointments: multipleAppointments });
+  const csv = clinic.exportAppointmentsCsv("2026-10-06", reception);
+  const expected = [
+    "hora,paciente,motivo",
+    "09:30,Ana Pérez,Control",
+    "11:00,Luis Gómez,Revision",
+  ].join("\n");
+  assert.equal(csv, expected);
+  assert.equal(clinic.audit.entries().length, 1);
+});
+
+test("export appointments to csv on a day without appointments", () => {
+  const clinic = createClinic({ patients, appointments });
+  const csv = clinic.exportAppointmentsCsv("2026-10-08", reception);
+  assert.equal(csv, "hora,paciente,motivo");
+});
+
+test("unauthorized role cannot export appointments csv", () => {
+  const clinic = createClinic({ patients, appointments });
+  const unauthorizedActor = { id: "u1", role: "assistant" };
+  assert.throws(() => clinic.exportAppointmentsCsv("2026-10-06", unauthorizedActor), AccessDeniedError);
+  assert.throws(() => clinic.exportAppointmentsCsv("2026-10-06", null), AccessDeniedError);
+});
+
+test("doctors can also export appointments csv", () => {
+  const clinic = createClinic({ patients, appointments });
+  const csv = clinic.exportAppointmentsCsv("2026-10-06", doctor);
+  assert.equal(csv, "hora,paciente,motivo\n09:30,Luis Gómez,Control");
+});
+
+test("export appointments escapes csv fields with commas or quotes", () => {
+  const specialPatients = [
+    { id: "p1", name: 'Gómez, "Luis"' },
+  ];
+  const specialAppointments = [
+    { id: "a1", patientId: "p1", date: "2026-10-06", time: "09:30", reason: "Control, revisión" },
+  ];
+  const clinic = createClinic({ patients: specialPatients, appointments: specialAppointments });
+  const csv = clinic.exportAppointmentsCsv("2026-10-06", reception);
+  assert.equal(csv, 'hora,paciente,motivo\n09:30,"Gómez, ""Luis""","Control, revisión"');
+});
