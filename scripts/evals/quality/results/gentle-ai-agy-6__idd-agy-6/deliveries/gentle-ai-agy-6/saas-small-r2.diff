@@ -31,3 +32,75 @@ test("other users cannot read a note", () => {
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/notes" }).status, 401);
 });
+
+test("a user can share a note with a teammate who can then list and read it", () => {
+  const app = createApp();
+  const created = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Shared Doc", body: "Content" } });
+  assert.equal(created.status, 201);
+  const id = created.body.id;
+
+  // Bruno and Carla cannot see or read the note yet
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: bruno }).body, []);
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: bruno }).status, 403);
+
+  // Ana shares the note with Bruno
+  const shareRes = app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } });
+  assert.equal(shareRes.status, 200);
+
+  // Bruno now sees the note in GET /notes and can read it with GET /notes/:id
+  const brunoNotes = app.handle({ method: "GET", path: "/notes", user: bruno });
+  assert.equal(brunoNotes.status, 200);
+  assert.deepEqual(brunoNotes.body.map((note) => note.id), [id]);
+
+  const readRes = app.handle({ method: "GET", path: `/notes/${id}`, user: bruno });
+  assert.equal(readRes.status, 200);
+  assert.equal(readRes.body.id, id);
+  assert.equal(readRes.body.title, "Shared Doc");
+  assert.equal(readRes.body.body, "Content");
+
+  // Carla (same tenant, not shared) still cannot list or read it
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: carla }).body, []);
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: carla }).status, 403);
+
+  // Zoe (different tenant) still gets 404
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: zoe }).body, []);
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: zoe }).status, 404);
+});
+
+test("shared users cannot edit, delete, or share the note", () => {
+  const app = createApp();
+  const created = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Ana Doc" } });
+  const id = created.body.id;
+
+  app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } });
+
+  // Bruno cannot edit
+  assert.equal(app.handle({ method: "PUT", path: `/notes/${id}`, user: bruno, body: { title: "Modified" } }).status, 403);
+
+  // Bruno cannot delete
+  assert.equal(app.handle({ method: "DELETE", path: `/notes/${id}`, user: bruno }).status, 403);
+
+  // Bruno cannot share
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: bruno, body: { userId: "u3" } }).status, 403);
+});
+
+test("sharing validation rules and tenant isolation", () => {
+  const app = createApp();
+  const created = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Ana Note" } });
+  const id = created.body.id;
+
+  // Missing userId
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: {} }).status, 400);
+
+  // Nonexistent note
+  assert.equal(app.handle({ method: "POST", path: "/notes/nonexistent/share", user: ana, body: { userId: "u2" } }).status, 404);
+
+  // Sharing with user from another tenant (Zoe is globex) is rejected as not found
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u9" } }).status, 404);
+
+  // Sharing with nonexistent user is rejected as not found
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "unknown" } }).status, 404);
+
+  // Sharing unauthenticated
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, body: { userId: "u2" } }).status, 401);
+});
