diff --git a/test/cli.js b/test/cli.js
index 0ddacaa..6c37bca 100644
--- a/test/cli.js
+++ b/test/cli.js
@@ -43,3 +43,58 @@ test("unknown task and usage errors", () => {
   assert.equal(tasks("add").status, 2);
   assert.equal(tasks("borrar").status, 2);
 });
+
+test("add with --priority and list sorted by priority (alta > media > baja)", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "baja", "uno", "--priority", "baja").status, 0);
+  assert.equal(tasks("add", "alta", "uno", "--priority", "alta").status, 0);
+  assert.equal(tasks("add", "media", "uno", "--priority", "media").status, 0);
+  assert.equal(tasks("add", "default", "dos").status, 0);
+  assert.equal(tasks("add", "alta", "dos", "--priority", "alta").status, 0);
+  assert.equal(tasks("add", "baja", "dos", "--priority", "baja").status, 0);
+
+  assert.equal(
+    tasks("list").out,
+    "[ ] 2 alta uno\n" +
+    "[ ] 5 alta dos\n" +
+    "[ ] 3 media uno\n" +
+    "[ ] 4 default dos\n" +
+    "[ ] 1 baja uno\n" +
+    "[ ] 6 baja dos\n"
+  );
+});
+
+test("priority usage errors", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "tarea", "--priority", "invalida").status, 2);
+  assert.equal(tasks("add", "tarea", "--priority").status, 2);
+  assert.equal(tasks("add", "--priority", "alta").status, 2);
+  assert.equal(tasks("add", "--priority").status, 2);
+  assert.equal(tasks("add", "tarea", "--priority", "alta", "extra").status, 2);
+});
+
+test("handles tasks without priority property as media in list", () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "tasks-"));
+  const file = path.join(dir, "tasks.json");
+  fs.writeFileSync(
+    file,
+    JSON.stringify({
+      nextId: 3,
+      tasks: [
+        { id: 1, title: "antigua", done: false },
+        { id: 2, title: "urgente", priority: "alta", done: false },
+      ],
+    })
+  );
+
+  let out = "";
+  let err = "";
+  const status = run(["list"], {
+    env: { TASKS_FILE: file },
+    stdout: { write: (text) => { out += text; } },
+    stderr: { write: (text) => { err += text; } },
+  });
+
+  assert.equal(status, 0);
+  assert.equal(out, "[ ] 2 urgente\n[ ] 1 antigua\n");
+});
