diff --git a/test/app.js b/test/app.js
index 9815af7..388b602 100644
--- a/test/app.js
+++ b/test/app.js
@@ -7,6 +7,7 @@ const { createApp } = require("../src/app.js");
 
 const ana = { id: "u1", tenantId: "acme" };
 const bruno = { id: "u2", tenantId: "acme" };
+const carla = { id: "u3", tenantId: "acme" };
 const zoe = { id: "u9", tenantId: "globex" };
 
 test("owners create, list, read, update, and delete their notes", () => {
@@ -31,3 +32,54 @@ test("other users cannot read a note", () => {
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/notes" }).status, 401);
 });
+
+test("users can share a note with a coworker who can list and read it", () => {
+  const app = createApp();
+  const created = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Sprint Goals", body: "Ship fast" } });
+  const id = created.body.id;
+
+  // Before sharing, bruno cannot see or read it
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: bruno }).status, 403);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: bruno }).body, []);
+
+  // Share note with bruno
+  const shared = app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } });
+  assert.equal(shared.status, 200);
+  assert.equal(shared.body.id, id);
+  assert.deepEqual(shared.body.sharedWith, ["u2"]);
+
+  // Sharing again is idempotent
+  const sharedAgain = app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } });
+  assert.equal(sharedAgain.status, 200);
+  assert.deepEqual(sharedAgain.body.sharedWith, ["u2"]);
+
+  // Bruno now sees it in GET /notes
+  const brunoNotes = app.handle({ method: "GET", path: "/notes", user: bruno });
+  assert.equal(brunoNotes.status, 200);
+  assert.deepEqual(brunoNotes.body.map((note) => note.id), [id]);
+
+  // Bruno can open it with GET /notes/:id
+  const brunoRead = app.handle({ method: "GET", path: `/notes/${id}`, user: bruno });
+  assert.equal(brunoRead.status, 200);
+  assert.equal(brunoRead.body.title, "Sprint Goals");
+  assert.equal(brunoRead.body.body, "Ship fast");
+
+  // Bruno cannot edit or delete the note
+  assert.equal(app.handle({ method: "PUT", path: `/notes/${id}`, user: bruno, body: { title: "Hijacked" } }).status, 403);
+  assert.equal(app.handle({ method: "DELETE", path: `/notes/${id}`, user: bruno }).status, 403);
+
+  // Bruno cannot re-share the note
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: bruno, body: { userId: "u3" } }).status, 403);
+
+  // Carla was not shared with, so she cannot read it
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: carla }).status, 403);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: carla }).body, []);
+
+  // Cross-tenant user Zoe cannot read it or be shared with
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: zoe }).status, 404);
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u9" } }).status, 404);
+
+  // Validation errors
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: {} }).status, 400);
+  assert.equal(app.handle({ method: "POST", path: "/notes/non-existent/share", user: ana, body: { userId: "u2" } }).status, 404);
+});
