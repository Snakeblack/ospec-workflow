diff --git a/README.md b/README.md
index 4c576f0..6e43772 100644
--- a/README.md
+++ b/README.md
@@ -5,10 +5,15 @@ Gestor de tareas personal para la terminal. Guarda las tareas en un fichero JSON
 
 ```sh
 tasks add Comprar pan
+tasks add Llamar al médico --priority alta
 tasks list
 tasks done 1
 ```
 
+La prioridad es `alta`, `media` (por defecto) o `baja`. Debe ir al final del
+comando. `tasks list` muestra primero las de prioridad más alta; dentro de cada
+prioridad se mantiene el orden de creación.
+
 Códigos de salida: `0` correcto, `1` la tarea no existe, `2` error de uso.
 
 Pruebas: `npm test`.
diff --git a/src/cli.js b/src/cli.js
index 3f5f441..dffe7bc 100644
--- a/src/cli.js
+++ b/src/cli.js
@@ -2,7 +2,18 @@
 
 const { storePath, load, save } = require("./store.js");
 
-const USAGE = "uso: tasks add <título> | tasks list | tasks done <id>";
+const USAGE =
+  "uso: tasks add <título> [--priority alta|media|baja] | tasks list | tasks done <id>";
+
+// Highest priority first; the index is the sort rank.
+const PRIORITIES = ["alta", "media", "baja"];
+const DEFAULT_PRIORITY = "media";
+
+// Tasks saved before priorities existed have no field and count as the default.
+function rank(task) {
+  const index = PRIORITIES.indexOf(task.priority);
+  return index === -1 ? PRIORITIES.indexOf(DEFAULT_PRIORITY) : index;
+}
 
 // Exit codes: 0 ok, 1 the task does not exist, 2 usage error.
 function run(argv, { stdout = process.stdout, stderr = process.stderr, env = process.env } = {}) {
@@ -10,13 +21,17 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
   const file = storePath(env);
 
   if (command === "add") {
-    const title = rest.join(" ").trim();
-    if (!title) {
+    // --priority is only recognised as the last two arguments.
+    const flagged = rest.length >= 2 && rest[rest.length - 2] === "--priority";
+    const priority = flagged ? rest[rest.length - 1] : DEFAULT_PRIORITY;
+    const words = flagged ? rest.slice(0, -2) : rest;
+    const title = words.join(" ").trim();
+    if (!title || !PRIORITIES.includes(priority) || (!flagged && rest.includes("--priority"))) {
       stderr.write(`${USAGE}\n`);
       return 2;
     }
     const data = load(file);
-    const task = { id: data.nextId, title, done: false };
+    const task = { id: data.nextId, title, priority, done: false };
     data.nextId += 1;
     data.tasks.push(task);
     save(file, data);
@@ -26,7 +41,9 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
 
   if (command === "list") {
     const data = load(file);
-    for (const task of data.tasks) {
+    // Array.prototype.sort is stable, so equal priorities keep insertion order.
+    const ordered = [...data.tasks].sort((a, b) => rank(a) - rank(b));
+    for (const task of ordered) {
       stdout.write(`${task.done ? "[x]" : "[ ]"} ${task.id} ${task.title}\n`);
     }
     return 0;
diff --git a/test/cli.js b/test/cli.js
index 0ddacaa..8be94fd 100644
--- a/test/cli.js
+++ b/test/cli.js
@@ -43,3 +43,36 @@ test("unknown task and usage errors", () => {
   assert.equal(tasks("add").status, 2);
   assert.equal(tasks("borrar").status, 2);
 });
+
+test("add accepts a trailing --priority and list shows higher priority first", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "comprar", "pan", "--priority", "baja").status, 0);
+  assert.equal(tasks("add", "llamar", "--priority", "alta").status, 0);
+  assert.equal(tasks("add", "regar", "--priority", "media").status, 0);
+  assert.equal(tasks("list").out, "[ ] 2 llamar\n[ ] 3 regar\n[ ] 1 comprar pan\n");
+});
+
+test("tasks without priority are media and keep insertion order among equals", () => {
+  const tasks = session();
+  tasks("add", "primera");
+  tasks("add", "alta", "--priority", "alta");
+  tasks("add", "segunda", "--priority", "media");
+  tasks("add", "tercera");
+  assert.equal(tasks("list").out, "[ ] 2 alta\n[ ] 1 primera\n[ ] 3 segunda\n[ ] 4 tercera\n");
+});
+
+test("done keeps the priority order", () => {
+  const tasks = session();
+  tasks("add", "baja", "--priority", "baja");
+  tasks("add", "alta", "--priority", "alta");
+  assert.equal(tasks("done", "2").status, 0);
+  assert.equal(tasks("list").out, "[x] 2 alta\n[ ] 1 baja\n");
+});
+
+test("invalid or incomplete --priority is a usage error and adds nothing", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "x", "--priority", "urgente").status, 2);
+  assert.equal(tasks("add", "x", "--priority").status, 2);
+  assert.equal(tasks("add", "--priority", "alta").status, 2);
+  assert.equal(tasks("list").out, "");
+});
