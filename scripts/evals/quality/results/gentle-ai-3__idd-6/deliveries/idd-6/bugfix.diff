+test("totalPages is the number of pages needed for every item", () => {
+  const twenty = Array.from({ length: 20 }, (_, index) => index + 1);
+  assert.equal(paginate(twenty, 1, 10).totalPages, 2);
+  assert.equal(paginate(items.slice(0, 10), 1, 10).totalPages, 1);
+  assert.equal(paginate([], 1, 10).totalPages, 0);
+});
+
+test("page below 1 falls back to page 1", () => {
+  const first = paginate(items, 1, 10);
+  assert.deepEqual(paginate(items, 0, 10), { ...first, page: 1 });
+  assert.deepEqual(paginate(items, -3, 10), { ...first, page: 1 });
+  assert.deepEqual(paginate(items, 1.5, 10), { ...first, page: 1 });
+});
+
+test("page past the last one has no items and keeps totalPages", () => {
+  const result = paginate(items, 4, 10);
+  assert.deepEqual(result.items, []);
+  assert.equal(result.page, 4);
+  assert.equal(result.totalPages, 3);
+});
+
