+
+test("add accepts --priority at the end and list shows highest priority first", () => {
+  const tasks = session();
+  tasks("add", "llamar", "--priority", "baja");
+  tasks("add", "Comprar", "pan", "--priority", "alta");
+  tasks("add", "regar");
+  tasks("add", "pagar", "--priority", "alta");
+  assert.equal(
+    tasks("list").out,
+    "[ ] 2 Comprar pan (alta)\n[ ] 4 pagar (alta)\n[ ] 3 regar (media)\n[ ] 1 llamar (baja)\n",
+  );
+});
+
+test("priority is case-insensitive and stored in lowercase", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "pan", "--priority", "ALTA").status, 0);
+  assert.equal(tasks("list").out, "[ ] 1 pan (alta)\n");
+});
+
+test("invalid or missing priority is a usage error and saves nothing", () => {
+  const tasks = session();
+  const invalid = tasks("add", "pan", "--priority", "urgente");
+  assert.equal(invalid.status, 2);
+  assert.match(invalid.err, /uso: tasks add/);
+  assert.equal(tasks("add", "pan", "--priority").status, 2);
+  assert.equal(tasks("add", "--priority", "alta").status, 2);
+  assert.equal(tasks("list").out, "");
+});
+
+test("tasks saved without priority are listed as media", () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "tasks-"));
+  const file = path.join(dir, "tasks.json");
+  fs.writeFileSync(file, JSON.stringify({
+    nextId: 3,
+    tasks: [
+      { id: 1, title: "antigua", done: false },
+      { id: 2, title: "urgente", done: false, priority: "alta" },
+    ],
+  }));
+  let out = "";
+  run(["list"], { env: { TASKS_FILE: file }, stdout: { write: (text) => { out += text; } } });
+  assert.equal(out, "[ ] 2 urgente (alta)\n[ ] 1 antigua (media)\n");
+});
