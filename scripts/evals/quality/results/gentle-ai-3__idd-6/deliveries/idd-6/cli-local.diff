@@ -2,7 +2,30 @@
 
 const { storePath, load, save } = require("./store.js");
 
-const USAGE = "uso: tasks add <título> | tasks list | tasks done <id>";
+const USAGE = "uso: tasks add <título> [--priority <alta|media|baja>] | tasks list | tasks done <id>";
+const PRIORITIES = ["alta", "media", "baja"];
+const DEFAULT_PRIORITY = "media";
+
+// Only a trailing `--priority <value>` pair is a flag, so titles keep any other words.
+function parseAdd(words) {
+  const flagAt = words.length - 2;
+  let priority = DEFAULT_PRIORITY;
+  let titleWords = words;
+  if (flagAt >= 0 && words[flagAt] === "--priority") {
+    priority = words[flagAt + 1].toLowerCase();
+    titleWords = words.slice(0, flagAt);
+  } else if (words[words.length - 1] === "--priority") {
+    return null;
+  }
+  const title = titleWords.join(" ").trim();
+  if (!title || !PRIORITIES.includes(priority)) return null;
+  return { title, priority };
+}
+
+// Tasks saved before priorities existed have no field and count as the default.
+function priorityOf(task) {
+  return PRIORITIES.includes(task.priority) ? task.priority : DEFAULT_PRIORITY;
+}
 
 // Exit codes: 0 ok, 1 the task does not exist, 2 usage error.
 function run(argv, { stdout = process.stdout, stderr = process.stderr, env = process.env } = {}) {
@@ -10,13 +33,13 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
   const file = storePath(env);
 
   if (command === "add") {
-    const title = rest.join(" ").trim();
-    if (!title) {
+    const parsed = parseAdd(rest);
+    if (!parsed) {
       stderr.write(`${USAGE}\n`);
       return 2;
     }
     const data = load(file);
-    const task = { id: data.nextId, title, done: false };
+    const task = { id: data.nextId, title: parsed.title, done: false, priority: parsed.priority };
     data.nextId += 1;
     data.tasks.push(task);
     save(file, data);
@@ -26,8 +49,12 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
 
   if (command === "list") {
     const data = load(file);
-    for (const task of data.tasks) {
-      stdout.write(`${task.done ? "[x]" : "[ ]"} ${task.id} ${task.title}\n`);
+    // Array sort is stable, so tasks within the same priority keep creation order.
+    const byPriority = [...data.tasks].sort(
+      (a, b) => PRIORITIES.indexOf(priorityOf(a)) - PRIORITIES.indexOf(priorityOf(b)),
+    );
+    for (const task of byPriority) {
+      stdout.write(`${task.done ? "[x]" : "[ ]"} ${task.id} ${task.title} (${priorityOf(task)})\n`);
     }
     return 0;
   }
