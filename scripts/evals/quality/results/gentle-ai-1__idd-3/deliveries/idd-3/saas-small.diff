@@ -31,3 +31,48 @@ test("other users cannot read a note", () => {
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/notes" }).status, 401);
 });
+
+const carla = { id: "u3", tenantId: "acme" };
+
+function shared() {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Equipo" } }).body;
+  const share = (user, userId) => app.handle({ method: "POST", path: `/notes/${id}/share`, user, body: { userId } });
+  return { app, id, share };
+}
+
+test("a shared note is listed and readable by the colleague, read-only", () => {
+  const { app, id, share } = shared();
+  assert.equal(share(ana, "u2").status, 200);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: bruno }).body.map((n) => n.id), [id]);
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: bruno }).status, 200);
+  assert.equal(app.handle({ method: "PUT", path: `/notes/${id}`, user: bruno, body: { title: "x" } }).status, 403);
+  assert.equal(app.handle({ method: "DELETE", path: `/notes/${id}`, user: bruno }).status, 403);
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: carla }).status, 403);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: carla }).body, []);
+});
+
+test("only the owner can share; the recipient cannot re-share", () => {
+  const { share } = shared();
+  assert.equal(share(bruno, "u3").status, 403);
+  share(ana, "u2");
+  assert.equal(share(bruno, "u3").status, 403);
+  assert.equal(share(zoe, "u3").status, 404);
+});
+
+test("sharing twice is idempotent and does not duplicate the note", () => {
+  const { app, share } = shared();
+  share(ana, "u2");
+  assert.equal(share(ana, "u2").status, 200);
+  assert.equal(app.handle({ method: "GET", path: "/notes", user: bruno }).body.length, 1);
+});
+
+test("sharing across organizations or with invalid users fails and grants nothing", () => {
+  const { app, id, share } = shared();
+  assert.equal(share(ana, "u9").status, 404);
+  assert.equal(share(ana, "nadie").status, 404);
+  assert.equal(share(ana, undefined).status, 400);
+  assert.equal(share(ana, "u1").status, 400);
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: zoe }).status, 404);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: zoe }).body, []);
+});
