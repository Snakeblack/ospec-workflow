 const { storePath, load, save } = require("./store.js");
 
-const USAGE = "uso: tasks add <título> | tasks list | tasks done <id>";
+const USAGE = "uso: tasks add <título> [--priority <alta|media|baja>] | tasks list | tasks done <id>";
+
+const PRIORITIES = ["alta", "media", "baja"];
+const DEFAULT_PRIORITY = "media";
+
+function rank(task) {
+  const index = PRIORITIES.indexOf(task.priority);
+  return index === -1 ? PRIORITIES.indexOf(DEFAULT_PRIORITY) : index;
+}
 
 // Exit codes: 0 ok, 1 the task does not exist, 2 usage error.
 function run(argv, { stdout = process.stdout, stderr = process.stderr, env = process.env } = {}) {
@@ -10,13 +18,25 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
   const file = storePath(env);
 
   if (command === "add") {
-    const title = rest.join(" ").trim();
+    let titleWords = rest;
+    let priority = DEFAULT_PRIORITY;
+    const flag = rest.indexOf("--priority");
+    if (flag !== -1) {
+      titleWords = rest.slice(0, flag);
+      const values = rest.slice(flag + 1);
+      priority = values.length === 1 ? values[0].toLowerCase() : "";
+      if (!PRIORITIES.includes(priority)) {
+        stderr.write(`prioridad no válida: use alta, media o baja\n${USAGE}\n`);
+        return 2;
+      }
+    }
+    const title = titleWords.join(" ").trim();
     if (!title) {
       stderr.write(`${USAGE}\n`);
       return 2;
     }
     const data = load(file);
-    const task = { id: data.nextId, title, done: false };
+    const task = { id: data.nextId, title, done: false, priority };
     data.nextId += 1;
     data.tasks.push(task);
     save(file, data);
@@ -26,8 +46,12 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
 
   if (command === "list") {
     const data = load(file);
-    for (const task of data.tasks) {
-      stdout.write(`${task.done ? "[x]" : "[ ]"} ${task.id} ${task.title}\n`);
+    const ordered = data.tasks
+      .map((task, index) => ({ task, index }))
+      .sort((a, b) => rank(a.task) - rank(b.task) || a.index - b.index);
+    for (const { task } of ordered) {
+      const priority = PRIORITIES.includes(task.priority) ? task.priority : DEFAULT_PRIORITY;
+      stdout.write(`${task.done ? "[x]" : "[ ]"} ${task.id} ${task.title} (${priority})\n`);
     }
     return 0;
   }
