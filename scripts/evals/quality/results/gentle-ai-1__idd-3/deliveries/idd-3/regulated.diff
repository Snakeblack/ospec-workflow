+
+test("exportAppointmentsCsv lists the day sorted by time with CSV escaping", () => {
+  const clinic = createClinic({
+    patients: [
+      { id: "p1", name: "Pérez, Ana" },
+      { id: "p2", name: "Luis Gómez" },
+    ],
+    appointments: [
+      { id: "a1", patientId: "p2", date: "2026-10-06", time: "11:00", reason: "Revisión \"anual\"" },
+      { id: "a2", patientId: "p1", date: "2026-10-06", time: "09:30", reason: "Control" },
+      { id: "a3", patientId: "p1", date: "2026-10-07", time: "08:00", reason: "Otro día" },
+    ],
+  });
+  assert.equal(
+    clinic.exportAppointmentsCsv("2026-10-06", reception),
+    'hora,paciente,motivo\r\n09:30,"Pérez, Ana",Control\r\n11:00,Luis Gómez,"Revisión ""anual"""',
+  );
+});
+
+test("exportAppointmentsCsv: empty day, unknown patient and formula neutralisation", () => {
+  const clinic = createClinic({
+    patients,
+    appointments: [{ id: "a1", patientId: "zz", date: "2026-10-06", time: "09:00", reason: "=1+1" }],
+  });
+  assert.equal(clinic.exportAppointmentsCsv("2026-10-09", doctor), "hora,paciente,motivo");
+  assert.equal(clinic.exportAppointmentsCsv("2026-10-06", doctor), "hora,paciente,motivo\r\n09:00,,'=1+1");
+});
+
+test("exportAppointmentsCsv is role-checked and audited with the row count", () => {
+  const clinic = createClinic({ patients, appointments });
+  assert.throws(() => clinic.exportAppointmentsCsv("2026-10-06", { id: "x", role: "nurse" }), AccessDeniedError);
+  assert.throws(() => clinic.exportAppointmentsCsv("2026-10-06"), AccessDeniedError);
+  assert.equal(clinic.audit.entries().length, 0);
+  clinic.exportAppointmentsCsv("2026-10-06", reception);
+  assert.deepEqual(
+    clinic.audit.entries().map(({ action, actorId, date, count }) => ({ action, actorId, date, count })),
+    [{ action: "export-appointments-csv", actorId: "r1", date: "2026-10-06", count: 1 }],
+  );
+});
