 const { storePath, load, save } = require("./store.js");
 
-const USAGE = "uso: tasks add <título> | tasks list | tasks done <id>";
+const USAGE = "uso: tasks add <título> [--priority <alta|media|baja>] | tasks list | tasks done <id>";
+
+// Lower rank is listed first. Tasks stored without a priority count as "media".
+const PRIORITY_RANK = { alta: 0, media: 1, baja: 2 };
+const DEFAULT_PRIORITY = "media";
+
+// Parses an optional trailing `--priority <value>`; returns null on a usage error.
+function parseAdd(args) {
+  let words = args;
+  let priority = DEFAULT_PRIORITY;
+  if (args.includes("--priority")) {
+    if (args.length < 2 || args[args.length - 2] !== "--priority") return null;
+    priority = args[args.length - 1];
+    if (!(priority in PRIORITY_RANK)) return null;
+    words = args.slice(0, -2);
+  }
+  const title = words.join(" ").trim();
+  return title ? { title, priority } : null;
+}
 
 // Exit codes: 0 ok, 1 the task does not exist, 2 usage error.
 function run(argv, { stdout = process.stdout, stderr = process.stderr, env = process.env } = {}) {
@@ -10,13 +28,13 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
   const file = storePath(env);
 
   if (command === "add") {
-    const title = rest.join(" ").trim();
-    if (!title) {
+    const parsed = parseAdd(rest);
+    if (!parsed) {
       stderr.write(`${USAGE}\n`);
       return 2;
     }
     const data = load(file);
-    const task = { id: data.nextId, title, done: false };
+    const task = { id: data.nextId, title: parsed.title, done: false, priority: parsed.priority };
     data.nextId += 1;
     data.tasks.push(task);
     save(file, data);
@@ -26,7 +44,9 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
 
   if (command === "list") {
     const data = load(file);
-    for (const task of data.tasks) {
+    const rank = (task) => PRIORITY_RANK[task.priority ?? DEFAULT_PRIORITY];
+    const ordered = [...data.tasks].sort((a, b) => rank(a) - rank(b) || a.id - b.id);
+    for (const task of ordered) {
       stdout.write(`${task.done ? "[x]" : "[ ]"} ${task.id} ${task.title}\n`);
     }
     return 0;
diff --git a/test/cli.js b/test/cli.js
index 0ddacaa..fc4ce44 100644
--- a/test/cli.js
+++ b/test/cli.js
@@ -43,3 +43,31 @@ test("unknown task and usage errors", () => {
   assert.equal(tasks("add").status, 2);
   assert.equal(tasks("borrar").status, 2);
 });
+
+test("add accepts a trailing --priority and list shows higher priority first", () => {
+  const tasks = session();
+  tasks("add", "baja tarea", "--priority", "baja");
+  tasks("add", "sin prioridad");
+  tasks("add", "Comprar", "pan", "--priority", "alta");
+  tasks("add", "otra media", "--priority", "media");
+  assert.equal(
+    tasks("list").out,
+    "[ ] 3 Comprar pan\n[ ] 2 sin prioridad\n[ ] 4 otra media\n[ ] 1 baja tarea\n",
+  );
+});
+
+test("add rejects an invalid or missing priority", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "x", "--priority", "urgente").status, 2);
+  assert.equal(tasks("add", "x", "--priority").status, 2);
+  assert.equal(tasks("add", "--priority", "alta").status, 2);
+  assert.equal(tasks("list").out, "");
+});
+
+test("tasks stored without priority count as media", () => {
+  const tasks = session();
+  tasks("add", "a");
+  tasks("add", "b", "--priority", "alta");
+  tasks("add", "c", "--priority", "baja");
+  assert.equal(tasks("list").out, "[ ] 2 b\n[ ] 1 a\n[ ] 3 c\n");
+});
