+function createShared() {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Compartida" } }).body;
+  const share = (user, body) => app.handle({ method: "POST", path: `/notes/${id}/share`, user, body });
+  return { app, id, share };
+}
+
+test("owner shares a note: the colleague lists and reads it but cannot edit or delete", () => {
+  const { app, id, share } = createShared();
+  assert.equal(share(ana, { userId: "u2" }).status, 200);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: bruno }).body.map((note) => note.id), [id]);
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: bruno }).status, 200);
+  assert.equal(app.handle({ method: "PUT", path: `/notes/${id}`, user: bruno, body: { title: "X" } }).status, 403);
+  assert.equal(app.handle({ method: "DELETE", path: `/notes/${id}`, user: bruno }).status, 403);
+  assert.equal(share(bruno, { userId: "u3" }).status, 403);
+});
+
+test("sharing is idempotent and does not leak to other users", () => {
+  const { app, id, share } = createShared();
+  share(ana, { userId: "u2" });
+  share(ana, { userId: "u2" });
+  assert.equal(app.handle({ method: "GET", path: "/notes", user: bruno }).body.length, 1);
+  const carla = { id: "u3", tenantId: "acme" };
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: carla }).status, 403);
+});
+
+test("share validates the target user and tenant", () => {
+  const { app, id, share } = createShared();
+  assert.equal(share(ana, {}).status, 400);
+  assert.equal(share(ana, { userId: "nope" }).status, 404);
+  assert.equal(share(ana, { userId: "u9" }).status, 404);
+  assert.equal(share(zoe, { userId: "u9" }).status, 404);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: zoe }).body, []);
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: zoe }).status, 404);
+});
+
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/notes" }).status, 401);
 });
