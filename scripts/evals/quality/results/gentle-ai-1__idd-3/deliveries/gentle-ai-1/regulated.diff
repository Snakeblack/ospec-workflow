+++ b/test/clinic.js
@@ -31,3 +31,32 @@ test("appointments of a day are listed and audited", () => {
   assert.deepEqual(clinic.appointmentsOn("2026-10-06", reception).map((item) => item.id), ["a1"]);
   assert.equal(clinic.audit.entries()[0].count, 1);
 });
+
+test("reception exports a day's appointments as CSV sorted by time and the export is audited", () => {
+  const clinic = createClinic({
+    patients: [...patients, { id: "p2", nationalId: "87654321X", name: 'Ana "Nina", Ruiz', birthDate: "1990-01-01", diagnosis: "Asma" }],
+    appointments: [
+      { id: "a3", patientId: "p2", date: "2026-10-06", time: "08:15", reason: "Revisión, anual" },
+      ...appointments,
+    ],
+  });
+  assert.equal(
+    clinic.exportAppointmentsCsv("2026-10-06", reception),
+    'time,patient,reason\n08:15,"Ana ""Nina"", Ruiz","Revisión, anual"\n09:30,Luis Gómez,Control\n',
+  );
+  const entry = clinic.audit.entries()[0];
+  assert.deepEqual([entry.action, entry.actorId, entry.date, entry.count], ["export-appointments", "r1", "2026-10-06", 2]);
+});
+
+test("export without appointments yields only the header and does not expose diagnoses", () => {
+  const clinic = createClinic({ patients, appointments });
+  assert.equal(clinic.exportAppointmentsCsv("2030-01-01", doctor), "time,patient,reason\n");
+  assert.ok(!clinic.exportAppointmentsCsv("2026-10-06", doctor).includes("Hipertensión"));
+});
+
+test("export requires an authorized role", () => {
+  const clinic = createClinic({ patients, appointments });
+  assert.throws(() => clinic.exportAppointmentsCsv("2026-10-06", { id: "x1", role: "nurse" }), AccessDeniedError);
+  assert.throws(() => clinic.exportAppointmentsCsv("2026-10-06"), AccessDeniedError);
+  assert.equal(clinic.audit.entries().length, 0);
+});
