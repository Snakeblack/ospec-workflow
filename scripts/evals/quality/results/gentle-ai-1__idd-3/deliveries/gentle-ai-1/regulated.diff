diff --git a/README.md b/README.md
index dbf6558..355125e 100644
--- a/README.md
+++ b/README.md
@@ -11,4 +11,8 @@ Cada acceso a datos de pacientes queda registrado en la auditoría
 | `doctor` | Leer historias y la agenda |
 | `reception` | Leer la agenda |
 
+`exportAppointmentsCsv(date, actor)` (`doctor` y `reception`) devuelve las citas
+de un día en CSV (`time,patient,reason`, ordenadas por hora). No incluye
+diagnósticos y la exportación queda auditada como `export-appointments`.
+
 Pruebas: `npm test`.
diff --git a/src/clinic.js b/src/clinic.js
index e4eb220..80fcd50 100644
--- a/src/clinic.js
+++ b/src/clinic.js
@@ -32,7 +32,24 @@ function createClinic({ patients = [], appointments = [], audit = createAuditLog
     return result;
   }
 
-  return { getPatient, appointmentsOn, audit };
+  function csvField(value) {
+    const text = String(value);
+    return /[",\r\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
+  }
+
+  // Exports patient names, so it is audited as its own action. Diagnoses are never included.
+  function exportAppointmentsCsv(date, actor) {
+    requireRole(actor, ["doctor", "reception"]);
+    const day = appointments.filter((item) => item.date === date).sort((a, b) => a.time.localeCompare(b.time));
+    const rows = day.map((item) => {
+      const patient = patients.find((candidate) => candidate.id === item.patientId);
+      return [item.time, patient ? patient.name : "", item.reason].map(csvField).join(",");
+    });
+    audit.record({ action: "export-appointments", actorId: actor.id, date, count: day.length });
+    return ["time,patient,reason", ...rows].join("\n") + "\n";
+  }
+
+  return { getPatient, appointmentsOn, exportAppointmentsCsv, audit };
 }
 
 module.exports = { createClinic, AccessDeniedError };
diff --git a/test/clinic.js b/test/clinic.js
index 6da846c..42f0e11 100644
