+test('Edge cases: cancel edit, blur, empty edit, whitespace and hashchange', () => {
+  const mock = createMockDOM();
+  runScriptInMock(mock);
+  const { inputNuevaTarea, lista, contador, window, elementsById } = mock;
+
+  // 1. Whitespace only input
+  inputNuevaTarea.value = '   ';
+  inputNuevaTarea.dispatchEvent({ type: 'keydown', key: 'Enter' });
+  assert.strictEqual(lista.children.length, 0, 'No debe añadir tareas con espacios en blanco');
+
+  // 2. Añadir tarea con espacios alrededor
+  inputNuevaTarea.value = '  Comprar pan  ';
+  inputNuevaTarea.dispatchEvent({ type: 'keydown', key: 'Enter' });
+  assert.strictEqual(lista.children.length, 1);
+  assert.strictEqual(lista.children[0].querySelector('.titulo').textContent, 'Comprar pan');
+
+  // 3. Cancelar edición con Escape
+  const li = lista.children[0];
+  const titulo = li.querySelector('.titulo');
+  titulo.dispatchEvent({ type: 'dblclick' });
+  const edicion = li.querySelector('.edicion');
+  assert.ok(edicion);
+  edicion.value = 'Texto cambiado no guardado';
+  edicion.dispatchEvent({ type: 'keydown', key: 'Escape' });
+  assert.strictEqual(lista.children[0].querySelector('.titulo').textContent, 'Comprar pan', 'Escape cancela edición');
+
+  // 4. Guardar edición con blur
+  lista.children[0].querySelector('.titulo').dispatchEvent({ type: 'dblclick' });
+  const edicion2 = lista.children[0].querySelector('.edicion');
+  edicion2.value = 'Comprar pan integral';
+  edicion2.dispatchEvent({ type: 'blur' });
+  assert.strictEqual(lista.children[0].querySelector('.titulo').textContent, 'Comprar pan integral', 'Blur guarda edición');
+
+  // 5. Edición con texto vacío borra la tarea
+  lista.children[0].querySelector('.titulo').dispatchEvent({ type: 'dblclick' });
+  const edicion3 = lista.children[0].querySelector('.edicion');
+  edicion3.value = '   ';
+  edicion3.dispatchEvent({ type: 'keydown', key: 'Enter' });
+  assert.strictEqual(lista.children.length, 0, 'Edición vacía borra la tarea');
+
+  // 6. Navegación por hashchange
+  inputNuevaTarea.value = 'Tarea activa';
+  inputNuevaTarea.dispatchEvent({ type: 'keydown', key: 'Enter' });
+  inputNuevaTarea.value = 'Tarea hecha';
+  inputNuevaTarea.dispatchEvent({ type: 'keydown', key: 'Enter' });
+  lista.children[1].querySelector('.completar').checked = true;
+  lista.children[1].querySelector('.completar').dispatchEvent({ type: 'change' });
+
+  window.location.hash = '#/pendientes';
+  window.dispatchEvent({ type: 'hashchange' });
+  assert.strictEqual(lista.children.length, 1);
+  assert.strictEqual(lista.children[0].querySelector('.titulo').textContent, 'Tarea activa');
+
+  window.location.hash = '#/completadas';
+  window.dispatchEvent({ type: 'hashchange' });
+  assert.strictEqual(lista.children.length, 1);
+  assert.strictEqual(lista.children[0].querySelector('.titulo').textContent, 'Tarea hecha');
+
+  window.location.hash = '#/todas';
+  window.dispatchEvent({ type: 'hashchange' });
+  assert.strictEqual(lista.children.length, 2);
+
+  // 7. Desmarcar tarea completada
+  const liHecha = lista.children[1];
+  const chk = liHecha.querySelector('.completar');
+  chk.checked = false;
+  chk.dispatchEvent({ type: 'change' });
+  assert.ok(contador.textContent.includes('2'), 'Al desmarcar debe haber 2 pendientes');
+});
