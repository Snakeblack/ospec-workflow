index 0000000..eb356ff
--- /dev/null
+++ b/test/index.test.js
@@ -0,0 +1,425 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+
+const htmlPath = path.resolve(__dirname, '../index.html');
+
+test('index.html exists and meets structural requirements', () => {
+  assert.ok(fs.existsSync(htmlPath), 'index.html debe existir en la raíz');
+  const content = fs.readFileSync(htmlPath, 'utf8');
+
+  // Sin dependencias externas ni scripts externos
+  assert.strictEqual(
+    /<script\s+[^>]*src=/i.test(content),
+    false,
+    'index.html no debe tener scripts externos'
+  );
+  assert.strictEqual(
+    /<link\s+[^>]*rel=["']stylesheet["']/i.test(content),
+    false,
+    'index.html no debe tener hojas de estilo externas'
+  );
+
+  // Selectores del contrato
+  assert.ok(content.includes('id="nueva-tarea"'), 'Debe incluir id="nueva-tarea"');
+  assert.ok(content.includes('id="lista"'), 'Debe incluir id="lista"');
+  assert.ok(content.includes('id="contador"'), 'Debe incluir id="contador"');
+  assert.ok(content.includes('id="filtro-todas"'), 'Debe incluir id="filtro-todas"');
+  assert.ok(content.includes('id="filtro-pendientes"'), 'Debe incluir id="filtro-pendientes"');
+  assert.ok(content.includes('id="filtro-completadas"'), 'Debe incluir id="filtro-completadas"');
+  assert.ok(content.includes('completar'), 'Debe manejar la clase "completar"');
+  assert.ok(content.includes('titulo'), 'Debe manejar la clase "titulo"');
+  assert.ok(content.includes('edicion'), 'Debe manejar la clase "edicion"');
+  assert.ok(content.includes('borrar'), 'Debe manejar la clase "borrar"');
+});
+
+function createMockDOM(initialHtml, storedData = null) {
+  const store = new Map();
+  if (storedData) {
+    store.set('todos', storedData);
+  }
+
+  const localStorage = {
+    getItem(key) {
+      return store.has(key) ? store.get(key) : null;
+    },
+    setItem(key, value) {
+      store.set(key, String(value));
+    },
+    removeItem(key) {
+      store.delete(key);
+    },
+    clear() {
+      store.clear();
+    }
+  };
+
+  class MockElement {
+    constructor(tagName = 'div') {
+      this.tagName = tagName.toUpperCase();
+      this.children = [];
+      this.parentNode = null;
+      this.classList = {
+        _classes: new Set(),
+        add(...cls) { cls.forEach(c => this._classes.add(c)); },
+        remove(...cls) { cls.forEach(c => this._classes.delete(c)); },
+        toggle(cls, force) {
+          if (force === undefined) {
+            if (this._classes.has(cls)) this._classes.delete(cls);
+            else this._classes.add(cls);
+          } else if (force) {
+            this._classes.add(cls);
+          } else {
+            this._classes.delete(cls);
+          }
+        },
+        contains(cls) { return this._classes.has(cls); }
+      };
+      this.attributes = new Map();
+      this.listeners = new Map();
+      this.style = {};
+      this.dataset = {};
+      this._textContent = '';
+      this._value = '';
+      this._checked = false;
+      this.id = '';
+      this.className = '';
+    }
+
+    get className() {
+      return Array.from(this.classList._classes).join(' ');
+    }
+
+    set className(val) {
+      this.classList._classes.clear();
+      if (val) val.split(/\s+/).forEach(c => { if (c) this.classList._classes.add(c); });
+    }
+
+    get textContent() {
+      return this._textContent;
+    }
+
+    set textContent(val) {
+      this._textContent = String(val);
+      this.children = [];
+    }
+
+    get value() {
+      return this._value;
+    }
+
+    set value(val) {
+      this._value = String(val);
+    }
+
+    get checked() {
+      return this._checked;
+    }
+
+    set checked(val) {
+      this._checked = Boolean(val);
+    }
+
+    setAttribute(name, val) {
+      this.attributes.set(name, String(val));
+    }
+
+    getAttribute(name) {
+      return this.attributes.get(name) || null;
+    }
+
+    appendChild(child) {
+      child.parentNode = this;
+      this.children.push(child);
+      return child;
+    }
+
+    removeChild(child) {
+      const idx = this.children.indexOf(child);
+      if (idx !== -1) {
+        this.children.splice(idx, 1);
+        child.parentNode = null;
+      }
+      return child;
+    }
+
+    set innerHTML(val) {
+      if (val === '') {
+        this.children = [];
+        this._textContent = '';
+      }
+    }
+
+    addEventListener(event, handler) {
+      if (!this.listeners.has(event)) {
+        this.listeners.set(event, []);
+      }
+      this.listeners.get(event).push(handler);
+    }
+
+    dispatchEvent(event) {
+      const list = this.listeners.get(event.type) || [];
+      for (const h of list) {
+        h.call(this, event);
+      }
+    }
+
+    querySelector(selector) {
+      const all = this.querySelectorAll(selector);
+      return all.length ? all[0] : null;
+    }
+
+    querySelectorAll(selector) {
+      const results = [];
+      const match = (el) => {
+        if (selector.startsWith('#') && el.id === selector.slice(1)) return true;
+        if (selector.startsWith('.') && el.classList.contains(selector.slice(1))) return true;
+        if (selector.toLowerCase() === el.tagName.toLowerCase()) return true;
+        return false;
+      };
+
+      const traverse = (node) => {
+        for (const child of node.children) {
+          if (match(child)) results.push(child);
+          traverse(child);
+        }
+      };
+      traverse(this);
+      return results;
+    }
+
+    focus() {}
+    select() {}
+  }
+
+  const elementsById = new Map();
+
+  function register(el, id) {
+    el.id = id;
+    elementsById.set(id, el);
+    return el;
+  }
+
+  const body = new MockElement('body');
+  const inputNuevaTarea = register(new MockElement('input'), 'nueva-tarea');
+  const lista = register(new MockElement('ul'), 'lista');
+  const contador = register(new MockElement('span'), 'contador');
+  const filtroTodas = register(new MockElement('a'), 'filtro-todas');
+  const filtroPendientes = register(new MockElement('a'), 'filtro-pendientes');
+  const filtroCompletadas = register(new MockElement('a'), 'filtro-completadas');
+
+  body.appendChild(inputNuevaTarea);
+  body.appendChild(lista);
+  body.appendChild(contador);
+  body.appendChild(filtroTodas);
+  body.appendChild(filtroPendientes);
+  body.appendChild(filtroCompletadas);
+
+  const windowListeners = new Map();
+
+  const window = {
+    location: { hash: '' },
+    localStorage,
+    addEventListener(event, handler) {
+      if (!windowListeners.has(event)) windowListeners.set(event, []);
+      windowListeners.get(event).push(handler);
+    },
+    dispatchEvent(event) {
+      const list = windowListeners.get(event.type) || [];
+      for (const h of list) {
+        h.call(window, event);
+      }
+    }
+  };
+
+  const document = {
+    body,
+    getElementById(id) {
+      return elementsById.get(id) || null;
+    },
+    createElement(tag) {
+      return new MockElement(tag);
+    },
+    addEventListener(event, handler) {
+      window.addEventListener(event, handler);
+    }
+  };
+
+  return { window, document, localStorage, elementsById, lista, contador, inputNuevaTarea };
+}
+
+function runScriptInMock(mock) {
+  const content = fs.readFileSync(htmlPath, 'utf8');
+  const scriptMatch = content.match(/<script>([\s\S]*?)<\/script>/i);
+  assert.ok(scriptMatch, 'index.html debe contener una etiqueta <script>');
+  const scriptCode = scriptMatch[1];
+
+  const context = vm.createContext({
+    window: mock.window,
+    document: mock.document,
+    localStorage: mock.localStorage,
+    console
+  });
+
+  vm.runInContext(scriptCode, context);
+}
+
+test('Todo SPA functional acceptance contract', () => {
+  const mock = createMockDOM();
+  runScriptInMock(mock);
+
+  const { inputNuevaTarea, lista, contador, elementsById, window } = mock;
+  const filtroTodas = elementsById.get('filtro-todas');
+  const filtroPendientes = elementsById.get('filtro-pendientes');
+  const filtroCompletadas = elementsById.get('filtro-completadas');
+
+  // 1. Inicialmente vacía
+  assert.strictEqual(lista.children.length, 0);
+  assert.ok(contador.textContent.includes('0'));
+
+  // 2. Añadir tareas con Enter en #nueva-tarea
+  inputNuevaTarea.value = 'Primera tarea';
+  inputNuevaTarea.dispatchEvent({ type: 'keydown', key: 'Enter' });
+
+  assert.strictEqual(lista.children.length, 1);
+  assert.strictEqual(inputNuevaTarea.value, '', 'El campo nueva tarea debe limpiarse');
+  assert.ok(contador.textContent.includes('1'), 'El contador debe mostrar 1 pendiente');
+
+  inputNuevaTarea.value = 'Segunda tarea';
+  inputNuevaTarea.dispatchEvent({ type: 'keydown', key: 'Enter' });
+  assert.strictEqual(lista.children.length, 2);
+  assert.ok(contador.textContent.includes('2'), 'El contador debe mostrar 2 pendientes');
+
+  // 3. Marcar tarea como completada con .completar
+  const primerLi = lista.children[0];
+  const checkbox = primerLi.querySelector('.completar');
+  assert.ok(checkbox, 'Cada li debe tener .completar');
+  checkbox.checked = true;
+  checkbox.dispatchEvent({ type: 'change' });
+
+  assert.ok(contador.textContent.includes('1'), 'El contador debe decrementar a 1 pendiente');
+  assert.strictEqual(lista.children[0].classList.contains('completada'), true);
+
+  // 4. Edición de tarea mediante doble clic en .titulo
+  const segundoLi = lista.children[1];
+  const titulo = segundoLi.querySelector('.titulo');
+  assert.ok(titulo, 'Cada li debe tener .titulo');
+  assert.strictEqual(titulo.textContent, 'Segunda tarea');
+
+  titulo.dispatchEvent({ type: 'dblclick' });
+  const edicion = segundoLi.querySelector('.edicion');
+  assert.ok(edicion, 'Al hacer doble clic debe aparecer .edicion dentro del li');
+  assert.strictEqual(edicion.value, 'Segunda tarea');
+
+  edicion.value = 'Segunda tarea modificada';
+  edicion.dispatchEvent({ type: 'keydown', key: 'Enter' });
+
+  assert.strictEqual(segundoLi.querySelector('.edicion'), null, '.edicion debe desaparecer tras confirmar');
+  assert.strictEqual(lista.children[1].querySelector('.titulo').textContent, 'Segunda tarea modificada');
+
+  // 5. Filtros: pendientes, completadas, todas
+  filtroPendientes.dispatchEvent({ type: 'click' });
+  assert.strictEqual(lista.children.length, 1, 'Filtro pendientes debe mostrar solo 1');
+  assert.strictEqual(lista.children[0].querySelector('.titulo').textContent, 'Segunda tarea modificada');
+
+  filtroCompletadas.dispatchEvent({ type: 'click' });
+  assert.strictEqual(lista.children.length, 1, 'Filtro completadas debe mostrar solo 1');
+  assert.strictEqual(lista.children[0].querySelector('.titulo').textContent, 'Primera tarea');
+
+  filtroTodas.dispatchEvent({ type: 'click' });
+  assert.strictEqual(lista.children.length, 2, 'Filtro todas debe mostrar ambas');
+
+  // 6. Borrar tarea con .borrar
+  const borrarBtn = lista.children[0].querySelector('.borrar');
+  assert.ok(borrarBtn, 'Cada li debe tener .borrar');
+  borrarBtn.dispatchEvent({ type: 'click' });
+
+  assert.strictEqual(lista.children.length, 1, 'Debe quedar 1 tarea');
+  assert.strictEqual(lista.children[0].querySelector('.titulo').textContent, 'Segunda tarea modificada');
+
+  // 7. Persistencia en localStorage
+  const guardado = mock.localStorage.getItem('todos');
+  assert.ok(guardado, 'Debe guardarse en localStorage');
+  const parsed = JSON.parse(guardado);
+  assert.strictEqual(parsed.length, 1);
+  assert.strictEqual(parsed[0].title, 'Segunda tarea modificada');
+
+  // Al recargar con nuevos datos desde localStorage
+  const nuevoMock = createMockDOM('', guardado);
+  runScriptInMock(nuevoMock);
+  assert.strictEqual(nuevoMock.lista.children.length, 1);
+  assert.strictEqual(nuevoMock.lista.children[0].querySelector('.titulo').textContent, 'Segunda tarea modificada');
+});
