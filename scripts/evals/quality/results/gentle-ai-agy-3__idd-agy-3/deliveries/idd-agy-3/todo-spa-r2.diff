+<!DOCTYPE html>
+<html lang="es">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Lista de Tareas</title>
+  <style>
+    :root {
+      --bg: #f5f6f8;
+      --card-bg: #ffffff;
+      --text: #2d3748;
+      --text-muted: #718096;
+      --text-completed: #a0aec0;
+      --border: #e2e8f0;
+      --primary: #3182ce;
+      --primary-hover: #2b6cb0;
+      --danger: #e53e3e;
+      --danger-hover: #c53030;
+      --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+      background-color: var(--bg);
+      color: var(--text);
+      line-height: 1.5;
+      padding: 2rem 1rem;
+      min-height: 100vh;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+    }
+
+    .contenedor {
+      width: 100%;
+      max-width: 560px;
+    }
+
+    h1 {
+      text-align: center;
+      font-size: 2.25rem;
+      font-weight: 700;
+      color: #1a202c;
+      margin-bottom: 1.5rem;
+    }
+
+    .tarjeta {
+      background: var(--card-bg);
+      border-radius: 10px;
+      box-shadow: var(--shadow);
+      border: 1px solid var(--border);
+      overflow: hidden;
+    }
+
+    .entrada-container {
+      padding: 1rem 1.25rem;
+      border-bottom: 1px solid var(--border);
+    }
+
+    #nueva-tarea {
+      width: 100%;
+      padding: 0.75rem 1rem;
+      font-size: 1.05rem;
+      border: 1px solid var(--border);
+      border-radius: 6px;
+      outline: none;
+      transition: border-color 0.2s, box-shadow 0.2s;
+    }
+
+    #nueva-tarea:focus {
+      border-color: var(--primary);
+      box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.2);
+    }
+
+    #lista {
+      list-style: none;
+      margin: 0;
+      padding: 0;
+    }
+
+    #lista li {
+      display: flex;
+      align-items: center;
+      padding: 0.85rem 1.25rem;
+      border-bottom: 1px solid var(--border);
+      gap: 0.85rem;
+      transition: background-color 0.15s;
+    }
+
+    #lista li:hover {
+      background-color: #fafafa;
+    }
+
+    #lista li:last-child {
+      border-bottom: none;
+    }
+
+    #lista li.completada .titulo {
+      text-decoration: line-through;
+      color: var(--text-completed);
+    }
+
+    .completar {
+      width: 1.25rem;
+      height: 1.25rem;
+      cursor: pointer;
+      accent-color: var(--primary);
+      flex-shrink: 0;
+    }
+
+    .titulo {
+      flex: 1;
+      font-size: 1rem;
+      word-break: break-word;
+      user-select: none;
+      cursor: pointer;
+    }
+
+    .edicion {
+      flex: 1;
+      font-size: 1rem;
+      padding: 0.4rem 0.6rem;
+      border: 1px solid var(--primary);
+      border-radius: 4px;
+      outline: none;
+      box-shadow: 0 0 0 2px rgba(49, 130, 206, 0.2);
+    }
+
+    .borrar {
+      background: transparent;
+      border: none;
+      color: var(--danger);
+      font-size: 1.35rem;
+      font-weight: bold;
+      line-height: 1;
+      cursor: pointer;
+      padding: 0.2rem 0.5rem;
+      border-radius: 4px;
+      opacity: 0.7;
+      transition: opacity 0.2s, background-color 0.2s;
+      flex-shrink: 0;
+    }
+
+    .borrar:hover,
+    .borrar:focus {
+      opacity: 1;
+      background-color: #fee2e2;
+    }
+
+    .pie {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      padding: 0.85rem 1.25rem;
+      background-color: #fafbfc;
+      border-top: 1px solid var(--border);
+      font-size: 0.875rem;
+      color: var(--text-muted);
+      flex-wrap: wrap;
+      gap: 0.75rem;
+    }
+
+    #contador {
+      font-weight: 500;
+    }
+
+    .filtros {
+      display: flex;
+      gap: 0.4rem;
+    }
+
+    .filtros a {
+      color: var(--text-muted);
+      text-decoration: none;
+      padding: 0.25rem 0.6rem;
+      border-radius: 4px;
+      border: 1px solid transparent;
+      transition: all 0.2s;
+      cursor: pointer;
+    }
+
+    .filtros a:hover {
+      color: var(--text);
+      border-color: var(--border);
+    }
+
+    .filtros a.activo {
+      color: var(--primary);
+      font-weight: 600;
+      border-color: var(--primary);
+      background-color: rgba(49, 130, 206, 0.08);
+    }
+
+    @media (max-width: 480px) {
+      .pie {
+        flex-direction: column;
+        align-items: center;
+      }
+    }
+  </style>
+</head>
+<body>
+  <div class="contenedor">
+    <h1>Lista de tareas</h1>
+    <div class="tarjeta">
+      <div class="entrada-container">
+        <input
+          type="text"
+          id="nueva-tarea"
+          placeholder="¿Qué hay que hacer?"
+          autocomplete="off"
+          autofocus
+        >
+      </div>
+
+      <ul id="lista"></ul>
+
+      <div class="pie">
+        <span id="contador">0 tareas pendientes</span>
+        <nav class="filtros">
+          <a href="#/todas" id="filtro-todas" class="activo">Todas</a>
+          <a href="#/pendientes" id="filtro-pendientes">Pendientes</a>
+          <a href="#/completadas" id="filtro-completadas">Completadas</a>
+        </nav>
+      </div>
+    </div>
+  </div>
+
+  <script>
+    (function () {
+      const STORAGE_KEY = 'todos';
+      let todos = loadTodos();
+      let currentFilter = 'todas';
+
+      const inputNuevaTarea = document.getElementById('nueva-tarea');
+      const listaEl = document.getElementById('lista');
+      const contadorEl = document.getElementById('contador');
+      const filtroTodas = document.getElementById('filtro-todas');
+      const filtroPendientes = document.getElementById('filtro-pendientes');
+      const filtroCompletadas = document.getElementById('filtro-completadas');
+
+      function loadTodos() {
+        try {
+          const raw = localStorage.getItem(STORAGE_KEY);
+          return raw ? JSON.parse(raw) : [];
+        } catch (e) {
+          return [];
+        }
+      }
+
+      function saveTodos() {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));
+        } catch (e) {
+          // Si el almacenamiento local no está disponible, continuar en memoria
+        }
+      }
+
+      function updateCounter() {
+        const pendientes = todos.filter(t => !t.completed).length;
+        contadorEl.textContent = `${pendientes} ${pendientes === 1 ? 'tarea pendiente' : 'tareas pendientes'}`;
+      }
+
+      function updateFilterUI() {
+        filtroTodas.classList.toggle('activo', currentFilter === 'todas');
+        filtroPendientes.classList.toggle('activo', currentFilter === 'pendientes');
+        filtroCompletadas.classList.toggle('activo', currentFilter === 'completadas');
+      }
+
+      function setFilter(filter) {
+        currentFilter = filter;
+        updateFilterUI();
+        render();
+      }
+
+      function handleHashChange() {
+        const hash = (window.location.hash || '').toLowerCase();
+        if (hash.includes('pendiente')) {
+          setFilter('pendientes');
+        } else if (hash.includes('completada')) {
+          setFilter('completadas');
+        } else {
+          setFilter('todas');
+        }
+      }
+
+      function startEditing(li, todo, tituloSpan, checkbox, borrarBtn) {
+        if (li.classList.contains('editando')) return;
+        li.classList.add('editando');
+
+        tituloSpan.style.display = 'none';
+        checkbox.style.display = 'none';
+        borrarBtn.style.display = 'none';
+
+        const inputEdicion = document.createElement('input');
+        inputEdicion.type = 'text';
+        inputEdicion.className = 'edicion';
+        inputEdicion.value = todo.title;
+
+        let finished = false;
+
+        function commit() {
+          if (finished) return;
+          finished = true;
+          const newTitle = inputEdicion.value.trim();
+          if (newTitle === '') {
+            todos = todos.filter(t => t.id !== todo.id);
+          } else {
+            todo.title = newTitle;
+            tituloSpan.textContent = newTitle;
+          }
+          if (inputEdicion.parentNode) {
+            inputEdicion.parentNode.removeChild(inputEdicion);
+          }
+          li.classList.remove('editando');
+          tituloSpan.style.display = '';
+          checkbox.style.display = '';
+          borrarBtn.style.display = '';
+          saveTodos();
+          render();
+        }
+
+        function cancel() {
+          if (finished) return;
+          finished = true;
+          if (inputEdicion.parentNode) {
+            inputEdicion.parentNode.removeChild(inputEdicion);
+          }
+          li.classList.remove('editando');
+          tituloSpan.style.display = '';
+          checkbox.style.display = '';
+          borrarBtn.style.display = '';
+          render();
+        }
+
+        inputEdicion.addEventListener('keydown', (e) => {
+          if (e.key === 'Enter') {
+            commit();
+          } else if (e.key === 'Escape') {
+            cancel();
+          }
+        });
+
+        inputEdicion.addEventListener('blur', () => {
+          commit();
+        });
+
+        li.appendChild(inputEdicion);
+        inputEdicion.focus();
+        inputEdicion.select();
+      }
+
+      function renderTodoItem(todo) {
+        const li = document.createElement('li');
+        li.dataset.id = todo.id;
+        if (todo.completed) {
+          li.classList.add('completada');
+        }
+
+        const checkbox = document.createElement('input');
+        checkbox.type = 'checkbox';
+        checkbox.className = 'completar';
+        checkbox.checked = !!todo.completed;
+        checkbox.setAttribute('aria-label', 'Marcar tarea como completada');
+        checkbox.addEventListener('change', () => {
+          todo.completed = checkbox.checked;
+          saveTodos();
+          render();
+        });
+
+        const tituloSpan = document.createElement('span');
+        tituloSpan.className = 'titulo';
+        tituloSpan.textContent = todo.title;
+
+        const borrarBtn = document.createElement('button');
+        borrarBtn.type = 'button';
+        borrarBtn.className = 'borrar';
+        borrarBtn.textContent = '×';
+        borrarBtn.setAttribute('aria-label', 'Borrar tarea');
+        borrarBtn.addEventListener('click', () => {
+          todos = todos.filter(t => t.id !== todo.id);
+          saveTodos();
+          render();
+        });
+
+        tituloSpan.addEventListener('dblclick', () => {
+          startEditing(li, todo, tituloSpan, checkbox, borrarBtn);
+        });
+
+        li.appendChild(checkbox);
+        li.appendChild(tituloSpan);
+        li.appendChild(borrarBtn);
+
+        return li;
+      }
+
+      function render() {
+        listaEl.innerHTML = '';
+
+        const visibleTodos = todos.filter(todo => {
+          if (currentFilter === 'pendientes') return !todo.completed;
+          if (currentFilter === 'completadas') return !!todo.completed;
+          return true;
+        });
+
+        visibleTodos.forEach(todo => {
+          listaEl.appendChild(renderTodoItem(todo));
+        });
+
+        updateCounter();
+      }
+
+      inputNuevaTarea.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter') {
+          const text = inputNuevaTarea.value.trim();
+          if (text) {
+            todos.push({
+              id: Date.now().toString() + '-' + Math.random().toString(36).slice(2, 8),
+              title: text,
+              completed: false
+            });
+            inputNuevaTarea.value = '';
+            saveTodos();
+            render();
+          }
+        }
+      });
+
+      filtroTodas.addEventListener('click', (e) => {
+        setFilter('todas');
+      });
+
+      filtroPendientes.addEventListener('click', (e) => {
+        setFilter('pendientes');
+      });
+
+      filtroCompletadas.addEventListener('click', (e) => {
+        setFilter('completadas');
+      });
+
+      window.addEventListener('hashchange', handleHashChange);
+
+      // Sincronizar estado inicial
+      handleHashChange();
+    })();
+  </script>
+</body>
+</html>
diff --git a/test/index.test.js b/test/index.test.js
