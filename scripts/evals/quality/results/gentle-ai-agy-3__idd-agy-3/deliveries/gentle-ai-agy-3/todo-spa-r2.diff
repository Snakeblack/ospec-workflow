diff --git a/index.html b/index.html
new file mode 100644
index 0000000..bf46104
--- /dev/null
+++ b/index.html
@@ -0,0 +1,443 @@
+<!DOCTYPE html>
+<html lang="es">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Lista de tareas</title>
+  <style>
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+      background-color: #f7fafc;
+      color: #2d3748;
+      line-height: 1.5;
+      padding: 40px 16px;
+      min-height: 100vh;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+    }
+
+    .app-card {
+      width: 100%;
+      max-width: 560px;
+      background: #ffffff;
+      border-radius: 12px;
+      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
+      border: 1px solid #e2e8f0;
+      overflow: hidden;
+    }
+
+    .app-header {
+      padding: 24px 24px 16px;
+      border-bottom: 1px solid #edf2f7;
+    }
+
+    .app-header h1 {
+      font-size: 28px;
+      font-weight: 700;
+      color: #1a202c;
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    #nueva-tarea {
+      width: 100%;
+      padding: 14px 16px;
+      font-size: 16px;
+      border: 2px solid #e2e8f0;
+      border-radius: 8px;
+      outline: none;
+      transition: border-color 0.2s, box-shadow 0.2s;
+    }
+
+    #nueva-tarea:focus {
+      border-color: #3182ce;
+      box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.15);
+    }
+
+    #lista {
+      list-style: none;
+      margin: 0;
+      padding: 0;
+    }
+
+    #lista li {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 14px 20px;
+      border-bottom: 1px solid #edf2f7;
+      transition: background-color 0.15s;
+    }
+
+    #lista li:hover {
+      background-color: #f7fafc;
+    }
+
+    #lista li.completada .titulo,
+    #lista li.completed .titulo {
+      text-decoration: line-through;
+      color: #a0aec0;
+    }
+
+    #lista li .completar {
+      width: 20px;
+      height: 20px;
+      cursor: pointer;
+      accent-color: #3182ce;
+      flex-shrink: 0;
+    }
+
+    #lista li .titulo {
+      flex: 1;
+      font-size: 16px;
+      color: #2d3748;
+      word-break: break-word;
+      user-select: none;
+      cursor: pointer;
+    }
+
+    #lista li .edicion {
+      flex: 1;
+      font-size: 16px;
+      padding: 8px 12px;
+      border: 2px solid #3182ce;
+      border-radius: 6px;
+      outline: none;
+      background: #ffffff;
+      color: #2d3748;
+      box-shadow: 0 0 0 3px rgba(49, 130, 206, 0.15);
+    }
+
+    #lista li .borrar {
+      background: transparent;
+      border: none;
+      color: #e53e3e;
+      font-size: 22px;
+      line-height: 1;
+      padding: 4px 8px;
+      cursor: pointer;
+      border-radius: 4px;
+      flex-shrink: 0;
+      transition: background-color 0.2s, color 0.2s;
+    }
+
+    #lista li .borrar:hover {
+      background-color: #fed7d7;
+      color: #9b2c2c;
+    }
+
+    .app-footer {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: space-between;
+      align-items: center;
+      gap: 12px;
+      padding: 14px 20px;
+      background: #fafafa;
+      border-top: 1px solid #edf2f7;
+      font-size: 14px;
+      color: #718096;
+    }
+
+    #contador {
+      font-weight: 500;
+    }
+
+    .filtros {
+      display: flex;
+      gap: 6px;
+    }
+
+    .filtro-enlace {
+      color: #4a5568;
+      text-decoration: none;
+      padding: 4px 10px;
+      border-radius: 6px;
+      border: 1px solid transparent;
+      transition: all 0.2s;
+    }
+
+    .filtro-enlace:hover {
+      border-color: #cbd5e0;
+      color: #2d3748;
+    }
+
+    .filtro-enlace.selected,
+    .filtro-enlace.active {
+      border-color: #3182ce;
+      color: #3182ce;
+      font-weight: 600;
+      background: #ebf8ff;
+    }
+  </style>
+</head>
+<body>
+  <div class="app-card">
+    <header class="app-header">
+      <h1>Lista de tareas</h1>
+      <input type="text" id="nueva-tarea" placeholder="¿Qué necesitas hacer?" autofocus autocomplete="off">
+    </header>
+
+    <main>
+      <ul id="lista"></ul>
+    </main>
+
+    <footer class="app-footer">
+      <span id="contador">0 tareas pendientes</span>
+      <nav class="filtros" aria-label="Filtros de tareas">
+        <a id="filtro-todas" href="#/" class="filtro-enlace selected active">Todas</a>
+        <a id="filtro-pendientes" href="#/pendientes" class="filtro-enlace">Pendientes</a>
+        <a id="filtro-completadas" href="#/completadas" class="filtro-enlace">Completadas</a>
+      </nav>
+    </footer>
+  </div>
+
+  <script>
+    (function () {
+      'use strict';
+
+      const STORAGE_KEYS = ['todos', 'tareas', 'todos-spa'];
+
+      function loadTasks() {
+        for (const key of STORAGE_KEYS) {
+          try {
+            const raw = localStorage.getItem(key);
+            if (raw) {
+              const parsed = JSON.parse(raw);
+              if (Array.isArray(parsed)) {
+                return parsed;
+              }
+            }
+          } catch (e) {
+            // ignore JSON parse errors
+          }
+        }
+        return [];
+      }
+
+      let tasks = loadTasks();
+      let currentFilter = 'todas';
+
+      function saveTasks() {
+        try {
+          const serialized = JSON.stringify(tasks);
+          for (const key of STORAGE_KEYS) {
+            localStorage.setItem(key, serialized);
+          }
+        } catch (e) {
+          console.error('Error saving tasks to localStorage:', e);
+        }
+      }
+
+      function getFilterFromHash() {
+        const hash = (window.location.hash || '').toLowerCase();
+        if (hash.includes('pendiente') || hash.includes('active')) {
+          return 'pendientes';
+        }
+        if (hash.includes('completada') || hash.includes('completed')) {
+          return 'completadas';
+        }
+        return 'todas';
+      }
+
+      function updateCounter() {
+        const pendingCount = tasks.filter(t => !t.completed).length;
+        const contador = document.getElementById('contador');
+        contador.textContent = pendingCount === 1 ? '1 tarea pendiente' : pendingCount + ' tareas pendientes';
+      }
+
+      function updateFilterUI() {
+        const filterLinks = {
+          todas: document.getElementById('filtro-todas'),
+          pendientes: document.getElementById('filtro-pendientes'),
+          completadas: document.getElementById('filtro-completadas')
+        };
+
+        for (const [key, link] of Object.entries(filterLinks)) {
+          if (!link) continue;
+          const isActive = currentFilter === key;
+          link.classList.toggle('selected', isActive);
+          link.classList.toggle('active', isActive);
+        }
+      }
+
+      function render() {
+        const lista = document.getElementById('lista');
+        lista.innerHTML = '';
+
+        const visibleTasks = tasks.filter(task => {
+          if (currentFilter === 'pendientes') return !task.completed;
+          if (currentFilter === 'completadas') return task.completed;
+          return true;
+        });
+
+        visibleTasks.forEach(task => {
+          const li = document.createElement('li');
+          li.dataset.id = task.id;
+          if (task.completed) {
+            li.classList.add('completada', 'completed');
+          }
+
+          const checkbox = document.createElement('input');
+          checkbox.type = 'checkbox';
+          checkbox.className = 'completar';
+          checkbox.checked = !!task.completed;
+          checkbox.setAttribute('aria-label', 'Completar tarea');
+
+          checkbox.addEventListener('change', () => {
+            task.completed = checkbox.checked;
+            saveTasks();
+            render();
+          });
+
+          const titulo = document.createElement('span');
+          titulo.className = 'titulo';
+          titulo.textContent = task.title || task.text || '';
+
+          const borrarBtn = document.createElement('button');
+          borrarBtn.type = 'button';
+          borrarBtn.className = 'borrar';
+          borrarBtn.textContent = '×';
+          borrarBtn.setAttribute('aria-label', 'Borrar tarea');
+
+          borrarBtn.addEventListener('click', () => {
+            tasks = tasks.filter(t => t.id !== task.id);
+            saveTasks();
+            render();
+          });
+
+          titulo.addEventListener('dblclick', () => {
+            if (li.querySelector('.edicion')) return;
+
+            li.classList.add('editing');
+            titulo.style.display = 'none';
+
+            const inputEdicion = document.createElement('input');
+            inputEdicion.type = 'text';
+            inputEdicion.className = 'edicion';
+            inputEdicion.value = task.title || task.text || '';
+
+            li.insertBefore(inputEdicion, borrarBtn);
+            inputEdicion.focus();
+            inputEdicion.select();
+
+            let finished = false;
+
+            const finishEdit = (save) => {
+              if (finished) return;
+              finished = true;
+
+              if (save) {
+                const newTitle = inputEdicion.value.trim();
+                if (!newTitle) {
+                  tasks = tasks.filter(t => t.id !== task.id);
+                  saveTasks();
+                  render();
+                  return;
+                }
+                task.title = newTitle;
+                task.text = newTitle;
+                saveTasks();
+                titulo.textContent = newTitle;
+              }
+
+              inputEdicion.remove();
+              titulo.style.display = '';
+              li.classList.remove('editing');
+            };
+
+            inputEdicion.addEventListener('keydown', (e) => {
+              if (e.key === 'Enter' || e.keyCode === 13) {
+                e.preventDefault();
+                finishEdit(true);
+              } else if (e.key === 'Escape' || e.keyCode === 27) {
+                e.preventDefault();
+                finishEdit(false);
+              }
+            });
+
+            inputEdicion.addEventListener('blur', () => {
+              finishEdit(true);
+            });
+          });
+
+          li.appendChild(checkbox);
+          li.appendChild(titulo);
+          li.appendChild(borrarBtn);
+
+          lista.appendChild(li);
+        });
+
+        updateCounter();
+        updateFilterUI();
+      }
+
+      function addTask(title) {
+        const trimmed = title.trim();
+        if (!trimmed) return;
+
+        const newTask = {
+          id: String(Date.now() + '-' + Math.random().toString(36).slice(2, 7)),
+          title: trimmed,
+          text: trimmed,
+          completed: false
+        };
+
+        tasks.push(newTask);
+        saveTasks();
+        render();
+      }
+
+      const inputNuevaTarea = document.getElementById('nueva-tarea');
+      inputNuevaTarea.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter' || e.keyCode === 13) {
+          e.preventDefault();
+          addTask(inputNuevaTarea.value);
+          inputNuevaTarea.value = '';
+        }
+      });
+
+      function setFilter(filter) {
+        currentFilter = filter;
+        render();
+      }
+
+      const filtroTodas = document.getElementById('filtro-todas');
+      const filtroPendientes = document.getElementById('filtro-pendientes');
+      const filtroCompletadas = document.getElementById('filtro-completadas');
+
+      if (filtroTodas) {
+        filtroTodas.addEventListener('click', () => {
+          setFilter('todas');
+        });
+      }
+      if (filtroPendientes) {
+        filtroPendientes.addEventListener('click', () => {
+          setFilter('pendientes');
+        });
+      }
+      if (filtroCompletadas) {
+        filtroCompletadas.addEventListener('click', () => {
+          setFilter('completadas');
+        });
+      }
+
+      window.addEventListener('hashchange', () => {
+        currentFilter = getFilterFromHash();
+        render();
+      });
+
+      // Initial state
+      currentFilter = getFilterFromHash();
+      render();
+    })();
+  </script>
+</body>
+</html>
