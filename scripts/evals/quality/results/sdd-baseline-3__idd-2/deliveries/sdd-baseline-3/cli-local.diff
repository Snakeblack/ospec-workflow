 const { storePath, load, save } = require("./store.js");
 
-const USAGE = "uso: tasks add <título> | tasks list | tasks done <id>";
+const USAGE = "uso: tasks add <título> [--priority <alta|media|baja>] | tasks list | tasks done <id>";
+
+const PRIORITY_RANK = { alta: 0, media: 1, baja: 2 };
+const DEFAULT_PRIORITY = "media";
+
+// Case-sensitive: only the literal lowercase values are accepted.
+function isValidPriority(value) {
+  return Object.prototype.hasOwnProperty.call(PRIORITY_RANK, value);
+}
+
+// Sort key: higher priority first (alta < media < baja by rank), ties by id ascending.
+// Legacy tasks without a priority field are read as "media".
+function prioritySortKey(task) {
+  return [PRIORITY_RANK[task.priority || DEFAULT_PRIORITY], task.id];
+}
 
 // Exit codes: 0 ok, 1 the task does not exist, 2 usage error.
 function run(argv, { stdout = process.stdout, stderr = process.stderr, env = process.env } = {}) {
@@ -10,13 +24,27 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
   const file = storePath(env);
 
   if (command === "add") {
