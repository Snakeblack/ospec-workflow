+    // --priority is only accepted as the final "--priority <value>" pair.
+    let args = rest;
+    let priority = DEFAULT_PRIORITY;
+    if (rest.includes("--priority")) {
+      const at = rest.length - 2;
+      if (at < 0 || rest[at] !== "--priority" || !isValidPriority(rest[at + 1])
+        || rest.indexOf("--priority") !== at) {
+        stderr.write(`${USAGE}
+`);
+        return 2;
+      }
+      priority = rest[at + 1];
+      args = rest.slice(0, at);
+    }
+    const title = args.join(" ").trim();
     if (!title) {
       stderr.write(`${USAGE}\n`);
       return 2;
     }
     const data = load(file);
-    const task = { id: data.nextId, title, done: false };
+    const task = { id: data.nextId, title, done: false, priority };
     data.nextId += 1;
     data.tasks.push(task);
     save(file, data);
@@ -26,7 +54,12 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
 
   if (command === "list") {
     const data = load(file);
-    for (const task of data.tasks) {
+    const sorted = [...data.tasks].sort((a, b) => {
+      const [pa, ia] = prioritySortKey(a);
+      const [pb, ib] = prioritySortKey(b);
