diff --git a/test/cli.js b/test/cli.js
index 0ddacaa..66e59ad 100644
--- a/test/cli.js
+++ b/test/cli.js
@@ -43,3 +43,78 @@ test("unknown task and usage errors", () => {
   assert.equal(tasks("add").status, 2);
   assert.equal(tasks("borrar").status, 2);
 });
+
+const { USAGE } = require("../src/cli.js");
+
+function storeOf(tasks) {
+  return tasks("list").out;
+}
+
+test("add --priority orders list by priority then id", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "A", "--priority", "baja").status, 0);
+  assert.equal(tasks("add", "B", "--priority", "alta").status, 0);
+  assert.equal(tasks("add", "C").status, 0);
+  assert.equal(tasks("list").out, "[ ] 2 B\n[ ] 3 C\n[ ] 1 A\n");
+});
+
+test("add with --priority alta succeeds and stores the priority", () => {
+  const file = path.join(fs.mkdtempSync(path.join(os.tmpdir(), "tasks-")), "tasks.json");
+  const res = run(["add", "X", "--priority", "alta"], {
+    env: { TASKS_FILE: file },
+    stdout: { write: () => {} },
+    stderr: { write: () => {} },
+  });
+  assert.equal(res, 0);
+  assert.equal(JSON.parse(fs.readFileSync(file, "utf8")).tasks[0].priority, "alta");
+});
+
+test("add without flag defaults priority to media", () => {
+  const file = path.join(fs.mkdtempSync(path.join(os.tmpdir(), "tasks-")), "tasks.json");
+  const res = run(["add", "X"], {
+    env: { TASKS_FILE: file },
+    stdout: { write: () => {} },
+    stderr: { write: () => {} },
+  });
+  assert.equal(res, 0);
+  assert.equal(JSON.parse(fs.readFileSync(file, "utf8")).tasks[0].priority, "media");
+});
+
+for (const [name, args] of [
+  ["missing value", ["add", "--priority"]],
+  ["missing value after title", ["add", "X", "--priority"]],
+  ["invalid value", ["add", "X", "--priority", "foobar"]],
+  ["case-sensitive value", ["add", "X", "--priority", "ALTA"]],
+  ["flag not final", ["add", "--priority", "alta", "X"]],
+  ["empty title", ["add", "--priority", "alta"]],
+]) {
+  test(`add usage error: ${name} -> exit 2, store untouched`, () => {
+    const tasks = session();
+    const res = tasks(...args);
+    assert.equal(res.status, 2);
+    assert.equal(res.err, `${USAGE}\n`);
+    assert.equal(res.out, "");
+    assert.equal(storeOf(tasks), "");
+  });
+}
+
+test("legacy tasks without priority list as media", () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "tasks-"));
+  const file = path.join(dir, "tasks.json");
+  fs.writeFileSync(file, JSON.stringify({
+    nextId: 3,
+    tasks: [{ id: 1, title: "vieja", done: false }, { id: 2, title: "baja", done: false, priority: "baja" }],
+  }));
+  let out = "";
+  run(["add", "alta", "--priority", "alta"], { env: { TASKS_FILE: file }, stdout: { write: () => {} }, stderr: { write: () => {} } });
+  run(["list"], { env: { TASKS_FILE: file }, stdout: { write: (t) => { out += t; } }, stderr: { write: () => {} } });
+  assert.equal(out, "[ ] 3 alta\n[ ] 1 vieja\n[ ] 2 baja\n");
+});
+
+test("same priority ties are ordered by id ascending", () => {
+  const tasks = session();
+  tasks("add", "uno", "--priority", "alta");
+  tasks("add", "dos", "--priority", "alta");
+  tasks("add", "tres", "--priority", "alta");
+  assert.equal(tasks("list").out, "[ ] 1 uno\n[ ] 2 dos\n[ ] 3 tres\n");
+});
