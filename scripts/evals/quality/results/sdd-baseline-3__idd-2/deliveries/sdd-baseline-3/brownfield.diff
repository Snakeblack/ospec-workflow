--- /dev/null
+++ b/test/invoice.test.js
@@ -0,0 +1,148 @@
+var test = require('node:test');
+var assert = require('node:assert');
+var calcInvoice = require('../src/invoice').calcInvoice;
+
+// Characterization (REQ-004): expected values captured from the pre-change implementation.
+test('sin codigo: IVA normal', function () {
+  assert.deepStrictEqual(calcInvoice({ items: [{ sku: 'A', price: 100, qty: 1 }] }), {
+    lineas: [{ sku: 'A', importe: 100, iva: 21 }], subtotal: 100, iva: 21, envio: 0, total: 121
+  });
+});
+
+test('sin codigo: IVA reducido', function () {
+  assert.deepStrictEqual(calcInvoice({ items: [{ sku: 'A', price: 100, qty: 1, reducedVat: true }] }), {
+    lineas: [{ sku: 'A', importe: 100, iva: 10 }], subtotal: 100, iva: 10, envio: 0, total: 110
+  });
+});
+
+test('sin codigo: umbral exacto (subtotal 50)', function () {
+  assert.deepStrictEqual(calcInvoice({ items: [{ sku: 'A', price: 50, qty: 1 }] }), {
+    lineas: [{ sku: 'A', importe: 50, iva: 10.5 }], subtotal: 50, iva: 10.5, envio: 0, total: 60.5
+  });
+});
+
+test('sin codigo: bajo umbral cobra envio', function () {
+  assert.deepStrictEqual(calcInvoice({ items: [{ sku: 'A', price: 20, qty: 1 }] }), {
+    lineas: [{ sku: 'A', importe: 20, iva: 4.2 }], subtotal: 20, iva: 4.2, envio: 4.95, total: 29.15
+  });
+});
+
+test('sin codigo: pickup', function () {
+  assert.deepStrictEqual(calcInvoice({ items: [{ sku: 'A', price: 20, qty: 1 }], pickup: true }), {
+    lineas: [{ sku: 'A', importe: 20, iva: 4.2 }], subtotal: 20, iva: 4.2, envio: 0, total: 24.2
+  });
+});
+
+test('sin codigo: multi-linea mixta con redondeo por linea', function () {
+  var r = calcInvoice({ items: [
+    { sku: 'A', price: 0.33, qty: 3 },
+    { sku: 'B', price: 1.15, qty: 1, reducedVat: true },
+    { sku: 'C', price: 2.49, qty: 1 },
+    { sku: 'D', price: 0.07, qty: 5, reducedVat: true }
+  ] });
+  assert.deepStrictEqual(r, {
+    lineas: [
+      { sku: 'A', importe: 0.99, iva: 0.21 },
+      { sku: 'B', importe: 1.15, iva: 0.12 },
+      { sku: 'C', importe: 2.49, iva: 0.52 },
+      { sku: 'D', importe: 0.35, iva: 0.03 }
+    ], subtotal: 4.98, iva: 0.88, envio: 4.95, total: 10.81
+  });
+});
+
+test('sin codigo: IVA por linea difiere del IVA sobre la suma (0.18 vs 0.19)', function () {
+  var r = calcInvoice({ items: [
+    { sku: 'A', price: 0.3, qty: 1 }, { sku: 'B', price: 0.3, qty: 1 }, { sku: 'C', price: 0.3, qty: 1 }
+  ] });
+  assert.deepStrictEqual(r, {
+    lineas: [
+      { sku: 'A', importe: 0.3, iva: 0.06 },
+      { sku: 'B', importe: 0.3, iva: 0.06 },
+      { sku: 'C', importe: 0.3, iva: 0.06 }
+    ], subtotal: 0.9, iva: 0.18, envio: 4.95, total: 6.03
+  });
+  assert.strictEqual(Object.prototype.hasOwnProperty.call(r, 'descuento'), false);
+});
+
+// Discount path (REQ-001/002/003). Expected values hand-computed from design formulas.
+function hasDescuento(r) { return Object.prototype.hasOwnProperty.call(r, 'descuento'); }
+
+test('codigo: IVA normal (100 VERANO10)', function () {
+  var r = calcInvoice({ items: [{ sku: 'A', price: 100, qty: 1 }], discountCode: 'VERANO10' });
+  assert.deepStrictEqual(r, {
+    lineas: [{ sku: 'A', importe: 100, iva: 21 }],
+    subtotal: 100, descuento: 10, iva: 18.9, envio: 0, total: 108.9
+  });
+});
+
+test('codigo: IVA reducido (100 BIENVENIDA5)', function () {
+  var r = calcInvoice({ items: [{ sku: 'A', price: 100, qty: 1, reducedVat: true }], discountCode: 'BIENVENIDA5' });
+  assert.deepStrictEqual(r, {
+    lineas: [{ sku: 'A', importe: 100, iva: 10 }],
+    subtotal: 100, descuento: 5, iva: 9.5, envio: 0, total: 104.5
+  });
+});
+
+test('codigo: IVA mixto (33.33 normal + 16.67 reducido, VERANO10)', function () {
+  var r = calcInvoice({ items: [
+    { sku: 'A', price: 33.33, qty: 1 },
+    { sku: 'B', price: 16.67, qty: 1, reducedVat: true }
+  ], discountCode: 'VERANO10' });
+  assert.strictEqual(r.subtotal, 50);
+  assert.strictEqual(r.descuento, 5);
+  assert.strictEqual(r.iva, 7.8);
+  assert.strictEqual(r.envio, 4.95);
+  assert.strictEqual(r.total, 57.75);
+  // lineas pre-descuento
+  assert.deepStrictEqual(r.lineas, [
+    { sku: 'A', importe: 33.33, iva: 7 },
+    { sku: 'B', importe: 16.67, iva: 1.67 }
+  ]);
+});
+
+test('codigo: descuento baja bajo el umbral y se cobra envio (52 VERANO10)', function () {
+  var r = calcInvoice({ items: [{ sku: 'A', price: 52, qty: 1 }], discountCode: 'VERANO10' });
+  assert.strictEqual(r.subtotal, 52);
+  assert.strictEqual(r.descuento, 5.2);
+  assert.strictEqual(r.iva, 9.83);
+  assert.strictEqual(r.envio, 4.95);
+  assert.strictEqual(r.total, 61.58);
+});
+
+test('codigo: pickup fuerza envio 0 (20 VERANO10)', function () {
+  var r = calcInvoice({ items: [{ sku: 'A', price: 20, qty: 1 }], pickup: true, discountCode: 'VERANO10' });
+  assert.strictEqual(r.descuento, 2);
+  assert.strictEqual(r.iva, 3.78);
+  assert.strictEqual(r.envio, 0);
+  assert.strictEqual(r.total, 21.78);
+});
+
+test('codigo en minusculas aplica el descuento', function () {
+  var r = calcInvoice({ items: [{ sku: 'A', price: 100, qty: 1 }], discountCode: 'verano10' });
+  assert.strictEqual(r.descuento, 10);
+  assert.strictEqual(r.total, 108.9);
+});
+
+test('codigo invalido lanza Error y no devuelve factura', function () {
+  ['NOPE', '', 'toString'].forEach(function (c) {
+    assert.throws(function () {
+      calcInvoice({ items: [{ sku: 'A', price: 100, qty: 1 }], discountCode: c });
+    }, /Codigo de descuento desconocido/);
+  });
+});
+
+test('discountCode null/undefined equivale a sin codigo (sin clave descuento)', function () {
+  var base = calcInvoice({ items: [{ sku: 'A', price: 100, qty: 1 }] });
+  var n = calcInvoice({ items: [{ sku: 'A', price: 100, qty: 1 }], discountCode: null });
+  var u = calcInvoice({ items: [{ sku: 'A', price: 100, qty: 1 }], discountCode: undefined });
+  assert.deepStrictEqual(n, base);
+  assert.deepStrictEqual(u, base);
+  assert.strictEqual(hasDescuento(n), false);
+});
+
+test('invariante: total = subtotal - descuento + iva + envio', function () {
+  var r = calcInvoice({ items: [
+    { sku: 'A', price: 33.33, qty: 1 }, { sku: 'B', price: 16.67, qty: 1, reducedVat: true }
+  ], discountCode: 'VERANO10' });
+  assert.strictEqual(Math.round((r.subtotal - r.descuento + r.iva + r.envio) * 100) / 100, r.total);
+});
