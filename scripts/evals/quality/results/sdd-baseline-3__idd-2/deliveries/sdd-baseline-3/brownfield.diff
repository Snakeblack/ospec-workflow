--- a/src/discounts.js
+++ b/src/discounts.js
@@ -4,4 +4,16 @@ var CODIGOS = {
   BIENVENIDA5: 5
 };
 
-module.exports = { CODIGOS: CODIGOS };
+// Helper exportado para REQ-001 code resolution (REQ-invoice-discount-codes-001).
+// null/undefined => sin codigo (null); no string o codigo desconocido => Error.
+function porcentajeDescuento(codigo) {
+  if (codigo == null) return null;
+  if (typeof codigo !== 'string') throw new Error('Codigo debe ser string');
+  var key = codigo.toUpperCase();
+  if (!Object.prototype.hasOwnProperty.call(CODIGOS, key)) {
+    throw new Error('Codigo de descuento desconocido: ' + codigo);
+  }
+  return CODIGOS[key];
+}
+
+module.exports = { CODIGOS: CODIGOS, porcentajeDescuento: porcentajeDescuento };
diff --git a/src/invoice.js b/src/invoice.js
index 9b01eaa..d47d0c4 100644
--- a/src/invoice.js
+++ b/src/invoice.js
@@ -1,6 +1,8 @@
 // Facturacion v1 (2014). No tocar sin hablar con contabilidad.
 // TODO: tests
 
+var porcentajeDescuento = require('./discounts').porcentajeDescuento;
+
 var IVA = 0.21;
 var IVA_REDUCIDO = 0.10;
 var ENVIO = 4.95;
@@ -9,18 +11,41 @@ var UMBRAL_ENVIO_GRATIS = 50;
 function r2(n) { return Math.round(n * 100) / 100; }
 
 function calcInvoice(order) {
+  // REQ-invoice-discount-codes-001: resolver el codigo antes de cualquier calculo (puede lanzar Error: no hay factura)
+  var pct = porcentajeDescuento(order.discountCode);
   var lineas = [];
   var subtotal = 0;
   var iva = 0;
+  var baseN = 0;
+  var baseR = 0;
   for (var i = 0; i < order.items.length; i++) {
     var it = order.items[i];
     var importe = r2(it.price * it.qty);
     var ivaLinea = r2(importe * (it.reducedVat ? IVA_REDUCIDO : IVA));
     subtotal = subtotal + importe;
     iva = iva + ivaLinea;
+    if (it.reducedVat) baseR = baseR + importe; else baseN = baseN + importe;
     lineas.push({ sku: it.sku, importe: importe, iva: ivaLinea });
   }
   subtotal = r2(subtotal);
+  if (pct !== null) {
+    // REQ-invoice-discount-codes-002 discount pre-VAT; D1 allocation per VAT-rate group (residuo de redondeo al grupo normal)
+    baseN = r2(baseN);
+    baseR = r2(baseR);
+    var descuento = r2(subtotal * pct / 100);
+    var descR = r2(baseR * pct / 100);
+    var descN = r2(descuento - descR);
+    var netN = r2(baseN - descN);
+    var netR = r2(baseR - descR);
+    var ivaDesc = r2(r2(netN * IVA) + r2(netR * IVA_REDUCIDO));
+    // REQ-invoice-discount-codes-003 baseDesc = subtotal - descuento para umbral 50; envio nunca se descuenta ni lleva IVA
+    var baseDesc = r2(subtotal - descuento);
+    var envioDesc = baseDesc >= UMBRAL_ENVIO_GRATIS ? 0 : ENVIO;
+    if (order.pickup) envioDesc = 0;
+    var totalDesc = r2(subtotal - descuento + ivaDesc + envioDesc);
+    return { lineas: lineas, subtotal: subtotal, descuento: descuento, iva: ivaDesc, envio: envioDesc, total: totalDesc };
+  }
+  // REQ-invoice-discount-codes-004 camino sin codigo: sentencias historicas sin cambios
   iva = r2(iva);
   var envio = subtotal >= UMBRAL_ENVIO_GRATIS ? 0 : ENVIO;
   if (order.pickup) envio = 0;
diff --git a/test/discounts.test.js b/test/discounts.test.js
new file mode 100644
index 0000000..56a389d
--- /dev/null
+++ b/test/discounts.test.js
@@ -0,0 +1,31 @@
+var test = require('node:test');
+var assert = require('node:assert');
+var porcentajeDescuento = require('../src/discounts').porcentajeDescuento;
+
+test('null y undefined significan sin codigo', function () {
+  assert.strictEqual(porcentajeDescuento(null), null);
+  assert.strictEqual(porcentajeDescuento(undefined), null);
+});
+
+test('codigo conocido devuelve su porcentaje', function () {
+  assert.strictEqual(porcentajeDescuento('VERANO10'), 10);
+  assert.strictEqual(porcentajeDescuento('BIENVENIDA5'), 5);
+});
+
+test('codigo en minusculas se normaliza', function () {
+  assert.strictEqual(porcentajeDescuento('verano10'), 10);
+});
+
+test('codigos invalidos lanzan Error', function () {
+  var invalidos = ['', 'toString', '__proto__', 'constructor', 'hasOwnProperty', 'NOPE'];
+  invalidos.forEach(function (c) {
+    assert.throws(function () { porcentajeDescuento(c); }, Error, 'debia lanzar: ' + JSON.stringify(c));
+  });
+  assert.throws(function () { porcentajeDescuento('NOPE'); }, /Codigo de descuento desconocido: NOPE/);
+});
+
+test('valores no string lanzan Error sin coercion', function () {
+  [10, true, {}, []].forEach(function (c) {
+    assert.throws(function () { porcentajeDescuento(c); }, Error);
+  });
+});
diff --git a/test/invoice.test.js b/test/invoice.test.js
