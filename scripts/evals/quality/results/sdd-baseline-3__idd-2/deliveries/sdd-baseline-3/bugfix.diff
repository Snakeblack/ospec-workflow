@@ -2,15 +2,29 @@
 
 /**
  * Returns one page of `items`.
+ *
+ * An empty list yields `totalPages: 0` and no items. A `page` beyond
+ * `totalPages` yields no items and the converted `page` number is echoed.
  * @param {Array} items
- * @param {number} page 1-based page number
- * @param {number} [pageSize=10]
+ * @param {number|string} page 1-based page number. It is converted with
+ *   `Number()` before validation (e.g. `"2"` becomes `2`); values below 1 or
+ *   that are not finite integers after conversion are treated as 1. The
+ *   result's `page` is always a number.
+ * @param {number} [pageSize=10] positive integer
  * @returns {{ page: number, pageSize: number, totalPages: number, items: Array }}
+ * @throws {RangeError} if `pageSize` is not a positive integer
  */
 function paginate(items, page, pageSize = 10) {
-  const totalPages = Math.floor(items.length / pageSize) + 1;
-  const start = (page - 1) * pageSize;
-  return { page, pageSize, totalPages, items: items.slice(start, start + pageSize) };
+  if (!Number.isInteger(pageSize) || pageSize < 1) {
+    throw new RangeError("pageSize must be a positive integer");
+  }
+  // Convert first (query params arrive as strings), then validate:
+  // Number.isInteger rejects NaN, Infinity and fractions.
+  const convertedPage = Number(page);
+  const currentPage = Number.isInteger(convertedPage) && convertedPage >= 1 ? convertedPage : 1;
+  const totalPages = Math.ceil(items.length / pageSize);
+  const start = (currentPage - 1) * pageSize;
+  return { page: currentPage, pageSize, totalPages, items: items.slice(start, start + pageSize) };
 }
 
 module.exports = { paginate };
diff --git a/test/paginate.js b/test/paginate.js
