--- a/test/duration.js
+++ b/test/duration.js
@@ -21,3 +21,84 @@ test("format renders the largest units first", () => {
   assert.equal(format(0), "0s");
   assert.equal(format(3723004), "1h 2m 3s 4ms");
 });
+
+test("parse days unit d", () => {
+  assert.equal(parse("2d4h"), 187200000);
+  assert.equal(parse("1d"), 86400000);
+  assert.equal(parse("1d 30m"), 88200000);
+  assert.equal(parse("1d1ms"), 86400001);
+});
+
+test("parse tolerates whitespace around d", () => {
+  assert.equal(parse(" 1d  2h "), 93600000);
+  assert.equal(parse("1d\t2h"), 93600000);
+});
+
+test("parse rejects invalid d syntax", () => {
+  for (const text of ["d", "2d4", "2d4x", "1D", "1day", "1.5d", "-1d", "1w"]) {
+    assert.throws(() => parse(text), { name: "SyntaxError", message: `invalid duration: ${text}` });
+  }
+});
+
+test("parse rejects non-string and blank input", () => {
+  for (const value of [undefined, null, 5, {}, "", "   "]) {
+    assert.throws(() => parse(value), TypeError);
+  }
+});
+
+test("format default output is unchanged (hours max)", () => {
+  for (const args of [[], [undefined], [{}], [{ days: false }], [{ days: undefined }]]) {
+    assert.equal(format(86400000, ...args), "24h");
+    assert.equal(format(90000000, ...args), "25h");
+    assert.equal(format(93600000, ...args), "26h");
+  }
+});
+
+test("format zero is 0s with or without days", () => {
+  assert.equal(format(0), "0s");
+  assert.equal(format(0, { days: true }), "0s");
+});
+
+test("format with days:true renders days", () => {
+  assert.equal(format(93600000, { days: true }), "1d 2h");
+  assert.equal(format(86400000, { days: true }), "1d");
+  assert.equal(format(90000000, { days: true }), "1d 1h");
+  assert.equal(format(3600000, { days: true }), "1h");
+  assert.equal(format(187261001, { days: true }), "2d 4h 1m 1s 1ms");
+  assert.equal(format(parse("2d4h"), { days: true }), "2d 4h");
+});
+
+test("format rejects invalid ms", () => {
+  for (const value of [-1, 1.5, NaN, Infinity, "5", undefined]) {
+    assert.throws(() => format(value), { name: "TypeError", message: /integer/ });
+    assert.throws(() => format(value, { days: true }), { name: "TypeError", message: /integer/ });
+  }
+  assert.throws(() => format(-1, "x"), { name: "TypeError", message: /integer/ });
+});
+
+test("format validates options", () => {
+  for (const options of [null, "days", true, 1, []]) {
+    assert.throws(() => format(1000, options), TypeError);
+  }
+  for (const days of [1, 0, "true", null, {}]) {
+    assert.throws(() => format(1000, { days }), TypeError);
+  }
+  assert.equal(format(93600000, { days: undefined }), "26h");
+  assert.equal(format(93600000, { days: true, other: 1 }), "1d 2h");
+  const frozen = Object.freeze({ days: true });
+  assert.equal(format(93600000, frozen), "1d 2h");
+  assert.deepEqual(frozen, { days: true });
