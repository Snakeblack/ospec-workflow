 export function parse(text: string): number;
 
-/** Formats milliseconds as "1h 30m". */
-export function format(ms: number): string;
+export interface FormatOptions {
+  /** Render days ("d") as the largest unit. Default false: output stays hours-max. */
+  days?: boolean;
+}
+
+/** Formats milliseconds as "1h 30m" (or "1d 2h" with { days: true }). */
+export function format(ms: number, options?: FormatOptions): string;
