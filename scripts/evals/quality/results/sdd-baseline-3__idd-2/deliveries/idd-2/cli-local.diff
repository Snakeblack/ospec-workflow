+    const flag = rest.indexOf("--priority");
+    if (flag !== -1) {
+      priority = String(rest[flag + 1] ?? "").toLowerCase();
+      words = rest.slice(0, flag);
+      if (flag + 2 < rest.length || !PRIORITIES.includes(priority)) {
+        stderr.write(`prioridad no válida (alta, media o baja)\n${USAGE}\n`);
