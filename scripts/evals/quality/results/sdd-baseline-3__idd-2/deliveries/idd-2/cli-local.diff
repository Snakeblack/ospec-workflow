diff --git a/test/cli.js b/test/cli.js
index 0ddacaa..ddb1cb8 100644
--- a/test/cli.js
+++ b/test/cli.js
@@ -43,3 +43,40 @@ test("unknown task and usage errors", () => {
   assert.equal(tasks("add").status, 2);
   assert.equal(tasks("borrar").status, 2);
 });
+
+test("priority orders list, stable within same priority", () => {
+  const tasks = session();
+  tasks("add", "a", "--priority", "baja");
+  tasks("add", "b");
+  tasks("add", "c", "--priority", "alta");
+  tasks("add", "d", "--priority", "media");
+  tasks("add", "e", "--priority", "ALTA");
+  tasks("done", "3");
+  assert.equal(
+    tasks("list").out,
+    "[x] 3 c (alta)\n[ ] 5 e (alta)\n[ ] 2 b\n[ ] 4 d\n[ ] 1 a (baja)\n",
+  );
+});
+
+test("invalid priority is a usage error and saves nothing", () => {
+  const tasks = session();
+  for (const argv of [["add", "x", "--priority", "urgente"], ["add", "x", "--priority"]]) {
+    const result = tasks(...argv);
+    assert.equal(result.status, 2);
+    assert.notEqual(result.err, "");
+  }
+  assert.equal(tasks("list").out, "");
+});
+
+test("legacy tasks without priority count as media", () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "tasks-"));
+  const file = path.join(dir, "tasks.json");
+  fs.writeFileSync(file, JSON.stringify({ nextId: 3, tasks: [
+    { id: 1, title: "vieja", done: false },
+    { id: 2, title: "nueva", done: false, priority: "alta" },
+  ] }));
+  let out = "";
+  const status = run(["list"], { env: { TASKS_FILE: file }, stdout: { write: (t) => { out += t; } }, stderr: { write() {} } });
+  assert.equal(status, 0);
+  assert.equal(out, "[ ] 2 nueva (alta)\n[ ] 1 vieja\n");
+});
