+test("parse reads days as 24 hours", () => {
+  assert.equal(parse("2d4h"), 187200000);
+  assert.equal(parse("1d"), 86400000);
+});
+
+test("format shows days only when asked", () => {
+  assert.equal(format(93600000, { days: true }), "1d 2h");
+  assert.equal(format(86400000, { days: true }), "1d");
+  assert.equal(format(5400000, { days: true }), "1h 30m");
+  assert.equal(format(0, { days: true }), "0s");
+  assert.equal(format(93600000), "26h");
