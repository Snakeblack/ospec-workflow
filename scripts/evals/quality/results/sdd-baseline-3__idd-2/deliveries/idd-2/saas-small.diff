@@ -31,3 +31,32 @@ test("other users cannot read a note", () => {
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/notes" }).status, 401);
 });
+
+test("owner shares a note read-only with a colleague of the same organization", () => {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Plan" } }).body;
+  const share = () => app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } });
+  assert.equal(share().status, 200);
+  assert.equal(share().status, 200);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: bruno }).body.map((note) => note.id), [id]);
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: bruno }).status, 200);
+  assert.equal(app.handle({ method: "PUT", path: `/notes/${id}`, user: bruno, body: { title: "X" } }).status, 403);
+  assert.equal(app.handle({ method: "DELETE", path: `/notes/${id}`, user: bruno }).status, 403);
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: bruno, body: { userId: "u3" } }).status, 403);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: { id: "u3", tenantId: "acme" } }).body, []);
+  app.handle({ method: "DELETE", path: `/notes/${id}`, user: ana });
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: bruno }).body, []);
+});
+
+test("share validates input and never crosses organizations", () => {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Plan" } }).body;
+  const share = (user, body, noteId = id) => app.handle({ method: "POST", path: `/notes/${noteId}/share`, user, body }).status;
+  assert.equal(share(ana, {}), 400);
+  assert.equal(share(ana, { userId: "u1" }), 400);
+  assert.equal(share(ana, { userId: "nope" }), 404);
+  assert.equal(share(ana, { userId: "u9" }), 404);
+  assert.equal(share(ana, { userId: "u2" }, "n99"), 404);
+  assert.equal(share(zoe, { userId: "u9" }), 404);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: zoe }).body, []);
+});
