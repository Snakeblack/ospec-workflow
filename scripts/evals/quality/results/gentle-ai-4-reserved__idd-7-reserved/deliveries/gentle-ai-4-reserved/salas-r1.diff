diff --git a/test/app.js b/test/app.js
index 53195a1..9a202c3 100644
--- a/test/app.js
+++ b/test/app.js
@@ -23,3 +23,66 @@ test("rooms of another organization are missing", () => {
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/rooms" }).status, 401);
 });
+
+const slot = { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" };
+
+test("users book a room of their organization", () => {
+  const app = createApp();
+  const created = app.handle({ method: "POST", path: "/bookings", user: ana, body: slot });
+  assert.equal(created.status, 201);
+  assert.equal(created.body.roomId, "r1");
+  assert.equal(created.body.userId, "u1");
+  assert.equal(created.body.start, slot.start);
+  assert.equal(created.body.end, slot.end);
+});
+
+test("bookings of a room are listed for its organization", () => {
+  const app = createApp();
+  app.handle({ method: "POST", path: "/bookings", user: ana, body: slot });
+  const listed = app.handle({ method: "GET", path: "/rooms/r1/bookings", user: ana });
+  assert.equal(listed.status, 200);
+  assert.deepEqual(listed.body.map((booking) => booking.start), [slot.start]);
+  assert.deepEqual(app.handle({ method: "GET", path: "/rooms/r2/bookings", user: ana }).body, []);
+});
+
+test("bookings of another organization's room are missing", () => {
+  const app = createApp();
+  app.handle({ method: "POST", path: "/bookings", user: ana, body: slot });
+  assert.equal(app.handle({ method: "GET", path: "/rooms/r1/bookings", user: zoe }).status, 404);
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: zoe, body: slot }).status, 404);
+});
+
+test("booking an unknown room is missing", () => {
+  const app = createApp();
+  const res = app.handle({ method: "POST", path: "/bookings", user: ana, body: { ...slot, roomId: "nope" } });
+  assert.equal(res.status, 404);
+  assert.equal(app.handle({ method: "GET", path: "/rooms/nope/bookings", user: ana }).status, 404);
+});
+
+test("invalid booking bodies are rejected", () => {
+  const app = createApp();
+  const bad = [
+    { ...slot, roomId: undefined },
+    { ...slot, start: "not-a-date" },
+    { ...slot, end: slot.start },
+    { ...slot, end: "2026-11-03T09:00:00Z" },
+  ];
+  for (const body of bad) {
+    assert.equal(app.handle({ method: "POST", path: "/bookings", user: ana, body }).status, 400, JSON.stringify(body));
+  }
+});
+
+test("overlapping bookings of the same room conflict, adjacent ones do not", () => {
+  const app = createApp();
+  app.handle({ method: "POST", path: "/bookings", user: ana, body: slot });
+  const overlapping = { ...slot, start: "2026-11-03T10:30:00Z", end: "2026-11-03T12:00:00Z" };
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: ana, body: overlapping }).status, 409);
+  const adjacent = { ...slot, start: "2026-11-03T11:00:00Z", end: "2026-11-03T12:00:00Z" };
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: ana, body: adjacent }).status, 201);
+  const otherRoom = { ...slot, roomId: "r2" };
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: ana, body: otherRoom }).status, 201);
+});
+
+test("booking requests without user are rejected", () => {
+  assert.equal(createApp().handle({ method: "POST", path: "/bookings", body: slot }).status, 401);
+});
