 // Tenant isolation: a room from another organization is reported as missing (404).
+// Bookings are kept per app instance. A booking is [start, end) and two bookings
+// of the same room may not overlap (409); touching bookings are allowed.
 function createApp() {
-  function handle({ method, path, user }) {
+  const bookings = [];
+
+  function visibleRoom(id, user) {
+    const room = findRoom(id);
+    return room && room.tenantId === user.tenantId ? room : null;
+  }
+
+  function createBooking(user, body) {
+    const { roomId, start, end } = body || {};
+    const startMs = Date.parse(start);
+    const endMs = Date.parse(end);
+    if (typeof roomId !== "string" || Number.isNaN(startMs) || Number.isNaN(endMs) || endMs <= startMs) {
+      return { status: 400, body: { error: "invalid-booking" } };
+    }
+
+    const room = visibleRoom(roomId, user);
+    if (!room) return { status: 404, body: { error: "not-found" } };
+
+    const overlaps = bookings.some(
+      (b) => b.roomId === room.id && Date.parse(b.start) < endMs && startMs < Date.parse(b.end),
+    );
+    if (overlaps) return { status: 409, body: { error: "conflict" } };
+
+    const booking = {
+      id: `b${bookings.length + 1}`,
+      roomId: room.id,
+      userId: user.id,
+      start,
+      end,
+    };
+    bookings.push(booking);
+    return { status: 201, body: { ...booking } };
+  }
+
+  function handle({ method, path, user, body }) {
     if (!user) return { status: 401, body: { error: "unauthenticated" } };
 
     if (path === "/rooms" && method === "GET") {
       return { status: 200, body: ROOMS.filter((room) => room.tenantId === user.tenantId).map((room) => ({ ...room })) };
     }
 
+    if (path === "/bookings" && method === "POST") return createBooking(user, body);
+
+    const bookingsMatch = /^\/rooms\/([^/]+)\/bookings$/.exec(path);
+    if (bookingsMatch && method === "GET") {
+      const room = visibleRoom(bookingsMatch[1], user);
+      if (!room) return { status: 404, body: { error: "not-found" } };
+      return { status: 200, body: bookings.filter((b) => b.roomId === room.id).map((b) => ({ ...b })) };
+    }
+
