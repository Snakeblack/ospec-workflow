diff --git a/test/app.js b/test/app.js
index 53195a1..17ee5ab 100644
--- a/test/app.js
+++ b/test/app.js
@@ -23,3 +23,48 @@ test("rooms of another organization are missing", () => {
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/rooms" }).status, 401);
 });
+
+const nov3 = (hour) => `2026-11-03T${String(hour).padStart(2, "0")}:00:00Z`;
+const book = (app, user, roomId, start, end) =>
+  app.handle({ method: "POST", path: "/bookings", user, body: { roomId, start, end } });
+
+test("users book a room of their organization and list its bookings", () => {
+  const app = createApp();
+  const created = book(app, ana, "r1", nov3(10), nov3(11));
+  assert.equal(created.status, 201);
+  assert.deepEqual(created.body, { id: created.body.id, roomId: "r1", userId: "u1", start: nov3(10), end: nov3(11) });
+
+  const listed = app.handle({ method: "GET", path: "/rooms/r1/bookings", user: ana });
+  assert.equal(listed.status, 200);
+  assert.deepEqual(listed.body, [created.body]);
+});
+
+test("overlapping bookings in the same room are rejected, back-to-back ones are allowed", () => {
+  const app = createApp();
+  book(app, ana, "r1", nov3(10), nov3(11));
+  assert.equal(book(app, ana, "r1", "2026-11-03T10:30:00Z", nov3(12)).status, 409);
+  assert.equal(book(app, ana, "r1", nov3(9), "2026-11-03T10:30:00Z").status, 409);
+  assert.equal(book(app, ana, "r1", nov3(11), nov3(12)).status, 201);
+  assert.equal(book(app, ana, "r2", nov3(10), nov3(11)).status, 201);
+});
+
+test("bookings of rooms from another organization are missing", () => {
+  const app = createApp();
+  assert.equal(book(app, zoe, "r1", nov3(10), nov3(11)).status, 404);
+  assert.equal(app.handle({ method: "GET", path: "/rooms/r1/bookings", user: zoe }).status, 404);
+  book(app, zoe, "r9", nov3(10), nov3(11));
+  assert.deepEqual(app.handle({ method: "GET", path: "/rooms/r1/bookings", user: ana }).body, []);
+});
+
+test("invalid booking bodies are rejected with 400", () => {
+  const app = createApp();
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: ana }).status, 400);
+  assert.equal(book(app, ana, "r1", nov3(10), "no-es-fecha").status, 400);
+  assert.equal(book(app, ana, "r1", nov3(11), nov3(10)).status, 400);
+  assert.equal(book(app, ana, "r1", nov3(10), nov3(10)).status, 400);
+  assert.equal(book(app, ana, "", nov3(10), nov3(11)).status, 400);
+});
+
+test("bookings require an authenticated user", () => {
+  assert.equal(createApp().handle({ method: "POST", path: "/bookings", body: {} }).status, 401);
+});
