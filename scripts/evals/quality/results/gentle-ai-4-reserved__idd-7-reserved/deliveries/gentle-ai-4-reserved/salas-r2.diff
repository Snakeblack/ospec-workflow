 "use strict";
 
+const { randomUUID } = require("node:crypto");
 const { ROOMS, findRoom } = require("./rooms.js");
 
 // HTTP-shaped handler. The gateway authenticates and passes `user`
 // ({ id, tenantId }); a request without user is rejected.
 // Tenant isolation: a room from another organization is reported as missing (404).
 function createApp() {
-  function handle({ method, path, user }) {
+  const bookings = [];
+
+  function visibleRoom(id, user) {
+    const room = findRoom(id);
+    return room && room.tenantId === user.tenantId ? room : null;
+  }
+
+  // Intervals are half-open: a booking may start exactly when the previous one ends.
+  function createBooking(user, body) {
+    const { roomId, start, end } = body || {};
+    const startMs = Date.parse(start);
+    const endMs = Date.parse(end);
+    if (typeof roomId !== "string" || roomId === "" || Number.isNaN(startMs) || Number.isNaN(endMs) || endMs <= startMs) {
+      return { status: 400, body: { error: "invalid-booking" } };
+    }
+
+    const room = visibleRoom(roomId, user);
+    if (!room) return { status: 404, body: { error: "not-found" } };
+
+    const overlaps = bookings.some(
+      (booking) => booking.roomId === room.id && startMs < Date.parse(booking.end) && Date.parse(booking.start) < endMs,
+    );
+    if (overlaps) return { status: 409, body: { error: "conflict" } };
+
+    const booking = { id: randomUUID(), roomId: room.id, userId: user.id, start, end };
+    bookings.push(booking);
+    return { status: 201, body: { ...booking } };
+  }
+
+  function handle({ method, path, user, body }) {
     if (!user) return { status: 401, body: { error: "unauthenticated" } };
 
     if (path === "/rooms" && method === "GET") {
