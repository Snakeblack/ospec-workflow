@@ -23,3 +23,62 @@ test("rooms of another organization are missing", () => {
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/rooms" }).status, 401);
 });
+
+const book = (app, user, body) => app.handle({ method: "POST", path: "/bookings", user, body });
+
+test("users book a free room and list its bookings from the earliest start", () => {
+  const app = createApp();
+  const created = book(app, ana, { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" });
+  assert.equal(created.status, 201);
+  assert.equal(created.body.roomId, "r1");
+  assert.equal(created.body.userId, "u1");
+  assert.equal(created.body.start, "2026-11-03T10:00:00.000Z");
+  assert.equal(book(app, ana, { roomId: "r1", start: "2026-11-03T11:00:00Z", end: "2026-11-03T12:00:00Z" }).status, 201);
+  assert.equal(book(app, ana, { roomId: "r1", start: "2026-11-03T09:00:00Z", end: "2026-11-03T10:00:00Z" }).status, 201);
+
+  const listed = app.handle({ method: "GET", path: "/rooms/r1/bookings", user: ana });
+  assert.equal(listed.status, 200);
+  assert.deepEqual(listed.body.map((booking) => booking.start), [
+    "2026-11-03T09:00:00.000Z",
+    "2026-11-03T10:00:00.000Z",
+    "2026-11-03T11:00:00.000Z",
+  ]);
+});
+
+test("a booking that overlaps another in the same room is rejected and not stored", () => {
+  const app = createApp();
+  assert.equal(book(app, ana, { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" }).status, 201);
+  assert.equal(book(app, ana, { roomId: "r1", start: "2026-11-03T10:30:00Z", end: "2026-11-03T11:30:00Z" }).status, 409);
+  assert.equal(book(app, ana, { roomId: "r1", start: "2026-11-03T10:15:00Z", end: "2026-11-03T10:45:00Z" }).status, 409);
+  assert.equal(app.handle({ method: "GET", path: "/rooms/r1/bookings", user: ana }).body.length, 1);
+  assert.equal(book(app, ana, { roomId: "r2", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" }).status, 201);
+});
+
+test("a booking whose start is not before its end is rejected and not stored", () => {
+  const app = createApp();
+  assert.equal(book(app, ana, { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T10:00:00Z" }).status, 400);
+  assert.equal(book(app, ana, { roomId: "r1", start: "2026-11-03T11:00:00Z", end: "2026-11-03T10:00:00Z" }).status, 400);
+  assert.deepEqual(app.handle({ method: "GET", path: "/rooms/r1/bookings", user: ana }).body, []);
+});
+
+test("a booking with missing fields or non-UTC timestamps is rejected", () => {
+  const app = createApp();
+  assert.equal(book(app, ana, { start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" }).status, 400);
+  assert.equal(book(app, ana, { roomId: "r1", start: "2026-11-03T10:00:00+02:00", end: "2026-11-03T11:00:00Z" }).status, 400);
+  assert.equal(book(app, ana, { roomId: "r1", start: "tomorrow", end: "2026-11-03T11:00:00Z" }).status, 400);
+  assert.equal(book(app, ana).status, 400);
+});
+
+test("rooms of another organization or unknown rooms cannot be booked or listed", () => {
+  const app = createApp();
+  assert.equal(book(app, ana, { roomId: "r9", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" }).status, 404);
+  assert.equal(book(app, ana, { roomId: "r404", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" }).status, 404);
+  assert.equal(app.handle({ method: "GET", path: "/rooms/r9/bookings", user: ana }).status, 404);
