@@ -0,0 +1,115 @@
+openapi: 3.0.3
+info:
+  title: rooms-api
+  version: 0.5.0
+  description: API de salas de reuniones. El gateway autentica y pasa el usuario; sin usuario la respuesta es 401.
+paths:
+  /bookings:
+    post:
+      summary: Reserva una sala
+      description: El intervalo es [start, end). Una reserva puede empezar cuando acaba otra de la misma sala.
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/NewBooking"
+      responses:
+        "201":
+          description: Reserva creada
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Booking"
+        "400":
+          description: Cuerpo inválido, o start no anterior a end
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+        "401":
+          description: Sin usuario autenticado
+        "404":
+          description: La sala no existe o es de otra organización
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+        "409":
+          description: La sala ya tiene una reserva que se solapa
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+  /rooms/{id}/bookings:
+    get:
+      summary: Reservas de una sala, ordenadas por start ascendente
+      parameters:
+        - name: id
+          in: path
+          required: true
+          schema:
+            type: string
+      responses:
+        "200":
+          description: Reservas de la sala
+          content:
+            application/json:
+              schema:
+                type: array
+                items:
+                  $ref: "#/components/schemas/Booking"
+        "401":
+          description: Sin usuario autenticado
+        "404":
+          description: La sala no existe o es de otra organización
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/Error"
+components:
+  schemas:
+    NewBooking:
+      type: object
+      required: [roomId, start, end]
+      properties:
+        roomId:
+          type: string
+          example: r1
+        start:
+          type: string
+          format: date-time
+          description: ISO-8601 en UTC, terminado en Z
+          example: "2026-11-03T10:00:00Z"
+        end:
+          type: string
+          format: date-time
+          description: ISO-8601 en UTC, terminado en Z; debe ser posterior a start
+          example: "2026-11-03T11:00:00Z"
+    Booking:
+      type: object
+      required: [id, roomId, userId, start, end]
+      properties:
+        id:
+          type: string
+          example: b1
+        roomId:
+          type: string
+          example: r1
+        userId:
+          type: string
+          description: Usuario que hizo la reserva
+          example: u1
+        start:
+          type: string
+          format: date-time
+        end:
+          type: string
+          format: date-time
+    Error:
+      type: object
+      required: [error]
+      properties:
+        error:
+          type: string
+          enum: [invalid-body, not-found, conflict, unauthenticated]
