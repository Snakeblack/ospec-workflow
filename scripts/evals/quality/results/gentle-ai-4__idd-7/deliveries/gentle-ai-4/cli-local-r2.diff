@@ -2,7 +2,31 @@
 
 const { storePath, load, save } = require("./store.js");
 
-const USAGE = "uso: tasks add <título> | tasks list | tasks done <id>";
+const USAGE =
+  "uso: tasks add <título> [--priority alta|media|baja] | tasks list | tasks done <id>";
+
+const PRIORITIES = ["alta", "media", "baja"];
+const DEFAULT_PRIORITY = "media";
+
+// Lower rank is shown first. Tasks saved before priorities existed count as the default.
+function rank(task) {
+  return PRIORITIES.indexOf(task.priority ?? DEFAULT_PRIORITY);
+}
+
+// --priority is only recognised as the last two arguments; anything else is part of the title.
+// Returns null for a usage error.
+function parseAdd(words) {
+  let priority = DEFAULT_PRIORITY;
+  let titleWords = words;
+  if (words.includes("--priority")) {
+    if (words[words.length - 2] !== "--priority") return null;
+    priority = words[words.length - 1];
+    titleWords = words.slice(0, -2);
+  }
+  const title = titleWords.join(" ").trim();
+  if (!title || !PRIORITIES.includes(priority)) return null;
+  return { title, priority };
+}
 
 // Exit codes: 0 ok, 1 the task does not exist, 2 usage error.
 function run(argv, { stdout = process.stdout, stderr = process.stderr, env = process.env } = {}) {
@@ -10,13 +34,13 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
   const file = storePath(env);
 
   if (command === "add") {
-    const title = rest.join(" ").trim();
-    if (!title) {
+    const parsed = parseAdd(rest);
+    if (!parsed) {
       stderr.write(`${USAGE}\n`);
       return 2;
     }
     const data = load(file);
-    const task = { id: data.nextId, title, done: false };
+    const task = { id: data.nextId, title: parsed.title, done: false, priority: parsed.priority };
     data.nextId += 1;
     data.tasks.push(task);
     save(file, data);
@@ -26,7 +50,9 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
 
   if (command === "list") {
     const data = load(file);
-    for (const task of data.tasks) {
+    // Array.prototype.sort is stable, so equal priorities keep insertion order.
+    const sorted = [...data.tasks].sort((a, b) => rank(a) - rank(b));
+    for (const task of sorted) {
       stdout.write(`${task.done ? "[x]" : "[ ]"} ${task.id} ${task.title}\n`);
     }
     return 0;
diff --git a/test/cli.js b/test/cli.js
index 0ddacaa..56c94e1 100644
--- a/test/cli.js
+++ b/test/cli.js
@@ -43,3 +43,23 @@ test("unknown task and usage errors", () => {
   assert.equal(tasks("add").status, 2);
   assert.equal(tasks("borrar").status, 2);
 });
+
+test("list shows higher priority first and keeps insertion order within a level", () => {
+  const tasks = session();
+  tasks("add", "comprar", "pan", "--priority", "baja");
+  tasks("add", "llamar");
+  tasks("add", "pagar", "factura", "--priority", "alta");
+  tasks("add", "regar", "--priority", "media");
+  assert.equal(
+    tasks("list").out,
+    "[ ] 3 pagar factura\n[ ] 2 llamar\n[ ] 4 regar\n[ ] 1 comprar pan\n",
+  );
+});
+
+test("add rejects an invalid or incomplete priority without adding the task", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "comprar", "--priority", "urgente").status, 2);
+  assert.equal(tasks("add", "comprar", "--priority").status, 2);
+  assert.equal(tasks("add", "--priority", "alta").status, 2);
+  assert.equal(tasks("list").out, "");
+});
