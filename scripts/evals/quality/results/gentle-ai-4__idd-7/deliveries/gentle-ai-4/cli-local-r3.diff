 const { storePath, load, save } = require("./store.js");
 
-const USAGE = "uso: tasks add <título> | tasks list | tasks done <id>";
+const USAGE = "uso: tasks add <título> [--priority <alta|media|baja>] | tasks list | tasks done <id>";
+
+// Highest priority first. Tasks stored before priorities existed count as media.
+const PRIORITIES = ["alta", "media", "baja"];
+const DEFAULT_PRIORITY = "media";
+
+// Reads an optional trailing `--priority <value>` from the title words.
+// Returns null when the trailing flag is malformed or the value is unknown.
+function parseAdd(args) {
+  const at = args.lastIndexOf("--priority");
+  if (at === -1) return { title: args.join(" ").trim(), priority: DEFAULT_PRIORITY };
+  const priority = args[at + 1];
+  if (at + 2 !== args.length || !PRIORITIES.includes(priority)) return null;
+  return { title: args.slice(0, at).join(" ").trim(), priority };
+}
 
 // Exit codes: 0 ok, 1 the task does not exist, 2 usage error.
 function run(argv, { stdout = process.stdout, stderr = process.stderr, env = process.env } = {}) {
