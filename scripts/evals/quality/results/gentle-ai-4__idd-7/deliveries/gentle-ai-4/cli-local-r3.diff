+test("add stores a priority and list shows higher priorities first", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "baja", "--priority", "baja").status, 0);
+  assert.equal(tasks("add", "alta", "--priority", "alta").status, 0);
+  tasks("add", "por", "defecto");
+  assert.equal(tasks("add", "media", "--priority", "media").status, 0);
+  assert.equal(
+    tasks("list").out,
+    "[ ] 2 alta\n[ ] 3 por defecto\n[ ] 4 media\n[ ] 1 baja\n",
+  );
+});
+
+test("a task stored without priority is treated as media", () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "tasks-"));
+  const file = path.join(dir, "tasks.json");
+  fs.writeFileSync(file, JSON.stringify({
+    nextId: 3,
+    tasks: [
+      { id: 1, title: "antigua", done: false },
+      { id: 2, title: "alta", done: false, priority: "alta" },
+    ],
+  }));
+  let out = "";
+  run(["list"], {
+    env: { TASKS_FILE: file },
+    stdout: { write: (text) => { out += text; } },
+    stderr: { write: () => {} },
+  });
+  assert.equal(out, "[ ] 2 alta\n[ ] 1 antigua\n");
+});
+
+test("invalid or incomplete priority is a usage error and adds nothing", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "x", "--priority", "urgente").status, 2);
+  assert.equal(tasks("add", "x", "--priority").status, 2);
+  assert.equal(tasks("add", "--priority", "alta").status, 2);
+  assert.equal(tasks("list").out, "");
+});
+
