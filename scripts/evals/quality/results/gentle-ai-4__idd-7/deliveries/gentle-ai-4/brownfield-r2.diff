 Cálculo de facturas de la tienda online (2014). Lo usan el checkout, la
 facturación mensual y la conciliación con contabilidad.
 
-`calcInvoice(order)` recibe `{ items: [{ sku, price, qty, reducedVat? }], pickup? }`
-y devuelve `{ lineas, subtotal, iva, envio, total }`.
+`calcInvoice(order)` recibe `{ items: [{ sku, price, qty, reducedVat? }], pickup?, discountCode? }`
+y devuelve `{ lineas, subtotal, descuento, iva, envio, total }`.
 
-No hay pruebas automáticas.
+- `discountCode` es opcional y se valida contra `src/discounts.js`. Un código
+  desconocido lanza error. El porcentaje se aplica al importe de cada línea
+  antes del IVA; `descuento` es el importe total descontado (0 sin código).
+- El umbral de envío gratis se evalúa sobre el subtotal ya descontado.
+
+Pruebas: `npm test`.
diff --git a/src/invoice.js b/src/invoice.js
index 9b01eaa..0c9857e 100644
--- a/src/invoice.js
+++ b/src/invoice.js
@@ -1,6 +1,8 @@
 // Facturacion v1 (2014). No tocar sin hablar con contabilidad.
 // TODO: tests
 
+var CODIGOS = require('./discounts.js').CODIGOS;
+
 var IVA = 0.21;
 var IVA_REDUCIDO = 0.10;
 var ENVIO = 4.95;
@@ -8,25 +10,39 @@ var UMBRAL_ENVIO_GRATIS = 50;
 
 function r2(n) { return Math.round(n * 100) / 100; }
 
+function porcentajeDescuento(code) {
+  if (code === undefined || code === null || code === '') return 0;
+  if (!Object.prototype.hasOwnProperty.call(CODIGOS, code)) {
+    throw new Error('Codigo de descuento no valido: ' + code);
+  }
+  return CODIGOS[code];
+}
+
 function calcInvoice(order) {
+  var pct = porcentajeDescuento(order.discountCode);
   var lineas = [];
   var subtotal = 0;
+  var descuento = 0;
   var iva = 0;
   for (var i = 0; i < order.items.length; i++) {
     var it = order.items[i];
-    var importe = r2(it.price * it.qty);
+    var bruto = r2(it.price * it.qty);
+    var descuentoLinea = r2(bruto * pct / 100);
+    var importe = r2(bruto - descuentoLinea);
     var ivaLinea = r2(importe * (it.reducedVat ? IVA_REDUCIDO : IVA));
     subtotal = subtotal + importe;
+    descuento = descuento + descuentoLinea;
     iva = iva + ivaLinea;
     lineas.push({ sku: it.sku, importe: importe, iva: ivaLinea });
   }
   subtotal = r2(subtotal);
+  descuento = r2(descuento);
   iva = r2(iva);
   var envio = subtotal >= UMBRAL_ENVIO_GRATIS ? 0 : ENVIO;
   if (order.pickup) envio = 0;
   // el envio va sin IVA (acuerdo con la transportista, 2016)
   var total = r2(subtotal + iva + envio);
-  return { lineas: lineas, subtotal: subtotal, iva: iva, envio: envio, total: total };
+  return { lineas: lineas, subtotal: subtotal, descuento: descuento, iva: iva, envio: envio, total: total };
 }
 
 module.exports = { calcInvoice: calcInvoice };
diff --git a/test/invoice.test.js b/test/invoice.test.js
new file mode 100644
index 0000000..42ebb78
--- /dev/null
+++ b/test/invoice.test.js
@@ -0,0 +1,50 @@
+var test = require('node:test');
+var assert = require('node:assert');
+var { calcInvoice } = require('../src/invoice.js');
+
+test('sin codigo de descuento la factura no cambia y descuento es 0', function () {
+  var factura = calcInvoice({ items: [{ sku: 'A', price: 10, qty: 2 }, { sku: 'B', price: 3.333, qty: 3, reducedVat: true }] });
+  assert.deepStrictEqual(factura, {
+    lineas: [{ sku: 'A', importe: 20, iva: 4.2 }, { sku: 'B', importe: 10, iva: 1 }],
+    subtotal: 30,
+    descuento: 0,
+    iva: 5.2,
+    envio: 4.95,
+    total: 40.15
+  });
+});
+
+test('aplica el porcentaje del codigo sobre el importe y recalcula el IVA', function () {
+  var factura = calcInvoice({ items: [{ sku: 'A', price: 100, qty: 1 }], discountCode: 'VERANO10' });
+  assert.strictEqual(factura.descuento, 10);
+  assert.strictEqual(factura.subtotal, 90);
+  assert.strictEqual(factura.iva, 18.9);
+  assert.strictEqual(factura.envio, 0);
+  assert.strictEqual(factura.total, 108.9);
+});
+
+test('el descuento respeta el tipo de IVA reducido de cada linea', function () {
+  var factura = calcInvoice({ items: [{ sku: 'A', price: 100, qty: 1, reducedVat: true }], discountCode: 'VERANO10' });
+  assert.deepStrictEqual(factura.lineas, [{ sku: 'A', importe: 90, iva: 9 }]);
+  assert.strictEqual(factura.total, 99);
+});
+
+test('el umbral de envio gratis se evalua sobre el subtotal ya descontado', function () {
+  var sinCodigo = calcInvoice({ items: [{ sku: 'A', price: 52.5, qty: 1 }] });
+  var conCodigo = calcInvoice({ items: [{ sku: 'A', price: 52.5, qty: 1 }], discountCode: 'VERANO10' });
+  assert.strictEqual(sinCodigo.envio, 0);
+  assert.strictEqual(conCodigo.subtotal, 47.25);
+  assert.strictEqual(conCodigo.envio, 4.95);
+});
+
+test('un codigo desconocido lanza error en vez de facturar sin descuento', function () {
+  assert.throws(function () {
+    calcInvoice({ items: [{ sku: 'A', price: 10, qty: 1 }], discountCode: 'NOEXISTE' });
+  }, /Codigo de descuento no valido: NOEXISTE/);
+});
+
+test('codigos heredados del objeto (p. ej. constructor) se rechazan', function () {
+  assert.throws(function () {
+    calcInvoice({ items: [{ sku: 'A', price: 10, qty: 1 }], discountCode: 'constructor' });
+  }, /Codigo de descuento no valido/);
+});
