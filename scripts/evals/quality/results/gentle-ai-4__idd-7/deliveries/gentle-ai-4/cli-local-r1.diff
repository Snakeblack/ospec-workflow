 const { storePath, load, save } = require("./store.js");
 
-const USAGE = "uso: tasks add <título> | tasks list | tasks done <id>";
+const USAGE =
+  "uso: tasks add <título> [--priority alta|media|baja] | tasks list | tasks done <id>";
+
+const PRIORITIES = ["alta", "media", "baja"];
+const DEFAULT_PRIORITY = "media";
+
+// --priority must be the last two arguments: `add <título...> --priority <valor>`.
+function parseAdd(args) {
+  const flag = args.indexOf("--priority");
+  if (flag === -1) return { title: args.join(" ").trim(), priority: DEFAULT_PRIORITY };
+  const priority = args[flag + 1];
+  if (flag !== args.length - 2 || !PRIORITIES.includes(priority)) return null;
+  return { title: args.slice(0, flag).join(" ").trim(), priority };
+}
+
+// Lower rank means higher priority; tasks saved before priorities existed count as media.
+function priorityRank(task) {
+  return PRIORITIES.indexOf(task.priority ?? DEFAULT_PRIORITY);
+}
 
 // Exit codes: 0 ok, 1 the task does not exist, 2 usage error.
