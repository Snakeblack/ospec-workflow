+test("add accepts a trailing --priority and list shows higher priority first", () => {
+  const tasks = session();
+  tasks("add", "comprar", "pan", "--priority", "baja");
+  tasks("add", "llamar");
+  tasks("add", "pagar", "factura", "--priority", "alta");
+  tasks("add", "regar", "--priority", "media");
+  assert.equal(
+    tasks("list").out,
+    "[ ] 3 pagar factura\n[ ] 2 llamar\n[ ] 4 regar\n[ ] 1 comprar pan\n",
+  );
+});
+
+test("tasks without priority are media and keep insertion order", () => {
+  const tasks = session();
+  tasks("add", "uno");
+  tasks("add", "dos", "--priority", "alta");
+  tasks("add", "tres");
+  assert.equal(tasks("list").out, "[ ] 2 dos\n[ ] 1 uno\n[ ] 3 tres\n");
+});
+
+test("invalid or misplaced --priority is a usage error", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "x", "--priority", "urgente").status, 2);
+  assert.equal(tasks("add", "x", "--priority").status, 2);
+  assert.equal(tasks("add", "--priority", "alta", "x").status, 2);
+  assert.equal(tasks("list").out, "");
+});
