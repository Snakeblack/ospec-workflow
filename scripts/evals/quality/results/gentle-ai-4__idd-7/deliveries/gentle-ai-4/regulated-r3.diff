diff --git a/src/clinic.js b/src/clinic.js
index e4eb220..243959f 100644
--- a/src/clinic.js
+++ b/src/clinic.js
@@ -11,6 +11,12 @@ class AccessDeniedError extends Error {
 
 // Patient: { id, nationalId, name, birthDate, diagnosis }
 // Appointment: { id, patientId, date: "YYYY-MM-DD", time: "HH:MM", reason }
+// RFC 4180: quote fields containing separators, quotes or line breaks.
+function csvField(value) {
+  const text = String(value);
+  return /[",\r\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
+}
+
 function createClinic({ patients = [], appointments = [], audit = createAuditLog() } = {}) {
   function requireRole(actor, roles) {
     if (!actor || !roles.includes(actor.role)) {
@@ -32,7 +38,21 @@ function createClinic({ patients = [], appointments = [], audit = createAuditLog
     return result;
   }
 
-  return { getPatient, appointmentsOn, audit };
+  // The export carries patient names and reasons (health data), so it is audited like any other read.
+  function exportAppointmentsCsv(date, actor) {
+    requireRole(actor, ["doctor", "reception"]);
+    const rows = appointments
+      .filter((item) => item.date === date)
+      .sort((a, b) => a.time.localeCompare(b.time))
+      .map((item) => {
+        const patient = patients.find((candidate) => candidate.id === item.patientId);
+        return [item.time, patient ? patient.name : "", item.reason].map(csvField).join(",");
+      });
+    audit.record({ action: "export-appointments", actorId: actor.id, date, count: rows.length });
+    return ["time,patient,reason", ...rows].map((line) => `${line}\n`).join("");
+  }
+
+  return { getPatient, appointmentsOn, exportAppointmentsCsv, audit };
 }
 
 module.exports = { createClinic, AccessDeniedError };
diff --git a/test/clinic.js b/test/clinic.js
