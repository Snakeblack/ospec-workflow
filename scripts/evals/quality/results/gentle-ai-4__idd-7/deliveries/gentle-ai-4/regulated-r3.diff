   assert.deepEqual(clinic.appointmentsOn("2026-10-06", reception).map((item) => item.id), ["a1"]);
   assert.equal(clinic.audit.entries()[0].count, 1);
 });
+
+test("export lists a day's appointments as CSV sorted by time", () => {
+  const clinic = createClinic({
+    patients: [
+      { id: "p1", name: "Luis Gómez" },
+      { id: "p2", name: 'Ana "La Rubia", Pérez' },
+    ],
+    appointments: [
+      { id: "a1", patientId: "p1", date: "2026-10-06", time: "11:00", reason: "Control" },
+      { id: "a2", patientId: "p2", date: "2026-10-06", time: "09:30", reason: "Revisión, urgente" },
+      { id: "a3", patientId: "p1", date: "2026-10-07", time: "08:00", reason: "Otro día" },
+    ],
+  });
+  assert.equal(
+    clinic.exportAppointmentsCsv("2026-10-06", reception),
+    'time,patient,reason\n09:30,"Ana ""La Rubia"", Pérez","Revisión, urgente"\n11:00,Luis Gómez,Control\n',
+  );
+});
+
+test("export of a day without appointments is just the header", () => {
+  const clinic = createClinic({ patients, appointments });
+  assert.equal(clinic.exportAppointmentsCsv("2026-12-25", doctor), "time,patient,reason\n");
+});
+
+test("export is audited", () => {
+  const clinic = createClinic({ patients, appointments });
+  clinic.exportAppointmentsCsv("2026-10-06", doctor);
+  assert.deepEqual(clinic.audit.entries().map((entry) => [entry.action, entry.count]), [
+    ["export-appointments", 1],
+  ]);
+});
+
+test("export is denied to roles without agenda access and leaves no audit entry", () => {
+  const clinic = createClinic({ patients, appointments });
+  assert.throws(() => clinic.exportAppointmentsCsv("2026-10-06", { id: "x1", role: "admin" }), AccessDeniedError);
+  assert.deepEqual(clinic.audit.entries(), []);
+});
