@@ -31,3 +31,30 @@ test("appointments of a day are listed and audited", () => {
   assert.deepEqual(clinic.appointmentsOn("2026-10-06", reception).map((item) => item.id), ["a1"]);
   assert.equal(clinic.audit.entries()[0].count, 1);
 });
+
+test("reception exports a day's appointments as CSV sorted by time and audited", () => {
+  const exportPatients = [...patients, { id: "p2", nationalId: "87654321X", name: "Ana, López", birthDate: "1990-05-05", diagnosis: "" }];
+  const exportAppointments = [
+    { id: "a3", patientId: "p2", date: "2026-10-06", time: "11:00", reason: 'Revisión "anual"' },
+    ...appointments,
+  ];
+  const clinic = createClinic({ patients: exportPatients, appointments: exportAppointments });
+  assert.equal(
+    clinic.exportAppointmentsCsv("2026-10-06", reception),
+    'hora,paciente,motivo\n09:30,Luis Gómez,Control\n11:00,"Ana, López","Revisión ""anual"""\n',
+  );
+  const last = clinic.audit.entries().at(-1);
+  assert.equal(last.action, "export-appointments");
+  assert.equal(last.count, 2);
+});
+
+test("a day without appointments exports only the header", () => {
+  const clinic = createClinic({ patients, appointments });
+  assert.equal(clinic.exportAppointmentsCsv("2026-12-25", doctor), "hora,paciente,motivo\n");
+});
+
+test("roles outside doctor and reception cannot export appointments, and nothing is audited", () => {
+  const clinic = createClinic({ patients, appointments });
+  assert.throws(() => clinic.exportAppointmentsCsv("2026-10-06", { id: "x", role: "nurse" }), AccessDeniedError);
+  assert.equal(clinic.audit.entries().length, 0);
+});
