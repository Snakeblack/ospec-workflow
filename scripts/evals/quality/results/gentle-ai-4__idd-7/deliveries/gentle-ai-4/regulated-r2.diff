+
+test("day agenda exports as CSV sorted by time, with escaped fields", () => {
+  const clinic = createClinic({
+    patients: [
+      { id: "p1", nationalId: "1", name: "Luis Gómez", birthDate: "1980-02-01", diagnosis: "" },
+      { id: "p2", nationalId: "2", name: 'Ana "La Rubia", S.L.', birthDate: "1990-05-05", diagnosis: "" },
+    ],
+    appointments: [
+      { id: "a3", patientId: "p1", date: "2026-10-06", time: "11:15", reason: "Control" },
+      { id: "a4", patientId: "p2", date: "2026-10-06", time: "09:00", reason: "Revisión,\nurgente" },
+      { id: "a5", patientId: "p9", date: "2026-10-06", time: "10:00", reason: "Analítica" },
+      { id: "a6", patientId: "p1", date: "2026-10-07", time: "08:00", reason: "Otro día" },
+    ],
+  });
+  assert.equal(
+    clinic.exportAppointmentsCsv("2026-10-06", reception),
+    'time,patient,reason\n09:00,"Ana ""La Rubia"", S.L.","Revisión,\nurgente"\n10:00,,Analítica\n11:15,Luis Gómez,Control\n',
+  );
+});
+
+test("CSV export of an empty day is only the header and is audited", () => {
+  const clinic = createClinic({ patients, appointments });
+  assert.equal(clinic.exportAppointmentsCsv("2026-12-25", doctor), "time,patient,reason\n");
+  assert.deepEqual(clinic.audit.entries().map((entry) => [entry.action, entry.count]), [["export-appointments", 0]]);
+});
+
+test("CSV export is limited to doctors and reception", () => {
+  const clinic = createClinic({ patients, appointments });
+  assert.throws(() => clinic.exportAppointmentsCsv("2026-10-06", { id: "x1", role: "nurse" }), AccessDeniedError);
+  assert.throws(() => clinic.exportAppointmentsCsv("2026-10-06", null), AccessDeniedError);
+  assert.equal(clinic.audit.entries().length, 0);
+});
