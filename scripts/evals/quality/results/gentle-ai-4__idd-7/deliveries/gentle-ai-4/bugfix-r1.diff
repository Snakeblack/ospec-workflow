diff --git a/src/paginate.js b/src/paginate.js
index ed94097..a9dc3a9 100644
--- a/src/paginate.js
+++ b/src/paginate.js
@@ -6,9 +6,16 @@
  * @param {number} page 1-based page number
  * @param {number} [pageSize=10]
  * @returns {{ page: number, pageSize: number, totalPages: number, items: Array }}
+ * @throws {RangeError} when `page` or `pageSize` is not a positive integer
  */
 function paginate(items, page, pageSize = 10) {
-  const totalPages = Math.floor(items.length / pageSize) + 1;
+  if (!Number.isInteger(page) || page < 1) {
+    throw new RangeError(`page must be a positive integer, got ${page}`);
+  }
+  if (!Number.isInteger(pageSize) || pageSize < 1) {
+    throw new RangeError(`pageSize must be a positive integer, got ${pageSize}`);
+  }
+  const totalPages = Math.ceil(items.length / pageSize);
   const start = (page - 1) * pageSize;
   return { page, pageSize, totalPages, items: items.slice(start, start + pageSize) };
 }
diff --git a/test/paginate.js b/test/paginate.js
index 6989bee..44daec9 100644
--- a/test/paginate.js
+++ b/test/paginate.js
@@ -21,3 +21,25 @@ test("partial last page", () => {
 test("catalog lists ten products per page", () => {
   assert.equal(listProducts(2).items[0].id, 11);
 });
+
+test("total pages is exact when items fill the last page", () => {
+  const twenty = Array.from({ length: 20 }, (_, index) => index + 1);
+  assert.equal(paginate(twenty, 1, 10).totalPages, 2);
+  assert.equal(paginate(items, 1, 5).totalPages, 5);
+});
+
+test("empty list has zero total pages", () => {
+  assert.equal(paginate([], 1, 10).totalPages, 0);
+  assert.deepEqual(paginate([], 1, 10).items, []);
+});
+
+test("rejects page numbers below 1", () => {
+  assert.throws(() => paginate(items, 0, 10), RangeError);
+  assert.throws(() => paginate(items, -1, 10), RangeError);
+});
+
+test("rejects non-positive or non-integer page sizes", () => {
+  assert.throws(() => paginate(items, 1, 0), RangeError);
+  assert.throws(() => paginate(items, 1, -5), RangeError);
+  assert.throws(() => paginate(items, 1, 2.5), RangeError);
+});
