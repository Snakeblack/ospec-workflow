 const { storePath, load, save } = require("./store.js");
 
-const USAGE = "uso: tasks add <título> | tasks list | tasks done <id>";
+const USAGE = "uso: tasks add <título> [--priority alta|media|baja] | tasks list | tasks done <id>";
+const PRIORITIES = ["alta", "media", "baja"];
+// Tasks saved before priorities existed have no field and count as media.
+const DEFAULT_PRIORITY = "media";
+
+// `--priority <valor>` must close the line; anything else after it is a usage error (null).
+function parseAdd(words) {
+  const flag = words.indexOf("--priority");
+  if (flag === -1) return { title: words.join(" ").trim(), priority: DEFAULT_PRIORITY };
+  if (flag !== words.length - 2) return null;
+  return { title: words.slice(0, flag).join(" ").trim(), priority: words[flag + 1].toLowerCase() };
+}
+
+function priorityOf(task) {
+  return task.priority ?? DEFAULT_PRIORITY;
+}
 
 // Exit codes: 0 ok, 1 the task does not exist, 2 usage error.
