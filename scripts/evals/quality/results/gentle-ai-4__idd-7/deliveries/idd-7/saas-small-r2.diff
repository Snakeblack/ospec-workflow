 });
+
+test("owners share a note with a colleague of their organization, who can list and read it", () => {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Compartida" } }).body;
+  const shared = app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } });
