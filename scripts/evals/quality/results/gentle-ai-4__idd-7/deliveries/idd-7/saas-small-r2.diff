+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Privada" } }).body;
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: bruno, body: { userId: "u3" } }).status, 403);
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: { id: "u3", tenantId: "acme" } }).status, 403);
