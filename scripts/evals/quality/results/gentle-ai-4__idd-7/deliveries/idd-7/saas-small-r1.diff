diff --git a/test/app.js b/test/app.js
index 9815af7..a6a6fd6 100644
--- a/test/app.js
+++ b/test/app.js
@@ -31,3 +31,41 @@ test("other users cannot read a note", () => {
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/notes" }).status, 401);
 });
+
+test("owner shares a note with a teammate, who can list and read it", () => {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Compartida" } }).body;
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } }).status, 200);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: bruno }).body.map((note) => note.id), [id]);
+  const read = app.handle({ method: "GET", path: `/notes/${id}`, user: bruno });
+  assert.equal(read.status, 200);
+  assert.equal(read.body.title, "Compartida");
+});
+
+test("sharing twice leaves a single entry and no error", () => {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Dos veces" } }).body;
+  app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } });
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } }).status, 200);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: bruno }).body.map((note) => note.id), [id]);
+});
+
+test("a shared note stays read-only for the teammate", () => {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Solo lectura" } }).body;
+  app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } });
+  assert.equal(app.handle({ method: "PUT", path: `/notes/${id}`, user: bruno, body: { title: "Cambio" } }).status, 403);
+  assert.equal(app.handle({ method: "DELETE", path: `/notes/${id}`, user: bruno }).status, 403);
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: ana }).body.title, "Solo lectura");
+});
+
+test("only the owner can share, and only with a user of the same organization", () => {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Mía" } }).body;
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: bruno, body: { userId: "u3" } }).status, 403);
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: {} }).status, 400);
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u404" } }).status, 404);
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u9" } }).status, 404);
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: zoe }).status, 404);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: bruno }).body, []);
+});
