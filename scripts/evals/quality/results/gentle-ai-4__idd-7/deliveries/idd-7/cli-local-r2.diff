@@ -2,7 +2,15 @@
 
 const { storePath, load, save } = require("./store.js");
 
-const USAGE = "uso: tasks add <título> | tasks list | tasks done <id>";
+const USAGE = "uso: tasks add <título> [--priority alta|media|baja] | tasks list | tasks done <id>";
+const PRIORITIES = ["alta", "media", "baja"];
+const DEFAULT_PRIORITY = "media";
+
+// Lower rank is shown first. Tasks saved before priorities existed count as the default.
+function rank(task) {
+  const index = PRIORITIES.indexOf(task.priority);
+  return index === -1 ? PRIORITIES.indexOf(DEFAULT_PRIORITY) : index;
+}
 
 // Exit codes: 0 ok, 1 the task does not exist, 2 usage error.
 function run(argv, { stdout = process.stdout, stderr = process.stderr, env = process.env } = {}) {
@@ -10,13 +18,25 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
   const file = storePath(env);
 
   if (command === "add") {
-    const title = rest.join(" ").trim();
+    // --priority is only read as the last pair, so it never mixes into the title.
+    const flag = rest.indexOf("--priority");
+    if (flag !== -1 && flag !== rest.length - 2) {
+      stderr.write(`${USAGE}\n`);
+      return 2;
+    }
+    const raw = flag === -1 ? DEFAULT_PRIORITY : rest[flag + 1] ?? "";
+    const priority = raw.toLowerCase();
+    const title = rest.slice(0, flag === -1 ? rest.length : flag).join(" ").trim();
     if (!title) {
       stderr.write(`${USAGE}\n`);
       return 2;
     }
+    if (!PRIORITIES.includes(priority)) {
+      stderr.write(`prioridad no válida "${raw}": usa alta, media o baja\n`);
+      return 2;
+    }
     const data = load(file);
-    const task = { id: data.nextId, title, done: false };
+    const task = { id: data.nextId, title, done: false, priority };
     data.nextId += 1;
     data.tasks.push(task);
     save(file, data);
@@ -26,7 +46,9 @@ function run(argv, { stdout = process.stdout, stderr = process.stderr, env = pro
 
   if (command === "list") {
     const data = load(file);
-    for (const task of data.tasks) {
+    // Array sort is stable, so tasks keep creation order within a priority.
+    const tasks = [...data.tasks].sort((a, b) => rank(a) - rank(b));
+    for (const task of tasks) {
       stdout.write(`${task.done ? "[x]" : "[ ]"} ${task.id} ${task.title}\n`);
     }
     return 0;
diff --git a/test/cli.js b/test/cli.js
index 0ddacaa..382e963 100644
--- a/test/cli.js
+++ b/test/cli.js
@@ -43,3 +43,71 @@ test("unknown task and usage errors", () => {
   assert.equal(tasks("add").status, 2);
   assert.equal(tasks("borrar").status, 2);
 });
+
+test("list shows higher priority first and keeps creation order within a priority", () => {
+  const tasks = session();
+  tasks("add", "regar", "--priority", "baja");
+  tasks("add", "comprar", "pan", "--priority", "alta");
+  tasks("add", "llamar", "--priority", "media");
+  tasks("add", "pagar", "--priority", "alta");
+  assert.equal(
+    tasks("list").out,
+    "[ ] 2 comprar pan\n[ ] 4 pagar\n[ ] 3 llamar\n[ ] 1 regar\n",
+  );
+});
+
+test("a task without --priority is media", () => {
+  const tasks = session();
+  tasks("add", "sin prioridad");
+  tasks("add", "urgente", "--priority", "alta");
+  tasks("add", "despues", "--priority", "baja");
+  assert.equal(
+    tasks("list").out,
+    "[ ] 2 urgente\n[ ] 1 sin prioridad\n[ ] 3 despues\n",
+  );
+});
+
+test("--priority accepts any letter case", () => {
+  const tasks = session();
+  assert.equal(tasks("add", "regar", "--priority", "ALTA").status, 0);
+  tasks("add", "fregar");
+  assert.equal(tasks("list").out, "[ ] 1 regar\n[ ] 2 fregar\n");
+});
+
+test("an invalid or missing --priority value is a usage error and saves nothing", () => {
+  const tasks = session();
+  const bad = tasks("add", "regar", "--priority", "urgente");
+  assert.equal(bad.status, 2);
+  assert.equal(bad.out, "");
+  assert.match(bad.err, /urgente/);
+  assert.equal(tasks("add", "regar", "--priority").status, 2);
+  assert.equal(tasks("list").out, "");
+});
+
+test("done tasks stay in their priority position", () => {
+  const tasks = session();
+  tasks("add", "regar", "--priority", "baja");
+  tasks("add", "pagar", "--priority", "alta");
+  tasks("done", "2");
+  assert.equal(tasks("list").out, "[x] 2 pagar\n[ ] 1 regar\n");
+});
+
+test("files saved before priorities existed list as media", () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "tasks-"));
+  const file = path.join(dir, "tasks.json");
+  fs.writeFileSync(
+    file,
+    JSON.stringify({
+      nextId: 3,
+      tasks: [
+        { id: 1, title: "antigua", done: false },
+        { id: 2, title: "nueva", done: false, priority: "alta" },
+      ],
+    }),
+  );
+  const env = { TASKS_FILE: file };
+  let out = "";
+  const status = run(["list"], { env, stdout: { write: (text) => { out += text; } } });
+  assert.equal(status, 0);
+  assert.equal(out, "[ ] 2 nueva\n[ ] 1 antigua\n");
+});
