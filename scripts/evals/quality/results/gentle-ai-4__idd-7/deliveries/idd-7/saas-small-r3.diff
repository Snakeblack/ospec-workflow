diff --git a/test/app.js b/test/app.js
index 9815af7..25cd641 100644
--- a/test/app.js
+++ b/test/app.js
@@ -31,3 +31,62 @@ test("other users cannot read a note", () => {
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/notes" }).status, 401);
 });
+
+test("an owner shares a note with a colleague who can list and read it", () => {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Compartida" } }).body;
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } }).status, 200);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: bruno }).body.map((note) => note.id), [id]);
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: bruno }).status, 200);
+});
+
+test("sharing twice with the same colleague is idempotent", () => {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Una vez" } }).body;
+  app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } });
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } }).status, 200);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: bruno }).body.map((note) => note.id), [id]);
+});
+
+test("a colleague can read a shared note but cannot edit or delete it", () => {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Solo lectura" } }).body;
+  app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u2" } });
+  assert.equal(app.handle({ method: "PUT", path: `/notes/${id}`, user: bruno, body: { title: "Cambio" } }).status, 403);
+  assert.equal(app.handle({ method: "DELETE", path: `/notes/${id}`, user: bruno }).status, 403);
+});
+
+test("only the owner can share a note", () => {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Mía" } }).body;
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: bruno, body: { userId: "u3" } }).status, 403);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: { id: "u3", tenantId: "acme" } }).body, []);
+});
+
+test("sharing requires a userId", () => {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Sin destinatario" } }).body;
+  const response = app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: {} });
+  assert.equal(response.status, 400);
+  assert.equal(response.body.error, "user-required");
+});
+
+test("sharing with an unknown user or another organization grants no access", () => {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Cerrada" } }).body;
+  const unknown = app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u404" } });
+  assert.equal(unknown.status, 404);
+  assert.equal(unknown.body.error, "user-not-found");
+  const otherOrg = app.handle({ method: "POST", path: `/notes/${id}/share`, user: ana, body: { userId: "u9" } });
+  assert.equal(otherOrg.status, 404);
+  assert.equal(otherOrg.body.error, "user-not-found");
+  assert.equal(app.handle({ method: "GET", path: `/notes/${id}`, user: zoe }).status, 404);
+  assert.deepEqual(app.handle({ method: "GET", path: "/notes", user: zoe }).body, []);
+});
+
+test("sharing a note of another owner or a missing note is refused", () => {
+  const app = createApp();
+  const { id } = app.handle({ method: "POST", path: "/notes", user: ana, body: { title: "Ajena" } }).body;
+  assert.equal(app.handle({ method: "POST", path: `/notes/${id}/share`, user: zoe, body: { userId: "u2" } }).status, 404);
+  assert.equal(app.handle({ method: "POST", path: "/notes/n999/share", user: ana, body: { userId: "u2" } }).status, 404);
+});
