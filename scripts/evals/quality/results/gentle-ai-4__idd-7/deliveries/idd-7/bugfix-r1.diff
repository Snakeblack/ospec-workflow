diff --git a/src/paginate.js b/src/paginate.js
index ed94097..6488ae1 100644
--- a/src/paginate.js
+++ b/src/paginate.js
@@ -8,9 +8,13 @@
  * @returns {{ page: number, pageSize: number, totalPages: number, items: Array }}
  */
 function paginate(items, page, pageSize = 10) {
-  const totalPages = Math.floor(items.length / pageSize) + 1;
-  const start = (page - 1) * pageSize;
-  return { page, pageSize, totalPages, items: items.slice(start, start + pageSize) };
+  if (!(pageSize >= 1)) {
+    throw new RangeError(`pageSize must be at least 1, got ${pageSize}`);
+  }
+  const current = page < 1 ? 1 : page;
+  const totalPages = Math.ceil(items.length / pageSize);
+  const start = (current - 1) * pageSize;
+  return { page: current, pageSize, totalPages, items: items.slice(start, start + pageSize) };
 }
 
 module.exports = { paginate };
diff --git a/test/paginate.js b/test/paginate.js
index 6989bee..69ae326 100644
--- a/test/paginate.js
+++ b/test/paginate.js
@@ -21,3 +21,36 @@ test("partial last page", () => {
 test("catalog lists ten products per page", () => {
   assert.equal(listProducts(2).items[0].id, 11);
 });
+
+test("total pages is the ceiling of items over page size", () => {
+  const twenty = Array.from({ length: 20 }, (_, index) => index + 1);
+  assert.equal(paginate(twenty, 1, 10).totalPages, 2);
+  assert.equal(paginate(items, 1, 10).totalPages, 3);
+});
+
+test("page below 1 is served as page 1", () => {
+  const first = paginate(items, 1, 10);
+  for (const page of [0, -3]) {
+    const result = paginate(items, page, 10);
+    assert.equal(result.page, 1);
+    assert.deepEqual(result.items, first.items);
+  }
+});
+
+test("empty list has zero pages", () => {
+  const result = paginate([], 1, 10);
+  assert.equal(result.totalPages, 0);
+  assert.deepEqual(result.items, []);
+});
+
+test("page size below 1 throws RangeError", () => {
+  assert.throws(() => paginate(items, 1, 0), RangeError);
+  assert.throws(() => paginate(items, 1, -5), RangeError);
+});
+
+test("page beyond the last keeps correct totalPages with no items", () => {
+  const result = paginate(items, 99, 10);
+  assert.equal(result.page, 99);
+  assert.equal(result.totalPages, 3);
+  assert.deepEqual(result.items, []);
+});
