diff --git a/test/app.js b/test/app.js
index 53195a1..1c26cb9 100644
--- a/test/app.js
+++ b/test/app.js
@@ -22,4 +22,48 @@ test("rooms of another organization are missing", () => {
 
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/rooms" }).status, 401);
+  assert.equal(createApp().handle({ method: "POST", path: "/bookings", body: { roomId: "r1" } }).status, 401);
+  assert.equal(createApp().handle({ method: "GET", path: "/rooms/r1/bookings" }).status, 401);
+});
+
+test("users can book a room and view its bookings", () => {
+  const app = createApp();
+  assert.deepEqual(app.handle({ method: "GET", path: "/rooms/r1/bookings", user: ana }).body, []);
+
+  const booking = {
+    roomId: "r1",
+    start: "2026-11-03T10:00:00Z",
+    end: "2026-11-03T11:00:00Z",
+  };
+  const res = app.handle({ method: "POST", path: "/bookings", user: ana, body: booking });
+  assert.equal(res.status, 201);
+  assert.deepEqual(res.body, booking);
+
+  const list = app.handle({ method: "GET", path: "/rooms/r1/bookings", user: ana });
+  assert.equal(list.status, 200);
+  assert.deepEqual(list.body, [booking]);
+});
+
+test("bookings of another organization cannot be created or viewed", () => {
+  const app = createApp();
+  const res = app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: zoe,
+    body: { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" },
+  });
+  assert.equal(res.status, 404);
+  assert.equal(app.handle({ method: "GET", path: "/rooms/r1/bookings", user: zoe }).status, 404);
+});
+
+test("bookings are segregated by room", () => {
+  const app = createApp();
+  const booking1 = { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" };
+  const booking2 = { roomId: "r2", start: "2026-11-03T12:00:00Z", end: "2026-11-03T13:00:00Z" };
+
+  app.handle({ method: "POST", path: "/bookings", user: ana, body: booking1 });
+  app.handle({ method: "POST", path: "/bookings", user: ana, body: booking2 });
+
+  assert.deepEqual(app.handle({ method: "GET", path: "/rooms/r1/bookings", user: ana }).body, [booking1]);
+  assert.deepEqual(app.handle({ method: "GET", path: "/rooms/r2/bookings", user: ana }).body, [booking2]);
 });
