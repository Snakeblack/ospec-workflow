 // Tenant isolation: a room from another organization is reported as missing (404).
-function createApp() {
-  function handle({ method, path, user }) {
+function createApp({ bookings: initialBookings = [] } = {}) {
+  const bookings = [...initialBookings];
+
+  function handle({ method, path, user, body }) {
     if (!user) return { status: 401, body: { error: "unauthenticated" } };
 
     if (path === "/rooms" && method === "GET") {
@@ -20,6 +22,26 @@ function createApp() {
       return { status: 200, body: { ...room } };
     }
 
+    const bookingsMatch = /^\/rooms\/([^/]+)\/bookings$/.exec(path);
+    if (bookingsMatch && method === "GET") {
+      const room = findRoom(bookingsMatch[1]);
+      if (!room || room.tenantId !== user.tenantId) return { status: 404, body: { error: "not-found" } };
+      return {
+        status: 200,
+        body: bookings.filter((b) => b.roomId === room.id).map((b) => ({ ...b })),
+      };
+    }
+
+    if (path === "/bookings" && method === "POST") {
+      const room = body && body.roomId ? findRoom(body.roomId) : null;
+      if (!room || room.tenantId !== user.tenantId) {
+        return { status: 404, body: { error: "not-found" } };
+      }
+      const booking = { ...body };
+      bookings.push(booking);
+      return { status: 201, body: { ...booking } };
+    }
+
     return { status: 404, body: { error: "not-found" } };
   }
 
diff --git a/test/app.js b/test/app.js
index 53195a1..5f99161 100644
--- a/test/app.js
+++ b/test/app.js
@@ -23,3 +23,64 @@ test("rooms of another organization are missing", () => {
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/rooms" }).status, 401);
 });
+
+test("users can book a room and view room bookings", () => {
+  const app = createApp();
+  const booking1 = { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" };
+  const res1 = app.handle({ method: "POST", path: "/bookings", user: ana, body: booking1 });
+  assert.equal(res1.status, 201);
+  assert.deepEqual(res1.body, booking1);
+
+  const booking2 = { roomId: "r1", start: "2026-11-03T14:00:00Z", end: "2026-11-03T15:00:00Z" };
+  const res2 = app.handle({ method: "POST", path: "/bookings", user: ana, body: booking2 });
+  assert.equal(res2.status, 201);
+  assert.deepEqual(res2.body, booking2);
+
+  const bookings = app.handle({ method: "GET", path: "/rooms/r1/bookings", user: ana });
+  assert.equal(bookings.status, 200);
+  assert.deepEqual(bookings.body, [booking1, booking2]);
+
+  // Another room in same tenant has no bookings yet
+  assert.deepEqual(app.handle({ method: "GET", path: "/rooms/r2/bookings", user: ana }).body, []);
+});
+
+test("booking endpoints enforce tenant isolation", () => {
+  const app = createApp();
+  const booking = { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" };
+  app.handle({ method: "POST", path: "/bookings", user: ana, body: booking });
+
+  // User from globex cannot view bookings of acme room
+  assert.equal(app.handle({ method: "GET", path: "/rooms/r1/bookings", user: zoe }).status, 404);
+
+  // User from globex cannot book acme room
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: zoe, body: booking }).status, 404);
+
+  // User from acme cannot view bookings or book globex room
+  assert.equal(app.handle({ method: "GET", path: "/rooms/r9/bookings", user: ana }).status, 404);
+  assert.equal(
+    app.handle({
+      method: "POST",
+      path: "/bookings",
+      user: ana,
+      body: { roomId: "r9", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" },
+    }).status,
+    404
+  );
+});
+
+test("booking requests without user or with nonexistent room are rejected", () => {
+  const app = createApp();
+  assert.equal(app.handle({ method: "POST", path: "/bookings", body: { roomId: "r1" } }).status, 401);
+  assert.equal(app.handle({ method: "GET", path: "/rooms/r1/bookings" }).status, 401);
+
+  assert.equal(
+    app.handle({
+      method: "POST",
+      path: "/bookings",
+      user: ana,
+      body: { roomId: "unknown", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" },
+    }).status,
+    404
+  );
+  assert.equal(app.handle({ method: "GET", path: "/rooms/unknown/bookings", user: ana }).status, 404);
+});
