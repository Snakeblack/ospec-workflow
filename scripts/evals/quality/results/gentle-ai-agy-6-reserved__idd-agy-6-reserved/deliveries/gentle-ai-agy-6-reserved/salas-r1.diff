diff --git a/test/app.js b/test/app.js
index 53195a1..4aa559c 100644
--- a/test/app.js
+++ b/test/app.js
@@ -22,4 +22,58 @@ test("rooms of another organization are missing", () => {
 
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/rooms" }).status, 401);
+  assert.equal(createApp().handle({ method: "POST", path: "/bookings", body: { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" } }).status, 401);
+  assert.equal(createApp().handle({ method: "GET", path: "/rooms/r1/bookings" }).status, 401);
+});
+
+test("users can book a room and view its bookings", () => {
+  const app = createApp();
+  const booking = { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" };
+  const createRes = app.handle({ method: "POST", path: "/bookings", user: ana, body: booking });
+  assert.equal(createRes.status, 201);
+  assert.deepEqual(createRes.body, booking);
+
+  const listRes = app.handle({ method: "GET", path: "/rooms/r1/bookings", user: ana });
+  assert.equal(listRes.status, 200);
+  assert.deepEqual(listRes.body, [booking]);
+});
+
+test("bookings are isolated by room", () => {
+  const app = createApp();
+  const b1 = { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" };
+  const b2 = { roomId: "r2", start: "2026-11-03T12:00:00Z", end: "2026-11-03T13:00:00Z" };
+
+  app.handle({ method: "POST", path: "/bookings", user: ana, body: b1 });
+  app.handle({ method: "POST", path: "/bookings", user: ana, body: b2 });
+
+  assert.deepEqual(app.handle({ method: "GET", path: "/rooms/r1/bookings", user: ana }).body, [b1]);
+  assert.deepEqual(app.handle({ method: "GET", path: "/rooms/r2/bookings", user: ana }).body, [b2]);
+});
+
+test("cannot book or view bookings of a room from another organization", () => {
+  const app = createApp();
+  const booking = { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" };
+  app.handle({ method: "POST", path: "/bookings", user: ana, body: booking });
+
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: zoe, body: booking }).status, 404);
+  assert.equal(app.handle({ method: "GET", path: "/rooms/r1/bookings", user: zoe }).status, 404);
+});
+
+test("booking or viewing bookings of a non-existent room returns 404", () => {
+  const app = createApp();
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: ana, body: { roomId: "unknown", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" } }).status, 404);
+  assert.equal(app.handle({ method: "GET", path: "/rooms/unknown/bookings", user: ana }).status, 404);
+});
+
+test("viewing bookings for a room with no bookings returns empty array", () => {
+  const app = createApp();
+  const res = app.handle({ method: "GET", path: "/rooms/r1/bookings", user: ana });
+  assert.equal(res.status, 200);
+  assert.deepEqual(res.body, []);
+});
+
+test("booking with missing fields returns 400", () => {
+  const app = createApp();
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: ana, body: null }).status, 400);
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: ana, body: { roomId: "r1" } }).status, 400);
 });
