diff --git a/test/app.js b/test/app.js
index 53195a1..32dd0a6 100644
--- a/test/app.js
+++ b/test/app.js
@@ -22,4 +22,120 @@ test("rooms of another organization are missing", () => {
 
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/rooms" }).status, 401);
+  assert.equal(createApp().handle({ method: "POST", path: "/bookings", body: { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" } }).status, 401);
+  assert.equal(createApp().handle({ method: "GET", path: "/rooms/r1/bookings" }).status, 401);
+});
+
+test("users book a room and view room bookings", () => {
+  const app = createApp();
+  const createRes = app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: ana,
+    body: { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" },
+  });
+  assert.equal(createRes.status, 201);
+  assert.equal(createRes.body.roomId, "r1");
+  assert.equal(createRes.body.start, "2026-11-03T10:00:00Z");
+  assert.equal(createRes.body.end, "2026-11-03T11:00:00Z");
+
+  const listRes = app.handle({
+    method: "GET",
+    path: "/rooms/r1/bookings",
+    user: ana,
+  });
+  assert.equal(listRes.status, 200);
+  assert.equal(listRes.body.length, 1);
+  assert.equal(listRes.body[0].roomId, "r1");
+  assert.equal(listRes.body[0].start, "2026-11-03T10:00:00Z");
+  assert.equal(listRes.body[0].end, "2026-11-03T11:00:00Z");
+});
+
+test("bookings respect tenant isolation", () => {
+  const app = createApp();
+  // r1 belongs to acme. Zoe is globex.
+  const createRes = app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: zoe,
+    body: { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" },
+  });
+  assert.equal(createRes.status, 404);
+
+  // Ana creates a booking on r1
+  app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: ana,
+    body: { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" },
+  });
+
+  // Zoe cannot see bookings for r1
+  const listRes = app.handle({
+    method: "GET",
+    path: "/rooms/r1/bookings",
+    user: zoe,
+  });
+  assert.equal(listRes.status, 404);
+});
+
+test("overlapping bookings for the same room are rejected", () => {
+  const app = createApp();
+  const first = app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: ana,
+    body: { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" },
+  });
+  assert.equal(first.status, 201);
+
+  // Overlapping
+  const overlap = app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: ana,
+    body: { roomId: "r1", start: "2026-11-03T10:30:00Z", end: "2026-11-03T11:30:00Z" },
+  });
+  assert.equal(overlap.status, 409);
+
+  // Non-overlapping on the same room succeeds
+  const nonOverlap = app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: ana,
+    body: { roomId: "r1", start: "2026-11-03T11:00:00Z", end: "2026-11-03T12:00:00Z" },
+  });
+  assert.equal(nonOverlap.status, 201);
+
+  const listRes = app.handle({
+    method: "GET",
+    path: "/rooms/r1/bookings",
+    user: ana,
+  });
+  assert.equal(listRes.status, 200);
+  assert.equal(listRes.body.length, 2);
+});
+
+test("bookings input validation", () => {
+  const app = createApp();
+  // Missing fields
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: ana, body: {} }).status, 400);
+
+  // Invalid date range (start >= end)
+  const invalid = app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: ana,
+    body: { roomId: "r1", start: "2026-11-03T12:00:00Z", end: "2026-11-03T11:00:00Z" },
+  });
+  assert.equal(invalid.status, 400);
+
+  // Non-existent room
+  const nonExistent = app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: ana,
+    body: { roomId: "r999", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" },
+  });
+  assert.equal(nonExistent.status, 404);
 });
