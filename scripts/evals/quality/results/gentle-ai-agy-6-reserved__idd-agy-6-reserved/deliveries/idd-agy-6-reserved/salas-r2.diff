diff --git a/test/app.js b/test/app.js
index 53195a1..7cc2cee 100644
--- a/test/app.js
+++ b/test/app.js
@@ -23,3 +23,64 @@ test("rooms of another organization are missing", () => {
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/rooms" }).status, 401);
 });
+
+test("users can create a booking and view bookings for a room", () => {
+  const app = createApp();
+  const res = app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: ana,
+    body: { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" },
+  });
+  assert.equal(res.status, 201);
+  assert.equal(res.body.roomId, "r1");
+  assert.equal(res.body.start, "2026-11-03T10:00:00Z");
+  assert.equal(res.body.end, "2026-11-03T11:00:00Z");
+  assert.ok(res.body.id);
+
+  const listRes = app.handle({ method: "GET", path: "/rooms/r1/bookings", user: ana });
+  assert.equal(listRes.status, 200);
+  assert.equal(listRes.body.length, 1);
+  assert.equal(listRes.body[0].roomId, "r1");
+  assert.equal(listRes.body[0].id, res.body.id);
+});
+
+test("cannot book or view bookings of a room from another organization", () => {
+  const app = createApp();
+  const postRes = app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: zoe,
+    body: { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" },
+  });
+  assert.equal(postRes.status, 404);
+
+  const getRes = app.handle({ method: "GET", path: "/rooms/r1/bookings", user: zoe });
+  assert.equal(getRes.status, 404);
+});
+
+test("cannot create overlapping bookings for the same room", () => {
+  const app = createApp();
+  const first = app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: ana,
+    body: { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" },
+  });
+  assert.equal(first.status, 201);
+
+  const overlap = app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: ana,
+    body: { roomId: "r1", start: "2026-11-03T10:30:00Z", end: "2026-11-03T11:30:00Z" },
+  });
+  assert.equal(overlap.status, 409);
+});
+
+test("rejects booking with invalid time range or missing fields", () => {
+  const app = createApp();
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: ana, body: { roomId: "r1", start: "invalid", end: "invalid" } }).status, 400);
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: ana, body: { roomId: "r1", start: "2026-11-03T12:00:00Z", end: "2026-11-03T11:00:00Z" } }).status, 400);
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: ana, body: { roomId: "r1" } }).status, 400);
+});
