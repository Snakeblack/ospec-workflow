diff --git a/test/app.js b/test/app.js
index 53195a1..61e193a 100644
--- a/test/app.js
+++ b/test/app.js
@@ -22,4 +22,74 @@ test("rooms of another organization are missing", () => {
 
 test("requests without user are rejected", () => {
   assert.equal(createApp().handle({ method: "GET", path: "/rooms" }).status, 401);
+  assert.equal(createApp().handle({ method: "POST", path: "/bookings", body: { roomId: "r1" } }).status, 401);
+  assert.equal(createApp().handle({ method: "GET", path: "/rooms/r1/bookings" }).status, 401);
+});
+
+test("users can book a room in their organization and list its bookings", () => {
+  const app = createApp();
+  const res = app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: ana,
+    body: { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" },
+  });
+  assert.equal(res.status, 201);
+  assert.equal(res.body.roomId, "r1");
+  assert.equal(res.body.start, "2026-11-03T10:00:00Z");
+  assert.equal(res.body.end, "2026-11-03T11:00:00Z");
+  assert.ok(res.body.id);
+
+  const listRes = app.handle({
+    method: "GET",
+    path: "/rooms/r1/bookings",
+    user: ana,
+  });
+  assert.equal(listRes.status, 200);
+  assert.equal(listRes.body.length, 1);
+  assert.equal(listRes.body[0].roomId, "r1");
+  assert.equal(listRes.body[0].start, "2026-11-03T10:00:00Z");
+  assert.equal(listRes.body[0].end, "2026-11-03T11:00:00Z");
+
+  const otherRoomList = app.handle({
+    method: "GET",
+    path: "/rooms/r2/bookings",
+    user: ana,
+  });
+  assert.equal(otherRoomList.status, 200);
+  assert.deepEqual(otherRoomList.body, []);
+});
+
+test("booking a room of another organization returns 404", () => {
+  const app = createApp();
+  const res = app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: zoe,
+    body: { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" },
+  });
+  assert.equal(res.status, 404);
+});
+
+test("listing bookings for a room of another organization returns 404", () => {
+  const app = createApp();
+  app.handle({
+    method: "POST",
+    path: "/bookings",
+    user: ana,
+    body: { roomId: "r1", start: "2026-11-03T10:00:00Z", end: "2026-11-03T11:00:00Z" },
+  });
+  const res = app.handle({
+    method: "GET",
+    path: "/rooms/r1/bookings",
+    user: zoe,
+  });
+  assert.equal(res.status, 404);
+});
+
+test("booking with missing fields returns 400", () => {
+  const app = createApp();
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: ana, body: null }).status, 400);
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: ana, body: { roomId: "r1" } }).status, 400);
+  assert.equal(app.handle({ method: "POST", path: "/bookings", user: ana, body: { roomId: "r1", start: "2026-11-03T10:00:00Z" } }).status, 400);
 });
