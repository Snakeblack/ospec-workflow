{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__OSPEC_RUNTIME__/scripts/hooks/ospec-codex-hook.js\" session-start",
            "commandWindows": "node \"__OSPEC_RUNTIME__\\scripts\\hooks\\ospec-codex-hook.js\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__OSPEC_RUNTIME__/scripts/hooks/ospec-codex-hook.js\" pre-tool-use",
            "commandWindows": "node \"__OSPEC_RUNTIME__\\scripts\\hooks\\ospec-codex-hook.js\" pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
