  "lenses": {
    "risk": {
      "selected": true,
      "status": "completed",
      "request_id": "start-risk-k21b",
      "result_digest": "sha256:4e67c0820f586ce7ede88fde675b5d831dae1bd4babf68138c71ea8ae8f4fbf6",
      "result": {
        "findings": [
          {
            "severity": "WARNING",
            "summary": "mintOperationPermit remains publicly reexported and can bypass the controlled issuer (no TransitionOffer+decision).",
            "acceptance_criteria": "Stop reexporting mintOperationPermit from the public kernel API (or hard-deprecate so callers cannot mint without issueOperationPermit); add a negative test that public mint without decision fails closed."
          },
          {
            "severity": "WARNING",
            "summary": "findReplayReceipt / exact-replay short-circuit matches only operation+subject_id, not digests/arguments required by design.",
            "acceptance_criteria": "Exact replay MUST bind arguments_digest (and other design digests); non-identical arguments MUST NOT short-circuit as replayed; add negative test."
          }
        ]
      },
      "operation": null,
      "result_request_id": "result-risk-k21b"
    },
    "reliability": {
      "selected": true,
      "status": "completed",
      "request_id": "start-reliability-k21b",
      "result_digest": "sha256:c1658ada72b6039fcbbb3d53b29ccb4fda005fef8c005b08f538fae778c713eb",
      "result": {
        "findings": [
          {
            "severity": "CRITICAL",
            "summary": "compareAndSwap awaits inner.commit before writing the authority bag; concurrent load/snapshot can observe advanced head without consume+receipt.",
            "acceptance_criteria": "Permit-authorized CAS MUST never expose load()/snapshot() with advanced state/journal lacking matching consumed permit+receipt; add an interleaving/observable-atomicity test."
          },
          {
            "severity": "WARNING",
            "summary": "Exact-replay does not validate arguments_digest/other digests before returning the prior OperationReceipt.",
            "acceptance_criteria": "Same permit/operation with different arguments MUST NOT short-circuit as exact replay; add negative test."
          },
          {
            "severity": "WARNING",
            "summary": "permit-reuse does not consult authority bag consumed status after findReplayReceipt misses.",
            "acceptance_criteria": "Bag-consumed without matching receipt MUST fail closed with permit-reuse (including after restart with empty issued Map); add test."
          },
          {
            "severity": "WARNING",
            "summary": "Restart recovery tests only assert load() after snapshot→initial; public runKernelOperation exact-replay after restart is unverified.",
            "acceptance_criteria": "After restart with empty issued ledger, runKernelOperation exact replay MUST return prior receipt without re-running effects; add test."
          }
        ]
      },
      "operation": null,
      "result_request_id": "result-reliability-k21b"
    },
    "resilience": {
      "selected": true,
      "status": "completed",
      "request_id": "start-resilience-k21b",
      "result_digest": "sha256:bcae83632df11291e34fd69a64576f98898c99b2eb8f088ec78ca99bdc4f9750",
      "result": {
        "findings": [
          {
            "severity": "CRITICAL",
            "summary": "Permit-authorized convergent CAS can return ok:true without writing consume+receipt into the authority bag; kernel may substitute an ephemeral pre-CAS receipt.",
            "acceptance_criteria": "Convergent permit-authorized CAS MUST co-write/verify consume+receipt in the bag or fail closed; callers MUST NOT see success with only an ephemeral receipt; add regression test."
          },
          {
            "severity": "CRITICAL",
            "summary": "inner.commit advances head before authority bag mutation with no rollback if bag write throws; orphan advanced state without consumed permit/receipt.",
            "acceptance_criteria": "Failed consume/bag write MUST NOT leave committed authoritative state without consumed permit+receipt; fail closed with intact head or transactional co-commit; add failure-injection test."
          },
          {
            "severity": "WARNING",
            "summary": "persistJournal ignores commitJournal ok:false and continues effects/CAS without durable mid-op barriers.",
            "acceptance_criteria": "commitJournal ok:false MUST block/fail closed before effects continue; add negative test for subject-not-found / journal-durability-required."
          }
        ]
      },
      "operation": null,
      "result_request_id": "result-resilience-k21b"
    },
    "readability": {
      "selected": true,
      "status": "completed",
      "request_id": "start-readability-k21b",
      "result_digest": "sha256:16487c2b91202c7aec3cb443d22f8898f08f90f5361bb1f094ff747cce3ddb58",
      "result": {
        "findings": [
          {
            "severity": "WARNING",
            "summary": "Name permitAuthorized is misleading: it is true whenever authorityCommit !== undefined, including null incomplete commits.",
            "acceptance_criteria": "Rename or document the sentinel clearly (e.g. authorityCommitProvided) so maintainers do not read it as authorization success."
          },
          {
            "severity": "WARNING",
            "summary": "Converged CAS branch returns bag receipt without a comment linking it to kernel exact-replay.",
            "acceptance_criteria": "Add a brief intent comment tying converged receipt materialization to findReplayReceipt / exact-replay contract."
          },
          {
            "severity": "WARNING",
            "summary": "Post-CAS committedReceipt cascade (cas || reload bag || local) has three arms with no justification comment.",
            "acceptance_criteria": "Document when each arm is allowed after ok CAS, or collapse to a single authoritative source to avoid wrong-fallback edits."
          },
          {
            "severity": "SUGGESTION",
            "summary": "issueOperationPermit operation fallback priority (offer then policy/human; kernelRule omitted) lacks a priority comment.",
            "acceptance_criteria": "Document operation resolution priority across decision kinds in issuer code."
          }
        ]
      },
      "operation": null,
      "result_request_id": "result-readability-k21b"
    }
  },
