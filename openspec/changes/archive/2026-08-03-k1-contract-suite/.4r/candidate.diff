+++ b/scripts/lib/contract-checkers/k1-emission.js
@@ -0,0 +1,92 @@
+"use strict";
+
+const fs = require("node:fs");
+const path = require("node:path");
+
+const CHECKER = "k1-emission";
+
+function toPosix(relativePath) {
+  return relativePath.split(path.sep).join("/");
+}
+
+function loadJson(filePath) {
+  return JSON.parse(fs.readFileSync(filePath, "utf8"));
+}
+
+/**
+ * REQ-contract-lint-009: claimed emitted fields/commands must appear in the
+ * emission allowlist beside builders.
+ *
+ * @param {{root: string}} ctx
+ */
+function check(ctx) {
+  const root = ctx.root;
+  const offenders = [];
+  const catalogRel = "scripts/lib/emission-catalogs/k1-emitted.json";
+  const claimsRel = "schemas/kernel/emission-claims.json";
+  const catalogPath = path.join(root, catalogRel);
+  const claimsPath = path.join(root, claimsRel);
+
+  let catalog;
+  try {
+    catalog = loadJson(catalogPath);
+  } catch (err) {
+    return [
+      {
+        checker: CHECKER,
+        path: catalogRel,
+        expected: "readable emission allowlist",
+        actual: err.message,
+        message: `${catalogRel} could not be read: ${err.message}`,
+      },
+    ];
+  }
+
+  let claims;
+  try {
+    claims = loadJson(claimsPath);
+  } catch (err) {
+    return [
+      {
+        checker: CHECKER,
+        path: claimsRel,
+        expected: "readable emission claims",
+        actual: err.message,
+        message: `${claimsRel} could not be read: ${err.message}`,
+      },
+    ];
+  }
+
+  const allowedFields = new Set(Array.isArray(catalog.fields) ? catalog.fields : []);
+  const allowedCommands = new Set(Array.isArray(catalog.commands) ? catalog.commands : []);
+  const claimedFields = Array.isArray(claims.claimed_fields) ? claims.claimed_fields : [];
+  const claimedCommands = Array.isArray(claims.claimed_commands) ? claims.claimed_commands : [];
+
+  for (const field of claimedFields) {
+    if (!allowedFields.has(field)) {
+      offenders.push({
+        checker: CHECKER,
+        path: claimsRel,
+        expected: `field "${field}" present in emission allowlist`,
+        actual: "not emitted by declared builders",
+        message: `claimed emitted field "${field}" is not in ${catalogRel}`,
+      });
+    }
+  }
+
+  for (const command of claimedCommands) {
+    if (!allowedCommands.has(command)) {
+      offenders.push({
+        checker: CHECKER,
+        path: claimsRel,
+        expected: `command "${command}" present in emission allowlist`,
+        actual: "not emitted by declared builders",
+        message: `claimed emitted command "${command}" is not in ${catalogRel}`,
+      });
+    }
+  }
+
+  return offenders;
+}
+
+module.exports = { check, toPosix };
