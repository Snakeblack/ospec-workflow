--- /dev/null
+++ b/scripts/lib/contract-checkers/k1-schema-compat.js
@@ -0,0 +1,97 @@
+"use strict";
+
+const fs = require("node:fs");
+const path = require("node:path");
+
+const CHECKER = "k1-schema-compat";
+
+function toPosix(relativePath) {
+  return relativePath.split(path.sep).join("/");
+}
+
+/**
+ * REQ-contract-lint-008: schema/$id/version presence + doc/fixture field claims
+ * that the referenced schema does not allow.
+ *
+ * @param {{root: string}} ctx
+ */
+function check(ctx) {
+  const root = ctx.root;
+  const offenders = [];
+  const manifestPath = path.join(root, "schemas", "kernel", "manifest.json");
+
+  let manifest;
+  try {
+    manifest = JSON.parse(fs.readFileSync(manifestPath, "utf8"));
+  } catch (err) {
+    return [
+      {
+        checker: CHECKER,
+        path: "schemas/kernel/manifest.json",
+        expected: "readable kernel manifest",
+        actual: err.message,
+        message: `schemas/kernel/manifest.json could not be read: ${err.message}`,
+      },
+    ];
+  }
+
+  const families = manifest.families || {};
+  for (const [family, entry] of Object.entries(families)) {
+    const rel = entry && entry.path ? entry.path : `schemas/kernel/${family}/v1.schema.json`;
+    const abs = path.join(root, rel);
+    let schema;
+    try {
+      schema = JSON.parse(fs.readFileSync(abs, "utf8"));
+    } catch (err) {
+      offenders.push({
+        checker: CHECKER,
+        path: toPosix(rel),
+        expected: "readable schema JSON with $id and schema_version",
+        actual: err.message,
+        message: `${toPosix(rel)} could not be read: ${err.message}`,
+      });
+      continue;
+    }
+
+    if (!schema.$id || typeof schema.$id !== "string") {
+      offenders.push({
+        checker: CHECKER,
+        path: toPosix(rel),
+        expected: "non-empty $id",
+        actual: JSON.stringify(schema.$id),
+        message: `${toPosix(rel)} is missing required $id`,
+      });
+    }
+    if (schema.schema_version == null) {
+      offenders.push({
+        checker: CHECKER,
+        path: toPosix(rel),
+        expected: "explicit schema_version",
+        actual: "undefined",
+        message: `${toPosix(rel)} is missing schema_version`,
+      });
+    }
+
+    const claimsPath = path.join(path.dirname(abs), "doc-field-claims.json");
+    if (fs.existsSync(claimsPath)) {
+      const claims = JSON.parse(fs.readFileSync(claimsPath, "utf8"));
+      const allowed = new Set(Object.keys((schema.properties && typeof schema.properties === "object") ? schema.properties : {}));
+      const claimed = Array.isArray(claims.required_fields) ? claims.required_fields : [];
+      for (const field of claimed) {
+        if (!allowed.has(field)) {
+          offenders.push({
+            checker: CHECKER,
+            path: toPosix(path.relative(root, claimsPath)),
+            expected: `field "${field}" allowed by schema ${family}`,
+            actual: `schema properties: ${[...allowed].join(", ") || "(none)"}`,
+            message: `doc/fixture claim names field "${field}" which schema ${family} does not allow`,
+          });
+        }
+      }
+    }
+  }
+
+  return offenders;
+}
+
+module.exports = { check };
