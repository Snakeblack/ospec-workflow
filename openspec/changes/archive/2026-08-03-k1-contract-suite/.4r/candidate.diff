+      families: {
+        classification: {
+          path: "schemas/kernel/classification/v1.schema.json",
+          $id: "ospec://schemas/kernel/classification/v1",
+          schema_version: 1,
+        },
+      },
+    })
+  );
+  fs.writeFileSync(
+    path.join(schemaDir, "v1.schema.json"),
+    JSON.stringify({ schema_version: 1, type: "object", properties: {} })
