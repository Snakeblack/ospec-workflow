new file mode 100644
--- /dev/null
+++ b/scripts/lib/transition-parity.js
@@ -0,0 +1,85 @@
+"use strict";
+
+const { stableSerialize } = require("./canonical-json.js");
+
+/**
+ * Extract material discriminants from a human projection or negotiated envelope.
+ *
+ * @param {object} surface
+ * @returns {{code: string, cause: string, next_action: object}}
+ */
+function extractDiscriminants(surface) {
+  if (!surface || typeof surface !== "object") {
+    throw new TypeError("surface must be an object");
+  }
+
+  const code =
+    surface.code ||
+    surface.reason_code ||
+    surface.reason ||
+    (surface.blocker && surface.blocker.code) ||
+    "";
+  const cause = surface.cause || (surface.blocker && surface.blocker.cause) || "";
+  const next =
+    surface.next_action ||
+    surface.next_transition ||
+    (surface.envelope && surface.envelope.next_transition) ||
+    {};
+
+  const next_action = {
+    kind: next.kind || "",
+    operation: next.operation || "",
+  };
+  if (next.kind === "execute" && typeof next.command === "string") {
+    next_action.command = next.command;
+  }
+
+  return { code: String(code), cause: String(cause), next_action };
+}
+
+/**
+ * Compare material discriminants between two surfaces.
+ *
+ * @param {object} left
+ * @param {object} right
+ * @returns {{ok: boolean, mismatches: Array<{field: string, left: *, right: *}>}}
+ */
+function compareParity(left, right) {
+  const a = normalize(left);
+  const b = normalize(right);
+  const mismatches = [];
+
+  if (a.code !== b.code) mismatches.push({ field: "code", left: a.code, right: b.code });
+  if (a.cause !== b.cause) mismatches.push({ field: "cause", left: a.cause, right: b.cause });
+  if (stableSerialize(a.next_action) !== stableSerialize(b.next_action)) {
+    mismatches.push({ field: "next_action", left: a.next_action, right: b.next_action });
+  }
+
+  return { ok: mismatches.length === 0, mismatches };
+}
+
+function normalize(value) {
+  if (value && value.next_action && !value.code && value.reason_code) {
+    return extractDiscriminants(value);
+  }
+  if (value && (value.reason_code || value.next_transition || value.human || value.envelope)) {
+    // already a surface — extract
+    if (value.code || value.reason_code || value.next_transition || value.next_action) {
+      if (!value.next_action && value.next_transition) {
+        return extractDiscriminants(value);
+      }
+    }
+  }
+  if (value && value.next_action && (value.code || value.cause)) {
+    const next_action = { ...value.next_action };
+    if (next_action.kind !== "execute") delete next_action.command;
+    return {
+      code: String(value.code || ""),
+      cause: String(value.cause || ""),
+      next_action,
+    };
+  }
+  return extractDiscriminants(value);
+}
+
+module.exports = { extractDiscriminants, compareParity };
