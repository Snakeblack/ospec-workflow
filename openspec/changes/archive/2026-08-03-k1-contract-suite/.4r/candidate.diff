+"use strict";
+
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const test = require("node:test");
+
+const ROOT = path.resolve(__dirname, "..", "..");
+
+const K1_LIB_FILES = [
+  "scripts/lib/canonical-json.js",
+  "scripts/lib/authority-canon.js",
+  "scripts/lib/kernel-schema-validator.js",
+  "scripts/lib/kernel-aliases.js",
+  "scripts/lib/change-classification.js",
+  "scripts/lib/next-transition.js",
+  "scripts/lib/transition-parity.js",
+  "scripts/lib/contract-checkers/k1-schema-compat.js",
+  "scripts/lib/contract-checkers/k1-emission.js",
+  "scripts/lib/contract-checkers/k1-prose-authority.js",
+  "scripts/lib/contract-checkers/k1-maturity.js",
+];
+
+test("K1 scope guard: no global lifecycle reducer module status→next_transition", () => {
+  const forbiddenNames = [
+    "lifecycle-reducer.js",
+    "status-next-transition-reducer.js",
+    "kernel-lifecycle-reducer.js",
+  ];
+  for (const name of forbiddenNames) {
+    assert.equal(
+      fs.existsSync(path.join(ROOT, "scripts", "lib", name)),
+      false,
+      `K1 must not introduce ${name}`
+    );
+  }
+
+  for (const rel of K1_LIB_FILES) {
+    const text = fs.readFileSync(path.join(ROOT, rel), "utf8");
+    assert.equal(
+      /function\s+reduceStatusToNextTransition|status\s*→\s*next_transition\s*reducer|executeAdaptiveRoute\s*\(/.test(
+        text
+      ),
+      false,
+      `${rel} must not implement lifecycle reducer / adaptive route execution`
+    );
+  }
+});
+
+test("K1 scope guard: fixed/default routing baselines in openspec/config.yaml unchanged by K1 modules", () => {
+  // K1 classifiers must not be required/imported by openspec/config.yaml routing.
+  const configText = fs.readFileSync(path.join(ROOT, "openspec", "config.yaml"), "utf8");
+  assert.equal(
+    /change-classification|classifyChange|hard_floor\.auth_security/.test(configText),
+    false,
+    "openspec/config.yaml must not wire K1 classifier into fixed routing"
+  );
+
+  for (const rel of ["scripts/lib/change-classification.js", "scripts/lib/route-dispatcher.js"]) {
+    if (!fs.existsSync(path.join(ROOT, rel))) continue;
+    const text = fs.readFileSync(path.join(ROOT, rel), "utf8");
+    if (rel.endsWith("change-classification.js")) {
+      assert.equal(
+        /require\(["'].*route-dispatcher|writeFileSync\(["'].*config\.yaml/.test(text),
+        false,
+        "classifier must not mutate routing baselines"
+      );
+    }
+    if (rel.endsWith("route-dispatcher.js")) {
+      assert.equal(
+        /require\(["'].*change-classification/.test(text),
+        false,
+        "route-dispatcher must not import K1 classifier"
+      );
+    }
+  }
+});
