+++ b/scripts/lib/contract-checkers/k1-prose-authority.js
@@ -0,0 +1,87 @@
+"use strict";
+
+const fs = require("node:fs");
+const path = require("node:path");
+
+const CHECKER = "k1-prose-authority";
+
+const SCOPED_RELATIVE_PATHS = [
+  "docs/architecture/harness-evolution.md",
+  "schemas/kernel/prose-authority-claims.md",
+];
+
+const PROSE_FALLBACK_PATTERNS = [
+  /infer\s+(?:a\s+|the\s+)?missing\s+(?:structured\s+)?(?:field|transition|reason)[^\n.]{0,80}from\s+prose/i,
+  /fallback\s+to\s+(?:free-?form\s+)?prose/i,
+  /interpret(?:ing)?\s+free-?form\s+prose\s+as\s+authority/i,
+  /obtain(?:s|ing)?\s+(?:its\s+)?decision\s+by\s+interpreting\s+(?:free-?form\s+)?prose/i,
+];
+
+const GRAPH_IR_IMPLEMENTED_PATTERNS = [
+  /Graph\s+IR[^\n]{0,120}independent\s+authority[^\n]{0,80}\{implemented\}/i,
+  /\{implemented\}[^\n]{0,120}Graph\s+IR[^\n]{0,80}(?:as\s+)?independent\s+authority/i,
+  /Graph\s+IR\s+independent\s+authority\s+is\s+implemented/i,
+];
+
+function toPosix(relativePath) {
+  return relativePath.split(path.sep).join("/");
+}
+
+/**
+ * REQ-contract-lint-010: reject prose-authority fallback guidance and Graph IR
+ * independent authority tagged/claimed as implemented.
+ *
+ * @param {{root: string}} ctx
+ */
+function check(ctx) {
+  const root = ctx.root;
+  const offenders = [];
+
+  for (const rel of SCOPED_RELATIVE_PATHS) {
+    const abs = path.join(root, rel);
+    if (!fs.existsSync(abs)) continue;
+    let text;
+    try {
+      text = fs.readFileSync(abs, "utf8");
+    } catch (err) {
+      offenders.push({
+        checker: CHECKER,
+        path: toPosix(rel),
+        expected: "readable scoped authority doc",
+        actual: err.message,
+        message: `${toPosix(rel)} could not be read: ${err.message}`,
+      });
+      continue;
+    }
+
+    for (const pattern of PROSE_FALLBACK_PATTERNS) {
+      if (pattern.test(text)) {
+        offenders.push({
+          checker: CHECKER,
+          path: toPosix(rel),
+          expected: "structured-only authority guidance",
+          actual: "prose fallback instruction",
+          message: `${toPosix(rel)} instructs an authority operation to fall back to prose`,
+        });
+        break;
+      }
+    }
+
+    for (const pattern of GRAPH_IR_IMPLEMENTED_PATTERNS) {
+      if (pattern.test(text)) {
+        offenders.push({
+          checker: CHECKER,
+          path: toPosix(rel),
+          expected: "Graph IR independent authority tagged target|experimental",
+          actual: "implemented",
+          message: `${toPosix(rel)} labels Graph IR independent authority as implemented`,
+        });
+        break;
+      }
+    }
+  }
+
+  return offenders;
+}
+
+module.exports = { check, SCOPED_RELATIVE_PATHS };
