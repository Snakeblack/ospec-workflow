+  fs.writeFileSync(
+    path.join(schemaDir, "v1.schema.json"),
+    JSON.stringify({
+      $id: "ospec://schemas/kernel/classification/v1",
+      schema_version: 1,
+      type: "object",
+      properties: { route: { type: "string" } },
+    })
+  );
+  fs.writeFileSync(
+    path.join(schemaDir, "doc-field-claims.json"),
+    JSON.stringify({ required_fields: ["not_in_schema"] })
+  );
+
+  const offenders = check({ root });
+  assert.equal(offenders.length, 1);
+  assert.match(offenders[0].message, /not_in_schema/);
+});
