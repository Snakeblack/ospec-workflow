@@ -0,0 +1,38 @@
+"use strict";
+
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const test = require("node:test");
+
+const { check } = require("./k1-emission.js");
+
+const ROOT = path.resolve(__dirname, "..", "..", "..");
+
+test("k1-emission passes when claims only name allowlisted emissions", () => {
+  assert.deepEqual(check({ root: ROOT }), []);
+});
+
+test("named command not emitted by code is an offender", (t) => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "k1-emission-"));
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
+
+  fs.mkdirSync(path.join(root, "scripts", "lib", "emission-catalogs"), { recursive: true });
+  fs.mkdirSync(path.join(root, "schemas", "kernel"), { recursive: true });
+  fs.writeFileSync(
+    path.join(root, "scripts", "lib", "emission-catalogs", "k1-emitted.json"),
+    JSON.stringify({ fields: ["route"], commands: ["ospec kernel repair-node"] })
+  );
+  fs.writeFileSync(
+    path.join(root, "schemas", "kernel", "emission-claims.json"),
+    JSON.stringify({
+      claimed_fields: ["route", "unemitted_field"],
+      claimed_commands: ["ospec kernel invent-me"],
+    })
+  );
+
+  const offenders = check({ root });
+  assert.ok(offenders.some((o) => /unemitted_field/.test(o.message)));
+  assert.ok(offenders.some((o) => /invent-me/.test(o.message)));
+});
