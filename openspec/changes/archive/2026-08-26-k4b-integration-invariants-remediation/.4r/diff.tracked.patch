+    assert.equal(result.ok, false, `expected malformed fail for: ${patch.slice(0, 40)}`);
+    assert.equal(result.reason_code, "MALFORMED_UNIFIED_DIFF");
+    assert.equal(result.candidate, undefined);
+  }
+});
