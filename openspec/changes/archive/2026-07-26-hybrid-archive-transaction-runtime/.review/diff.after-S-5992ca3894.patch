+  try {
+    const raw = await fsx.readFile(p, "utf8");
+    return JSON.parse(raw);
+  } catch (err) {
+    if (err.code === "ENOENT") {
+      return { state: "init", plan_sha256: null, created_by_tx: [] };
+    }
+    throw err;
+  }
+}
+
+async function writeJournal(txDir, journal, fsx) {
