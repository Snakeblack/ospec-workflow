+  // B: fail after spec overwrite — retain .bak; rollback restores baseline.
+  const b = await buildWorkspace(t);
+  const bSpec = path.join(b.root, "openspec", "specs", "routing", "spec.md");
+  const bOrig = await fs.readFile(bSpec, "utf8");
