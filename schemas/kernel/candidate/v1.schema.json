{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ospec://schemas/kernel/candidate/v1",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_id": {
      "type": "string"
    },
    "projection": {
      "type": "string",
      "enum": [
        "workspace",
        "staged"
      ]
    },
    "base_tree": {
      "type": "string"
    },
    "candidate_tree": {
      "type": "string"
    },
    "diff_hash": {
      "type": "string"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repository_id": {
      "type": "string"
    },
    "changed_paths_modes_digest": {
      "type": "string"
    },
    "intended_untracked_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "predecessor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "relation": {
      "type": "string",
      "enum": [
        "exact",
        "changed",
        "ambiguous",
        "unknown"
      ]
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "projection",
    "base_tree",
    "candidate_tree",
    "diff_hash",
    "paths"
  ],
  "additionalProperties": false
}
