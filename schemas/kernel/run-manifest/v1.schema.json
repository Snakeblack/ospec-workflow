{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ospec://schemas/kernel/run-manifest/v1",
  "title": "RunManifestV1",
  "description": "Kernel RunManifest Schema v1 recording a derived K12 corpus execution measurement.",
  "type": "object",
  "schema_version": 1,
  "required": [
    "schema_version",
    "run_id",
    "cohort_id",
    "fixture_id",
    "stratum",
    "policy",
    "repetition_index",
    "repetitions_total",
    "order_seed",
    "worktree_path",
    "cache_namespace",
    "evaluator",
    "host",
    "catalog_digest",
    "outcome",
    "versions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "cohort_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "stratum": {
      "type": "string",
      "enum": ["local-reversible", "behavior-repair", "multi-module", "adversarial"]
    },
    "policy": {
      "type": "string",
      "enum": ["fixed"]
    },
    "repetition_index": {
      "type": "integer",
      "minimum": 0
    },
    "repetitions_total": {
      "type": "integer",
      "minimum": 1
    },
    "order_seed": {
      "type": "string",
      "minLength": 1
    },
    "worktree_path": {
      "type": "string",
      "minLength": 1
    },
    "cache_namespace": {
      "type": "string",
      "minLength": 1
    },
    "evaluator": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "incomplete", "excluded"]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "required": ["runner_version"],
      "properties": {
        "runner_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
