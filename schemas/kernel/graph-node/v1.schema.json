{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ospec://schemas/kernel/graph-node/v1",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "node_id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "description": "Legacy v1 alias retained for existing consumers; canonical semantic nodes use dependencies.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ownership": {
      "$ref": "#/$defs/ownership"
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget_ref": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "operation"
  ],
  "additionalProperties": false,
  "if": {
    "required": [
      "objective"
    ]
  },
  "then": {
    "required": [
      "dependencies",
      "ownership",
      "allowed_paths",
      "invariants",
      "required_evidence",
      "budget_ref"
    ]
  },
  "$defs": {
    "ownership": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "exclusive",
            "shared"
          ]
        }
      },
      "required": [
        "owner",
        "mode"
      ],
      "additionalProperties": false
    }
  }
}
