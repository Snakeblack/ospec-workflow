{
  "name": "ospec-workflow",
  "version": "2.119.1",
  "private": true,
  "description": "Impact-driven development (IDD) workflow: the ospec CLI derives each change's obligations from its impact and closes it on observed evidence, with strict TDD, bounded review, hooks, and an optional Spec-Driven Development (SDD) mode with OpenSpec.",
  "license": "MIT",
  "author": {
    "name": "Manuel Michael Retamozo García"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/snakeblack/ospec-workflow.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/check.js",
    "build:claude": "node scripts/configure/claude-marketplace.js",
    "setup:claude": "node scripts/configure/install-claude.js",
    "setup:claude:sdd": "node scripts/configure/install-claude.js --with-sdd",
    "setup:claude:no-sdd": "node scripts/configure/install-claude.js --no-sdd",
    "reload:claude": "node scripts/configure/install-claude.js --build-only",
    "build:copilot": "node scripts/configure/cli.js --target github-copilot --out dist/github-copilot",
    "setup:copilot": "node scripts/configure/install-global-copilot.js",
    "setup:copilot:sdd": "node scripts/configure/install-global-copilot.js --with-sdd",
    "setup:copilot:no-sdd": "node scripts/configure/install-global-copilot.js --no-sdd",
    "reload:copilot": "node scripts/configure/install-global-copilot.js",
    "build:opencode": "node scripts/configure/cli.js --target opencode --out dist/opencode",
    "setup:opencode": "node scripts/configure/install-global-opencode.js",
    "setup:opencode:sdd": "node scripts/configure/install-global-opencode.js --with-sdd",
    "setup:opencode:no-sdd": "node scripts/configure/install-global-opencode.js --no-sdd",
    "reload:opencode": "node scripts/configure/install-global-opencode.js",
    "build:codex": "node scripts/configure/cli.js --target codex --out dist/codex",
    "setup:codex": "node scripts/configure/install-codex.js",
    "setup:codex:sdd": "node scripts/configure/install-codex.js --with-sdd",
    "setup:codex:no-sdd": "node scripts/configure/install-codex.js --no-sdd",
    "setup:codex:repair": "node scripts/configure/install-codex.js --repair-config",
    "install:codex": "node scripts/configure/install-codex.js",
    "build:vscode": "node scripts/configure/cli.js --target vscode --out dist/vscode",
    "setup:vscode": "node scripts/configure/install-vscode.js",
    "setup:vscode:sdd": "node scripts/configure/install-vscode.js --with-sdd",
    "setup:vscode:no-sdd": "node scripts/configure/install-vscode.js --no-sdd",
    "reload:vscode": "node scripts/configure/install-vscode.js",
    "build:cursor": "node scripts/configure/cli.js --target cursor --out dist/cursor",
    "setup:cursor": "node scripts/configure/install-cursor.js",
    "setup:cursor:sdd": "node scripts/configure/install-cursor.js --with-sdd",
    "setup:cursor:no-sdd": "node scripts/configure/install-cursor.js --no-sdd",
    "reload:cursor": "node scripts/configure/install-cursor.js",
    "install:opencode": "node scripts/configure/install-target.js opencode",
    "install:copilot": "node scripts/configure/install-target.js github-copilot",
    "install:global:opencode": "node scripts/configure/install-global-opencode.js",
    "install:global:copilot": "node scripts/configure/install-global-copilot.js",
    "build:antigravity": "node scripts/configure/cli.js --target antigravity --out dist/antigravity",
    "setup:antigravity": "node scripts/configure/install-antigravity.js",
    "setup:antigravity:sdd": "node scripts/configure/install-antigravity.js --with-sdd",
    "setup:antigravity:no-sdd": "node scripts/configure/install-antigravity.js --no-sdd",
    "reload:antigravity": "node scripts/configure/install-antigravity.js",
    "setup:tui": "go run ./cmd/ospec-install",
    "build:hooks": "node -e \"const r = require('./scripts/configure/install-target.js').ensureRuntimeBinary(process.cwd()); if (!r) process.exit(1);\"",
    "ensure:hooks": "npm run build:hooks",
    "setup:git-hooks": "node scripts/setup-git-hooks.js"
  }
}
