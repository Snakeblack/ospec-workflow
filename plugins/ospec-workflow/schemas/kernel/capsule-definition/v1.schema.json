{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ospec://schemas/kernel/capsule-definition/v1",
  "title": "CapsuleDefinitionV1",
  "description": "Work-Order Capsule Definition Schema v1 declaring minimal projected dependencies and sandboxed execution boundaries.",
  "type": "object",
  "schema_version": 1,
  "required": [
    "schema_version",
    "capsule_id",
    "fingerprint",
    "source_snapshot_id",
    "dependencies",
    "allowed_paths",
    "environment"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "capsule_id": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "capsule_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
