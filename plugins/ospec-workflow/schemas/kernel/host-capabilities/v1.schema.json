{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ospec://schemas/kernel/host-capabilities/v1",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "host-capabilities/v1"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "enforced",
          "partial",
          "instructional",
          "unavailable"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "capabilities"
  ],
  "additionalProperties": false
}
