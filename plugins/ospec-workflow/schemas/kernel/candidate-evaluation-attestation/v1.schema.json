{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ospec://schemas/kernel/candidate-evaluation-attestation/v1",
  "title": "CandidateEvaluationAttestationV1",
  "description": "Kernel CandidateEvaluationAttestation v1 binding a frozen Candidate to contract, graph, evidence root, frozen findings, and an effective PolicySnapshot digest. It declares evaluation approval only; it never authorizes delivery.",
  "type": "object",
  "schema_version": 1,
  "required": [
    "schema_version",
    "kind",
    "attestation_id",
    "candidate_id",
    "contract_digest",
    "graph_digest",
    "evidence_root_digest",
    "findings_digest",
    "policy_digest",
    "expected_revision",
    "authority_revision",
    "issuer_version",
    "runtime_version",
    "outcome",
    "valid_for",
    "issued_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "enum": ["candidate-evaluation-attestation"] },
    "attestation_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "candidate_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "contract_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "graph_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidence_root_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "findings_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "policy_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "expected_revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "authority_revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "issuer_version": { "type": "string", "minLength": 1 },
    "runtime_version": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "enum": ["approved-for-evaluation"] },
    "valid_for": { "type": "string", "enum": ["evaluation"] },
    "issued_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
