{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ospec://schemas/kernel/finding-review/v1",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "finding_id": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "BLOCKER",
        "CRITICAL",
        "WARNING",
        "INFO"
      ]
    },
    "dimension": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "blocking": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "finding_id",
    "severity",
    "dimension",
    "summary",
    "blocking"
  ],
  "additionalProperties": false
}
