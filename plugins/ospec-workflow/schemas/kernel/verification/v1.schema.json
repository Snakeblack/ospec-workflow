{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ospec://schemas/kernel/verification/v1",
  "schema_version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "verification_id": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "PASS WITH WARNINGS",
        "FAIL"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "verification_id",
    "candidate_id",
    "verdict"
  ],
  "additionalProperties": false
}
