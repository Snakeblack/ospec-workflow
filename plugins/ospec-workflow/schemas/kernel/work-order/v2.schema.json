{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ospec://schemas/kernel/work-order/v2",
  "title": "WorkOrderIdentityV2",
  "description": "Kernel WorkOrder Execution Identity Schema v2 enforcing kind discriminator, dependencies, ownership, and evidence.",
  "type": "object",
  "schema_version": 2,
  "required": [
    "schema_version",
    "kind",
    "work_order_id",
    "source_snapshot_id",
    "node_id",
    "role",
    "status",
    "operation",
    "objective",
    "dependencies",
    "ownership",
    "allowed_paths",
    "invariants",
    "required_evidence",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "kind": {
      "type": "string",
      "const": "work-order/v2"
    },
    "work_order_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "ownership": {
      "type": "object",
      "required": [
        "owner",
        "mode"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "exclusive",
            "shared"
          ]
        }
      },
      "additionalProperties": false
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "model_turns",
        "patches",
        "commands",
        "wall_time_minutes",
        "changed_lines"
      ],
      "properties": {
        "model_turns": {
          "type": "integer",
          "minimum": 0
        },
        "patches": {
          "type": "integer",
          "minimum": 0
        },
        "commands": {
          "type": "integer",
          "minimum": 0
        },
        "wall_time_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "changed_lines": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "clarification_context": {
      "type": "object",
      "required": [
        "event_id",
        "question_id",
        "answer"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "question_id": {
          "type": "string"
        },
        "answer": {
          "type": [
            "string",
            "object"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
