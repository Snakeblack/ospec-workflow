{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ospec://schemas/kernel/execution-graph/v1",
  "title": "ExecutionGraphV1",
  "description": "Kernel Execution Graph and Obligation Manifest Schema v1 for Repair routes.",
  "type": "object",
  "schema_version": 1,
  "required": [
    "schema_version",
    "graph_id",
    "contract_digest",
    "policy_bundle_digest",
    "policy_snapshot_id",
    "source_snapshot_id",
    "nodes",
    "obligations"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "graph_id": {
      "type": "string"
    },
    "contract_digest": {
      "type": "string"
    },
    "policy_bundle_digest": {
      "type": "string"
    },
    "policy_snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/obligation"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "node_id",
        "kind",
        "operation",
        "objective",
        "dependencies",
        "ownership",
        "allowed_paths",
        "invariants",
        "required_evidence",
        "budget_ref"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "budget_ref": {
          "type": "string",
          "minLength": 1
        },
        "clarification_context": {
          "type": "object",
          "required": [
            "event_id",
            "question_id",
            "answer"
          ],
          "properties": {
            "event_id": {
              "type": "string",
              "minLength": 1
            },
            "question_id": {
              "type": "string",
              "minLength": 1
            },
            "answer": {
              "type": [
                "string",
                "object"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "read",
              "edit",
              "test",
              "file_edit",
              "bash_run",
              "grep"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "operation": {
            "enum": []
          }
        }
      }
    },
    "ownership": {
      "type": "object",
      "required": [
        "owner",
        "mode"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "exclusive",
            "shared"
          ]
        }
      },
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "required": [
        "id",
        "criticality",
        "implemented_by",
        "required_evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "criticality": {
          "type": "string",
          "enum": [
            "must",
            "should",
            "may"
          ]
        },
        "implemented_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deferred": {
          "$ref": "#/$defs/deferred"
        }
      },
      "additionalProperties": false
    },
    "deferred": {
      "type": "object",
      "required": [
        "reason",
        "approved_by"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
